---
import { AuthCard } from "@/features/auth";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  description="Melde dich bei Elite Regewelt an, um deinen Lernfortschritt bei Vokabeln, Grammatik und Prüfungen zu speichern."
  robots="noindex, nofollow"
  title="Anmelden | Elite Regewelt"
>
  <div class="flex w-full items-center justify-center py-6 tablet:py-10">
    <AuthCard
      client:load
      defaultView="signin"
    />
  </div>
</Layout>
