---
import Layout from "@/layouts/Layout.astro";
import Card from "@/shared/ui/Card.astro";
import Hero from "@/shared/ui/Hero.astro";
import { BookOpen, CheckCircle2, Clock, GraduationCap, Trophy } from "lucide-astro";
---

<Layout
  description="Lerne Deutsch effektiv mit interaktiven Vokabeln, Grammatik-Lektionen und gezielter Prüfungsvorbereitung für das B1 & B2 Zertifikat."
  title="Deutsch Lernen | Deine Plattform für Erfolg"
>
  <div class="py-6 tablet:py-10 laptop:py-14">
    <header class="mbe-10 tablet:mbe-14 laptop:mbe-16">
      <Hero
        category="A1 - B2"
        description="Die umfassende Plattform für dein Deutsch-Training. Von den Grundlagen bis zum B1 & B2 Zertifikat – alles an einem Ort."
        stats={[
          { label: "Vokabeln", value: "3.000+", icon: BookOpen },
          { label: "Lektionen", value: "120+", icon: GraduationCap },
          { label: "Niveau", value: "B1 & B2", icon: Trophy },
        ]}
        title="Meistere die deutsche Sprache"
        variant="glass"
      />
    </header>

    <div class="grid grid-cols-1 gap-6 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
      <div data-animate="fade-up">
        <Card
          category="A1-B2"
          description="Thematisch sortierte Wortschatzlisten für Alltag und Beruf. Mit interaktiven Karten lernen."
          gradient="linear-gradient(135deg, #f1c40f 0%, #f39c12 100%)"
          href="/vokabeln"
          icon="V"
          subtitle="Wortschatz"
          title="Vokabeln"
        />
      </div>
      <div data-animate="fade-up">
        <Card
          category="B1-B2"
          description="Klar strukturierte Regeln, Tabellen und Anwendungsbeispiele für alle wichtigen Grammatikthemen."
          gradient="linear-gradient(135deg, #f8835f 0%, #e67e22 100%)"
          href="/grammatik"
          icon="G"
          subtitle="Regeln & Struktur"
          title="Grammatik"
        />
      </div>
      <div data-animate="fade-up">
        <Card
          category="B1-B2 Ready"
          description="Simulationen und Tipps für die B1 & B2 Prüfung (Goethe/ÖSD). Texte schreiben und Sprechen üben."
          gradient="linear-gradient(135deg, #2ecc71 0%, #27ae60 100%)"
          href="/pruefung"
          icon="P"
          subtitle="Modelltests"
          title="Prüfungstraining"
        />
      </div>
    </div>

    <section
      class="mbs-16 tablet:mbs-20 laptop:mbs-24"
      data-animate="fade-up"
    >
      <Hero
        description="Strukturierte Vorbereitung auf das B1 & B2 Zertifikat"
        stats={[
          { label: "B1 Dauer", value: "B1: ca. 3,5h", icon: Clock },
          { label: "B2 Dauer", value: "B2: ca. 3,0h", icon: Clock },
          { label: "Bestehen", value: "60% (Pro Modul)", icon: CheckCircle2 },
        ]}
        title="Goethe & ÖSD Zertifikate"
        variant="glass"
      />
    </section>

    <section
      class="mbs-16 pb-8 text-center tablet:mbs-20 laptop:mbs-24"
      data-animate="fade-up"
    >
      <h2 class="mbe-3 text-shadow-sm text-white tablet:mbe-4">
        Bereit für den <span class="title-gradient">nächsten Schritt</span>?
      </h2>
      <p class="mx-auto max-w-xl text-mist-500 leading-relaxed">
        Egal ob du gerade erst anfängst oder dich auf eine Prüfung vorbereitest – wir haben die
        richtigen Werkzeuge für dich.
      </p>
    </section>
  </div>
</Layout>
