---
import { getGrammarSection, GrammarSectionCards } from "@/features/grammar";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/shared/ui/PageHeader.astro";
import { BookOpen } from "lucide-astro";

const GRAMMAR_SECTION_IDS = [
  "verben",
  "nomen",
  "praepositionen",
  "satz",
  "adverbien",
  "partikeln",
] as const;

const sectionsResponses = await Promise.all(GRAMMAR_SECTION_IDS.map((id) => getGrammarSection(id)));
const sections = sectionsResponses.map((s) => s.data).filter((s) => s != null);

const pageTitle = "Deutsche Grammatik von A1 bis B2: Regeln & Tabellen | Elite Regewelt";
const pageDescription =
  "Systematische Übersicht der deutschen Grammatik: Verben, Nomen, Artikel, Präpositionen & Satzbau. Klare Regeln, Beispielsätze und Konjugationstabellen.";

const grammarSchema = {
  "@type": "CollectionPage",
  name: "Deutsche Grammatik von A1 bis B2: Regeln, Tabellen & Beispiele",
  description: pageDescription,
  about: {
    "@type": "Course",
    name: "Deutsche Grammatik (A1–B2)",
    description: "Umfassender Grammatikkurs mit Regeln, Übersichten und Konjugationstabellen.",
    provider: { "@type": "Organization", name: "Elite Regewelt" },
  },
};
---

<Layout
  description={pageDescription}
  extraSchema={grammarSchema}
  title={pageTitle}
>
  <div class="animate-fade-in py-4 mobile:py-8">
    <PageHeader
      icon={BookOpen}
      subtitle="Systematische Übersicht der deutschen Grammatikregeln von A1 bis B2 mit verständlichen Beispielen und Tabellen."
      title="Deutsche Grammatik"
    />

    <div class="space-y-12">
      {sections.map((section) => (
        <GrammarSectionCards section={section} />
      ))}
    </div>
  </div>
</Layout>
