---
import {
  getGrammarSection,
  getGrammarTopic,
  GrammarContentBlocks,
  grammarSections,
  GrammarTable,
} from "@/features/grammar";
import Layout from "@/layouts/Layout.astro";
import { getGradient } from "@/shared/lib";
import BackButton from "@/shared/ui/BackButton.astro";
import GlassCard from "@/shared/ui/GlassCard.astro";
import Hero from "@/shared/ui/Hero.astro";
import { BookOpen, Languages } from "lucide-astro";

export async function getStaticPaths() {
  const paths = [];
  for (const section of grammarSections) {
    for (const topic of section.topics) {
      paths.push({ params: { section: section.id, topicId: topic.id } });
    }
  }
  return paths;
}

const { section, topicId } = Astro.params;

if (!section || !topicId) {
  throw new Error("Fehlende Grammatik-Parameter.");
}

const [sectionResponse, topicResponse] = await Promise.all([
  getGrammarSection(section),
  getGrammarTopic(section, topicId),
]);

const currentSection = sectionResponse.data;
const currentTopic = topicResponse.data;
---

<Layout
  description={currentTopic?.description ?? "Lerne deutsche Grammatik."}
  title={currentTopic ? `${currentTopic.title} - Grammatik` : "Grammatik Thema"}
>
  {!currentTopic || !currentSection ?
    <div class="px-8 py-16 text-center text-white">
      <h1 class="mb-4 text-3xl">Thema nicht gefunden</h1>
      <p class="mb-8 text-zinc-400">Das gewünschte Grammatikthema existiert nicht.</p>
      <BackButton />
    </div>
  : <div class="relative min-h-dvh py-6 tablet:py-10">
      <main>
        <Hero
          category={currentTopic.category}
          description={currentTopic.description}
          stats={[
            { label: "Thema", value: currentTopic.number },
            { label: "Niveau", value: "B1", icon: Languages },
          ]}
          title={currentTopic.title}
        />

        {currentTopic.hasTable && currentTopic.tableData ?
          <section class="mb-12 tablet:mb-16">
            <GrammarTable
              client:load
              data={currentTopic.tableData}
            />
          </section>
        : null}

        {currentTopic.content || currentTopic.usage ?
          <section class="mb-12 tablet:mb-16">
            <GrammarContentBlocks
              blocks={currentTopic.content ?? []}
              client:load
              usage={currentTopic.usage}
            />
          </section>
        : null}

        {currentTopic.subtopics ?
          <section class="mb-12 text-white tablet:mb-16">
            <h2 class="mb-6 flex items-center gap-3 text-xl font-semibold text-text tablet:mb-8 tablet:gap-4 tablet:text-2xl">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full border-[3px] border-solid border-yellow bg-mist-900/50 text-yellow shadow-sm tablet:size-12">
                <BookOpen class="size-5 tablet:size-6" />
              </span>
              Unterthemen
            </h2>
            <div class="grid gap-8 tablet:gap-10">
              {currentTopic.subtopics.map((subtopic, index) => (
                <article>
                  <GlassCard rounded="2xl">
                    <header
                      class="flex flex-row items-center gap-4 p-4 tablet:p-5"
                      style={{ background: getGradient(index + 1, currentSection.gradients) }}
                    >
                      <span class="rounded-md bg-white/20 px-2.5 py-1 text-xs font-bold text-white">
                        {subtopic.number}
                      </span>
                      <h3 class="m-0 text-lg font-semibold text-white tablet:text-xl">
                        {subtopic.title}
                      </h3>
                    </header>
                    <div class="p-5 tablet:p-6">
                      <p class="m-0 mb-5 leading-relaxed text-zinc-400 tablet:mb-6">
                        {subtopic.description}
                      </p>
                      {subtopic.hasTable && subtopic.tableData ?
                        <div class="mb-6 tablet:mb-8">
                          <GrammarTable
                            client:load
                            data={subtopic.tableData}
                          />
                        </div>
                      : null}
                      {subtopic.content || subtopic.usage || subtopic.tips ?
                        <GrammarContentBlocks
                          blocks={subtopic.content ?? []}
                          client:load
                          tips={subtopic.tips}
                          usage={subtopic.usage}
                        />
                      : null}
                    </div>
                  </GlassCard>
                </article>
              ))}
            </div>
          </section>
        : null}

        {currentTopic.tips ?
          <section class="mb-16">
            <GrammarContentBlocks
              blocks={[]}
              client:load
              tips={currentTopic.tips}
            />
          </section>
        : null}
      </main>
    </div>
  }
</Layout>
