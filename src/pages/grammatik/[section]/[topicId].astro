---
import { Languages, Layers, TableProperties } from "lucide-astro";
import { GrammarContentBlocks, GrammarTable } from "@/features/grammar";
import { getGrammarTheme } from "@/features/grammar/lib/theme.ts";
import {
  getGrammarSection,
  getGrammarSections,
  getGrammarTopic,
} from "@/features/grammar/server.ts";
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/shared/ui/button/BackButton.astro";
import { Hero } from "@/widgets/hero";

export async function getStaticPaths() {
  const { data: grammarSections } = await getGrammarSections();
  return (grammarSections ?? []).flatMap((section) =>
    section.topics.map((topic) => ({ params: { section: section.id, topicId: topic.id } })),
  );
}

const { section, topicId } = Astro.params;

if (!(section && topicId)) {
  throw new Error("Fehlende Grammatik-Parameter.");
}

const [sectionResponse, topicResponse] = await Promise.all([
  getGrammarSection(section),
  getGrammarTopic(section, topicId),
]);

const currentSection = sectionResponse.data;
const currentTopic = topicResponse.data;

const pageTitle =
  currentTopic && currentSection
    ? `${currentTopic.title} – Deutsche Grammatik (${currentTopic.category}) | Elite Regewelt`
    : "Grammatik Thema | Elite Regewelt";

const pageDescription =
  currentTopic && currentSection
    ? `${currentTopic.description || `Lerne ${currentTopic.title} im Bereich ${currentSection.title}.`} Grammatikregeln, Beispielsätze und Übersichtstabellen.`
    : "Lerne deutsche Grammatik systematisch.";

const extraSchema =
  currentTopic && currentSection
    ? {
        "@type": "TechArticle",
        headline: `${currentTopic.title} – Deutsche Grammatik`,
        description: currentTopic.description,
        educationalLevel: "A1-B2",
        inLanguage: "de",
        articleSection: currentSection.title,
        about: { "@type": "Thing", name: currentTopic.title, description: currentTopic.category },
      }
    : undefined;

const subtopicsCount = currentTopic?.subtopics?.length ?? (currentTopic?.content ? 1 : 0);
const tablesCount =
  (currentTopic?.hasTable ? 1 : 0) +
  (currentTopic?.subtopics?.filter((s) => s.hasTable).length ?? 0);
const rulesCount =
  (currentTopic?.content?.length ?? 0) +
  (currentTopic?.subtopics?.reduce((accumulator, s) => accumulator + (s.content?.length ?? 0), 0) ??
    0);

const heroStats = [
  {
    label: "Schwerpunkte",
    value: `${subtopicsCount} ${subtopicsCount === 1 ? "Schwerpunkt" : "Schwerpunkte"}`,
    icon: Layers,
  },
  {
    label: "Struktur",
    value: `${tablesCount} ${tablesCount === 1 ? "Tabelle" : "Tabellen"} · ${rulesCount} Regeln`,
    icon: TableProperties,
  },
  { label: "Niveau", value: "A1 · A2 · B1 · B2", icon: Languages },
];

const heroExample =
  currentTopic?.example ??
  (currentTopic?.subtopics && currentTopic.subtopics.length > 0
    ? currentTopic.subtopics.map((s) => s.title).join(" · ")
    : "Regeln, Tabellen & Beispielsätze (A1–B2)");
---

<Layout
  description={pageDescription}
  extraSchema={extraSchema}
  title={pageTitle}
>
  {!currentTopic || !currentSection ?
    <div class="px-8 py-16 text-center text-white">
      <h1 class="mb-4 text-3xl">Thema nicht gefunden</h1>
      <p class="mb-8 text-zinc-400">Das gewünschte Grammatikthema existiert nicht.</p>
      <BackButton />
    </div>
  : <div class="relative min-h-dvh py-8">
      <div class="animate-fade-in space-y-8">
        <!-- Compact Hero Header -->
        <Hero
          category={currentSection.title}
          description={currentTopic.description}
          example={heroExample}
          stats={heroStats}
          title={currentTopic.title}
          variant="compact"
        />

        <!-- Overview Navigation Bar -->
        {currentTopic.subtopics && currentTopic.subtopics.length > 0 && (
          <div
            class="rounded-2xl border-2 border-white/10 bg-card/60 p-5 shadow-lg backdrop-blur-(--glass-blur) tablet:p-6"
            data-animate="fade-up"
          >
            <div class="flex flex-col items-center gap-4 text-center">
              <div class="space-y-1.5">
                <div class="flex items-center justify-center gap-2">
                  <span
                    class="inline-flex size-2 rounded-full bg-yellow"
                    data-gsap-pulse
                  ></span>
                  <h2 class="text-sm font-bold tracking-tight text-white tablet:text-base">
                    Themenübersicht & Schnellnavigation
                  </h2>
                </div>
                <p class="mx-auto max-w-xl text-xs text-mist-400">
                  Wähle ein Unterthema, um direkt zur Erklärung, Konjugation und den Beispielen zu
                  springen
                </p>
              </div>

              <nav
                aria-label="Unterthemen Navigation"
                class="flex flex-wrap items-center justify-center gap-2.5"
              >
                {currentTopic.subtopics.map((subtopic, index) => {
                  const theme = getGrammarTheme(index);
                  return (
                    <a
                      class:list={[
                        "inline-flex items-center gap-1.5 rounded-full border-[1.5px] px-3 py-1 text-xs font-semibold tracking-wide transition-all duration-150 hover:brightness-125 hover:shadow-sm active:scale-95",
                        theme.badgeClass,
                      ]}
                      href={`#subtopic-${subtopic.id}`}
                    >
                      <span class="font-bold opacity-80">{subtopic.number}</span>
                      <span>{subtopic.title}</span>
                    </a>
                  );
                })}
              </nav>
            </div>
          </div>
        )}

        <!-- Root Topic Tables & Content (if present at top level) -->
        {currentTopic.hasTable && currentTopic.tableData && (
          <section class="space-y-4">
            <GrammarTable
              data={currentTopic.tableData}
              theme={getGrammarTheme(0)}
            />
          </section>
        )}

        {(currentTopic.content || currentTopic.usage) && (
          <section class="space-y-4">
            <GrammarContentBlocks
              blocks={currentTopic.content ?? []}
              theme={getGrammarTheme(0)}
              usage={currentTopic.usage}
            />
          </section>
        )}

        <!-- Subtopics Sections -->
        {currentTopic.subtopics && currentTopic.subtopics.length > 0 && (
          <section class="space-y-8">
            <div class="space-y-8">
              {currentTopic.subtopics.map((subtopic, index) => {
                const theme = getGrammarTheme(index);
                return (
                  <article
                    class:list={[
                      "scroll-mt-24 overflow-hidden rounded-3xl border-2 bg-card/60 shadow-xl backdrop-blur-(--glass-blur) transition-all duration-300 hover:border-white/15",
                      theme.cardBorderClass,
                    ]}
                    id={`subtopic-${subtopic.id}`}
                  >
                    <!-- Subtopic Header Banner -->
                    <header
                      class:list={[
                        "flex flex-wrap items-center justify-between gap-3 border-b px-5 py-4 tablet:px-7",
                        theme.headerBorderClass,
                        theme.headerBgClass,
                      ]}
                    >
                      <div class="flex items-center gap-3">
                        <span
                          class:list={[
                            "inline-flex items-center rounded-lg border-[1.5px] px-2.5 py-1 text-xs font-bold tracking-wide uppercase",
                            theme.badgeClass,
                          ]}
                        >
                          {subtopic.number}
                        </span>
                        <h3 class="m-0 text-lg font-bold text-white tablet:text-xl">
                          {subtopic.title}
                        </h3>
                      </div>

                      <div class="flex items-center gap-2">
                        {subtopic.hasTable && (
                          <span class="rounded-full border-[1.5px] border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-medium text-mist-300">
                            Tabelle
                          </span>
                        )}
                        {subtopic.content && subtopic.content.length > 0 && (
                          <span class="rounded-full border-[1.5px] border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-medium text-mist-300">
                            {subtopic.content.length}{" "}
                            {subtopic.content.length === 1 ? "Regel" : "Regeln"}
                          </span>
                        )}
                      </div>
                    </header>

                    <!-- Subtopic Content Body -->
                    <div class="space-y-6 p-5 tablet:p-7">
                      <p class="text-sm leading-relaxed text-mist-300 tablet:text-base">
                        {subtopic.description}
                      </p>

                      {subtopic.hasTable && subtopic.tableData && (
                        <div class="space-y-3">
                          <GrammarTable
                            data={subtopic.tableData}
                            theme={theme}
                          />
                        </div>
                      )}

                      {(subtopic.content || subtopic.usage || subtopic.tips) && (
                        <div class="space-y-4">
                          <GrammarContentBlocks
                            blocks={subtopic.content ?? []}
                            theme={theme}
                            tips={subtopic.tips}
                            usage={subtopic.usage}
                          />
                        </div>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        )}

        <!-- Root Topic Tips (if any) -->
        {currentTopic.tips && currentTopic.tips.length > 0 && (
          <section class="mt-8">
            <GrammarContentBlocks
              blocks={[]}
              theme={getGrammarTheme(2)}
              tips={currentTopic.tips}
            />
          </section>
        )}
      </div>
    </div>
  }
</Layout>
