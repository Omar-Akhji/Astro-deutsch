---
import { getVocabList, VocabularySection } from "@/features/vocabulary";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/shared/ui/PageHeader.astro";
import { Languages } from "lucide-astro";

const { data: vocabList } = await getVocabList();
---

<Layout
  description="Deutsche Vokabeln lernen - Familie, Zahlen, Farben, Tiere und mehr. Interaktive Wortschatzübungen für Anfänger."
  title="Vokabeln | Deutsch Lernen"
>
  <main class="animate-fade-in">
    <PageHeader
      icon={Languages}
      subtitle="Thematisch sortierte Vokabellisten für dein A1/B1 Training"
      title="Deutscher Wortschatz"
    />
    <VocabularySection
      client:load
      vocabList={vocabList ?? []}
    />
  </main>
</Layout>
