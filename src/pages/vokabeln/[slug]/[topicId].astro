---
import { BookOpen, Headphones, Users } from "lucide-astro";
import { TopicStory, VocabularyTable } from "@/features/vocabulary";
import { getVocabularyById, getVocabularyList } from "@/features/vocabulary/server.ts";
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/shared/ui/BackButton.astro";
import GlassCard from "@/shared/ui/GlassCard.astro";
import { Hero } from "@/widgets/hero";

export async function getStaticPaths() {
  const { data: vocabularyList } = await getVocabularyList();
  const paths = [];
  const items = vocabularyList ?? [];
  for (const item of items) {
    if (item.sections) {
      for (const section of item.sections) {
        for (const topic of section.topics) {
          paths.push({ params: { id: item.id.toString(), topicId: topic.id } });
        }
      }
    }
  }
  return paths;
}

const { id, topicId } = Astro.params;

if (!id || !topicId) {
  throw new Error("Fehlende Vokabel-Parameter.");
}

const { data: item } = await getVocabularyById(Number(id));

const topicMap = new Map(
  item?.sections?.flatMap((s) => s.topics.map((t) => [t.id, { topic: t, section: s }] as const)),
);

const result = topicMap.get(topicId);
const topic = result?.topic;
const section = result?.section;

const pageTitle =
  topic && item ?
    `${topic.title} – Wortschatz ${item.german} (${item.category}) | Elite Regewelt`
  : "Vokabel Thema | Elite Regewelt";

const pageDescription =
  topic && item ?
    `Lerne deutsche Vokabeln & Ausdrücke zu ${topic.title} im Bereich ${item.german}. Inklusive arabischer Übersetzung, Beispielsätzen und praktischen Übungen.`
  : "Lerne deutsche Vokabeln systematisch.";

const extraSchema =
  topic && item ?
    {
      "@type": "LearningResource",
      name: `${topic.title} – Wortschatz ${item.german}`,
      description: `Deutsche Vokabeln und Ausdrücke für ${topic.title} (${item.german}) mit arabischer Bedeutung und Beispielsätzen.`,
      educationalLevel: item.category || "A1-B2",
      inLanguage: ["de", "ar"],
      learningResourceType: "Vocabulary List",
      hasPart: topic.words
        ?.slice(0, 30)
        .map((w) => ({
          "@type": "DefinedTerm",
          name: w.german,
          description: w.arabic,
          ...(w.example && { disambiguatingDescription: w.example }),
        })),
    }
  : undefined;
const heroDescription =
  topic?.description ??
  (topic?.id === "stammbaum" ?
    "Familienmitglieder, Verwandtschaftsverhältnisse und Beziehungsstatus im Überblick."
  : `Wichtige Wörter, Redewendungen und Sprachübungen zum Thema ${topic?.title ?? ""} im Bereich ${section?.title ?? item?.german ?? ""}.`);

const heroStats = [
  ...(topic?.familyTree && topic.familyTree.length > 0 ?
    [
      {
        label: "Familienmitglieder",
        value: `${topic.familyTree.length} Personen im Stammbaum`,
        icon: Users,
      },
    ]
  : []),
  ...(topic?.words && topic.words.length > 0 ?
    [
      {
        label: "Wortschatz",
        value: `${topic.words.length} Vokabeln (Nomen · Verben · Adj.)`,
        icon: BookOpen,
      },
    ]
  : []),
  {
    label: "Niveaustufen",
    value: "4 Niveaus (A1 · A2 · B1 · B2)",
    icon: Headphones,
  },
];
---

<Layout
  description={pageDescription}
  extraSchema={extraSchema}
  title={pageTitle}
>
  {!item || !topic ?
    <div class="px-8 py-16 text-center text-white">
      <h1 class="mb-4 text-3xl">Thema nicht gefunden</h1>
      <BackButton />
    </div>
  : <div class="relative min-h-dvh py-8">
      <div class="animate-fade-in">
        <Hero
          category={item.category}
          description={heroDescription}
          example={topic.details ?? (topic.id === "stammbaum" ? "Stammbaum, Verwandtschaft und Beziehungsstatus (A1–B2)" : undefined)}
          stats={heroStats}
          title={topic.title}
          variant="compact"
        />

        <section class="mt-8">
          <TopicStory
            categoryTitle={item.german}
            familyTree={topic.familyTree}
            topic={topic}
            words={topic.words ?? []}
          />
        </section>

        {topic.words && topic.words.length > 0 ?
          <section class="mt-8">
            <VocabularyTable words={topic.words} />
          </section>
        : <section class="mt-8">
            <GlassCard className="p-8">
              <div class="text-center text-zinc-400">
                <p>Noch keine Vokabeln für {topic.title} eingetragen.</p>
              </div>
            </GlassCard>
          </section>
        }
      </div>
    </div>
  }
</Layout>
