---
import { getVocabById, vocabList } from "@/features/vocabulary";
import Layout from "@/layouts/Layout.astro";
import { getGradient, VOCAB_GRADIENTS } from "@/shared/lib";
import BackButton from "@/shared/ui/BackButton.astro";
import GlassCard from "@/shared/ui/GlassCard.astro";
import Hero from "@/shared/ui/Hero.astro";
import { ArrowRight, BookOpen, Languages } from "lucide-astro";

export async function getStaticPaths() {
  return vocabList.map((item) => ({ params: { id: item.id.toString() } }));
}

const { id } = Astro.params;
if (!id) {
  throw new Error("Fehlende Vokabel-ID.");
}
const { data: item } = await getVocabById(Number(id));

const totalTopics =
  item?.sections?.reduce((accumulator, sec) => accumulator + sec.topics.length, 0)
  ?? item?.words?.length
  ?? 0;
---

<Layout
  description={item?.description ?? "Lerne wichtige deutsche Vokabeln."}
  title={item ? `${item.german} - Vokabeln` : "Vokabel Lektion"}
>
  {item ?
    <div class="relative min-h-dvh py-6 tablet:py-10">
      <main>
        <Hero
          category={item.category}
          description={item.description ?? "Vokabeln und Ausdrücke"}
          stats={[
            { label: "Themen", value: `${totalTopics} Themen` },
            { label: "Niveau", value: "A1", icon: Languages },
          ]}
          title={item.german}
          variant="compact"
        />

        {item.sections && item.sections.length > 0 ?
          <div class="grid gap-10 tablet:gap-12">
            {item.sections.map((section, index) => (
              <section
                aria-labelledby={`section-${section.id}`}
                data-animate="fade-up"
              >
                <div
                  class="mb-6 flex flex-col items-start gap-4 rounded-2xl p-5 md:flex-row md:items-center md:justify-between tablet:mb-7 tablet:p-6"
                  style={{ background: getGradient(index, VOCAB_GRADIENTS) }}
                >
                  <h2
                    class="m-0 text-xl font-semibold tracking-wide text-white uppercase tablet:text-2xl"
                    id={`section-${section.id}`}
                  >
                    {section.title}
                  </h2>
                  <div class="rounded-full bg-white/20 px-4 py-1 text-sm font-medium text-white backdrop-blur-sm">
                    {section.topics.length} Themen
                  </div>
                </div>

                {section.topics.length > 0 ?
                  <div class="grid gap-4 sm:grid-cols-2 tablet:gap-5 lg:grid-cols-3">
                    {section.topics.map((topic) => (
                      <a
                        class="group block no-underline"
                        href={`/vokabeln/${item.id}/${topic.id}`}
                      >
                        <GlassCard
                          className="p-5 transition-[transform,border-color,box-shadow] duration-300 group-hover:-translate-y-1 group-hover:border-(--color-primary) group-hover:shadow-lg"
                          rounded="2xl"
                        >
                          <h3 class="mb-2 text-lg font-semibold text-white group-hover:text-yellow">
                            {topic.title}
                          </h3>
                          <div class="flex items-center gap-2 text-sm text-zinc-400">
                            <ArrowRight
                              class="text-secondary"
                              size={14}
                            />
                            <span>Details ansehen</span>
                          </div>
                        </GlassCard>
                      </a>
                    ))}
                  </div>
                : <div class="text-zinc-450 rounded-xl border border-dashed border-white/10 p-6 text-center">
                    Noch keine Themen in diesem Bereich.
                  </div>
                }
              </section>
            ))}
          </div>
        : <section
            class="mb-12 text-white"
            data-animate="fade-up"
          >
            <h2 class="mb-8 flex items-center gap-4 text-[1.75rem] font-semibold text-white">
              <span class="flex size-12 items-center justify-center rounded-full border-[3px] border-solid border-yellow bg-mist-900/50 text-yellow shadow-sm">
                <BookOpen size={24} />
              </span>
              Wortliste
            </h2>

            {item.words && item.words.length > 0 ?
              <div class="grid gap-4 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
                {item.words.map((word) => (
                  <article class="group">
                    <GlassCard
                      className="p-5 transition-[transform,border-color,box-shadow] duration-300 group-hover:-translate-y-1 group-hover:border-(--color-primary) group-hover:shadow-lg"
                      rounded="2xl"
                    >
                      <div class="mb-2 flex items-baseline justify-between">
                        <h3 class="text-lg font-semibold text-white group-hover:text-yellow">
                          {word.german}
                        </h3>
                      </div>
                      <p
                        class="font-arabic mb-3 text-xl font-medium text-white"
                        dir="rtl"
                      >
                        {word.arabic}
                      </p>
                      {word.example && <p class="text-sm text-zinc-400 italic">"{word.example}"</p>}
                    </GlassCard>
                  </article>
                ))}
              </div>
            : <div class="text-zinc-450 rounded-xl border border-dashed border-white/10 p-6 text-center">
                Keine Wörter für dieses Thema verfügbar.
              </div>
            }
          </section>
        }
      </main>
    </div>
  : <div class="px-8 py-16 text-center text-white">
      <h1 class="mb-4 text-3xl">Lektion nicht gefunden</h1>
      <p class="mb-8 text-zinc-400">Die gewünschte Vokabellektion existiert nicht.</p>
      <BackButton />
    </div>
  }
</Layout>
