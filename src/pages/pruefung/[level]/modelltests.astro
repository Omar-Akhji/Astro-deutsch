---
import { getModelTests, ModelTestsView } from "@/features/pruefung";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  return [{ params: { level: "b1" } }, { params: { level: "b2" } }];
}

const { level } = Astro.params;

if (!level) {
  throw new Error("Fehlender Prüfungs-Level-Parameter.");
}

const { data: modelTests } = await getModelTests(level);
---

<Layout
  description="Übe mit offiziellen Modelltests für deine Deutschprüfung."
  title="Modelltests | Deutsch Lernen"
>
  <ModelTestsView
    client:load
    initialModelTests={modelTests ?? []}
    level={level}
  />
</Layout>
