---
import { ModelTestsView } from "@/features/pruefung";
import { getModelTests } from "@/features/pruefung/server.ts";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  return [{ params: { level: "b1" } }, { params: { level: "b2" } }];
}

const { level } = Astro.params;

if (!level) {
  throw new Error("Fehlender Prüfungs-Level-Parameter.");
}

const { data: modelTests } = getModelTests(level);

const pageTitle = `Modelltests ${level.toUpperCase()}: Goethe & ÖSD Prüfungssimulation | Elite Regewelt`;
const pageDescription = `Offizielle Modelltests und Übungssätze für das Niveau ${level.toUpperCase()}. Trainiere Lesen, Hören, Schreiben und Sprechen unter realistischen Prüfungsbedingungen.`;

const modelltestsSchema = {
  "@type": "CollectionPage",
  name: `Modelltests ${level.toUpperCase()} (Goethe & ÖSD)`,
  description: pageDescription,
  about: {
    "@type": "Course",
    name: `Prüfungssimulation ${level.toUpperCase()}`,
    educationalLevel: level.toUpperCase(),
    inLanguage: "de",
    provider: { "@type": "Organization", name: "Elite Regewelt" },
  },
};
---

<Layout
  description={pageDescription}
  extraSchema={modelltestsSchema}
  title={pageTitle}
>
  <ModelTestsView
    initialModelTests={modelTests ?? []}
    level={level}
  />
</Layout>
