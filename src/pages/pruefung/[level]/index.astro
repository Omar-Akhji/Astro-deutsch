---
import { getExamLevel } from "@/features/pruefung";
import Layout from "@/layouts/Layout.astro";
import { getGradient, PRUEFUNG_GRADIENTS } from "@/shared/lib";
import BackButton from "@/shared/ui/BackButton.astro";
import { Hero } from "@/widgets/hero";
import {
  CheckCircle2,
  ClipboardList,
  Clock,
  FileEdit,
  Lightbulb,
  MessageCircle,
} from "lucide-astro";

export async function getStaticPaths() {
  return [{ params: { level: "b1" } }, { params: { level: "b2" } }];
}

const { level } = Astro.params;

if (!level) {
  throw new Error("Fehlender Prüfungs-Level-Parameter.");
}

const { data: currentExam } = await getExamLevel(level);

const pageTitle =
  currentExam ?
    `${currentExam.title} Vorbereitung: Struktur, Zeiten & Modelltests | Elite Regewelt`
  : "Prüfungsvorbereitung | Elite Regewelt";

const pageDescription =
  currentExam ?
    `Vollständige Vorbereitung auf ${currentExam.title} (Goethe & ÖSD). Prüfungsstruktur, Zeitvorgaben, Bestehensgrenze (${currentExam.passingScore}) und Modelltests.`
  : "Bereite dich auf deine Deutschprüfung vor.";

const examSchema =
  currentExam ?
    {
      "@type": "Course",
      name: `${currentExam.title} Vorbereitung`,
      description: currentExam.description,
      educationalLevel: currentExam.level,
      inLanguage: "de",
      timeRequired: currentExam.totalDuration,
      provider: { "@type": "Organization", name: "Elite Regewelt" },
      hasCourseInstance: currentExam.sections.map((sec) => ({
        "@type": "CourseInstance",
        name: sec.title,
        description: sec.description,
      })),
    }
  : undefined;
---

<Layout
  description={pageDescription}
  extraSchema={examSchema}
  title={pageTitle}
>
  {currentExam ?
    <div class="relative min-h-dvh py-6 tablet:py-10">
      <div class="animate-fade-in">
        <Hero
          category={currentExam.level}
          description={currentExam.description}
          stats={[
            { label: "Dauer", value: currentExam.totalDuration, icon: Clock },
            { label: "Bestehen", value: currentExam.passingScore, icon: CheckCircle2 },
          ]}
          title={currentExam.title}
          variant="glass"
        />

        <div class="mb-10 flex justify-center tablet:mb-12">
          <div data-animate="fade-up">
            <a
              class="group flex items-center justify-center gap-3 rounded-full border border-white/10 bg-white/5 px-8 py-4 text-xl font-bold text-white no-underline backdrop-blur-md hover:bg-white/10 hover:text-white"
              href={`/pruefung/${currentExam.id}/modelltests/`}
            >
              <FileEdit
                class="text-yellow"
                size={24}
              />
              Modelltests Starten
            </a>
          </div>
        </div>

        <section class="mb-12 text-white tablet:mb-16">
          <div data-animate="fade-right">
            <h2 class="mb-6 flex items-center gap-3 text-xl font-semibold text-text tablet:mb-8 tablet:gap-4 tablet:text-[1.75rem]">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full border-[3px] border-solid border-yellow bg-mist-900/50 text-yellow shadow-sm tablet:size-12">
                <ClipboardList
                  class="size-5 tablet:size-6"
                  strokeWidth={2}
                />
              </span>
              Prüfungsstruktur
            </h2>
          </div>
          <div class="grid gap-6">
            {currentExam.sections.map((section, index) => (
              <div data-animate="fade-up">
                <article class="overflow-hidden rounded-2xl border border-white/5 bg-card">
                  <div
                    class="flex flex-col items-start gap-4 p-4.5 tablet:p-5 md:flex-row md:items-center md:justify-between"
                    style={{ background: getGradient(index, PRUEFUNG_GRADIENTS) }}
                  >
                    <h3 class="m-0 text-xl font-semibold text-white">{section.title}</h3>
                    <div class="flex gap-4 text-sm text-white/90">
                      <span>{section.duration}</span>
                      <span>{section.points} Punkte</span>
                    </div>
                  </div>
                  <div class="p-5 tablet:p-6">
                    <p class="mb-4 text-zinc-400 leading-relaxed">{section.description}</p>
                    <table class="mb-5 w-full border-collapse text-left text-sm">
                      <caption class="sr-only">Prüfungsstruktur Übersicht</caption>
                      <thead>
                        <tr>
                          <th
                            class="border-b border-white/10 p-2 text-xs font-semibold tracking-wide text-zinc-400 uppercase md:p-3"
                            scope="col"
                          >
                            Teil
                          </th>
                          <th
                            class="border-b border-white/10 p-2 text-xs font-semibold tracking-wide text-zinc-400 uppercase md:p-3"
                            scope="col"
                          >
                            Aufgabentyp
                          </th>
                          <th
                            class="border-b border-white/10 p-2 text-xs font-semibold tracking-wide text-zinc-400 uppercase md:p-3"
                            scope="col"
                          >
                            Items
                          </th>
                          <th
                            class="border-b border-white/10 p-2 text-xs font-semibold tracking-wide text-zinc-400 uppercase md:p-3"
                            scope="col"
                          >
                            Punkte
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {section.parts.map((part) => (
                          <tr>
                            <td class="border-b border-white/5 p-2 text-white md:p-3">
                              {part.name}
                            </td>
                            <td class="border-b border-white/5 p-2 text-white md:p-3">
                              {part.taskType}
                            </td>
                            <td class="border-b border-white/5 p-2 text-white md:p-3">
                              {part.items}
                            </td>
                            <td class="border-b border-white/5 p-2 text-white md:p-3">
                              {part.points}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    <div class="mt-5 flex flex-col gap-5 tablet:gap-6">
                      <div class="rounded-xl border border-white/10 bg-white/5 p-4 tablet:p-5">
                        <h4 class="m-0 mb-2.5 flex items-center gap-2 text-sm font-semibold text-white">
                          <Lightbulb
                            class="text-yellow"
                            size={16}
                          />
                          Tipps
                        </h4>
                        <ul class="m-0 list-disc space-y-1.5 pl-5 text-zinc-400">
                          {section.tips.map((tip) => (
                            <li class="text-sm leading-relaxed">{tip}</li>
                          ))}
                        </ul>
                      </div>

                      {(section.id.includes("sprechen") || section.id.includes("schreiben")) && (
                        <a
                          class="group md:is-auto flex items-center justify-center gap-2 rounded-full bg-linear-to-r from-amber-400 to-orange-500 px-8 py-3.5 font-bold text-zinc-950 no-underline shadow-lg shadow-amber-500/20 transition-[transform,filter] inline-full hover:scale-[1.02] hover:brightness-110 active:scale-95 md:self-start"
                          href={`/pruefung/${currentExam.id}/${section.id.split("-", 2)[1]}/`}
                        >
                          <MessageCircle
                            class="transition-transform group-hover:rotate-12"
                            size={20}
                          />
                          Lernmodus öffnen
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  : <div class="px-4 py-12 text-center text-white tablet:py-16">
      <h1 class="mb-3 text-2xl font-bold tablet:text-3xl">Prüfung nicht gefunden</h1>
      <p class="mx-auto mb-6 max-w-md text-zinc-400 leading-relaxed">
        Die gewünschte Prüfungsstufe existiert nicht.
      </p>
      <BackButton />
    </div>
  }
</Layout>
