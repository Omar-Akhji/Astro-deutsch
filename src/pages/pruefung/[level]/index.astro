---
import { getExamLevel } from "@/features/pruefung/server.ts";
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/shared/ui/BackButton.astro";
import { Hero } from "@/widgets/hero";
import {
  Award,
  Check,
  Clock,
  FileEdit,
  Layers,
  Lightbulb,
  MessageSquare,
} from "lucide-astro";

export async function getStaticPaths() {
  return [{ params: { level: "b1" } }, { params: { level: "b2" } }];
}

const { level } = Astro.params;

if (!level) {
  throw new Error("Fehlender Prüfungs-Level-Parameter.");
}

const { data: currentExam } = await getExamLevel(level);

const pageTitle =
  currentExam ?
    `${currentExam.title} Vorbereitung: Struktur, Zeiten & Modelltests | Elite Regewelt`
  : "Prüfungsvorbereitung | Elite Regewelt";

const pageDescription =
  currentExam ?
    `Vollständige Vorbereitung auf ${currentExam.title} (Goethe & ÖSD). Prüfungsstruktur, Zeitvorgaben, Bestehensgrenze (${currentExam.passingScore}) und Modelltests.`
  : "Bereite dich auf deine Deutschprüfung vor.";

const examSchema =
  currentExam ?
    {
      "@type": "Course",
      name: `${currentExam.title} Vorbereitung`,
      description: currentExam.description,
      educationalLevel: currentExam.level,
      inLanguage: "de",
      timeRequired: currentExam.totalDuration,
      provider: { "@type": "Organization", name: "Elite Regewelt" },
      hasCourseInstance: currentExam.sections.map((sec) => ({
        "@type": "CourseInstance",
        name: sec.title,
        description: sec.description,
      })),
    }
  : undefined;

interface ExamModuleTheme {
  badgeClass: string;
  cardBorderClass: string;
  headerBorderClass: string;
  headerBgClass: string;
  buttonClass: string;
  dotColor: string;
}

function getExamModuleTheme(moduleId: string): ExamModuleTheme {
  if (moduleId.includes("lesen")) {
    return {
      badgeClass: "border-sky-500/30 bg-sky-500/10 text-sky-400",
      cardBorderClass: "border-sky-500/20 hover:border-sky-500/35 shadow-sky-500/5",
      headerBorderClass: "border-sky-500/20",
      headerBgClass: "bg-sky-500/5",
      buttonClass: "border-sky-500/30 bg-sky-500/15 text-sky-300 hover:bg-sky-500/25",
      dotColor: "bg-sky-400",
    };
  }
  if (moduleId.includes("hoeren")) {
    return {
      badgeClass: "border-indigo-500/30 bg-indigo-500/10 text-indigo-400",
      cardBorderClass: "border-indigo-500/20 hover:border-indigo-500/35 shadow-indigo-500/5",
      headerBorderClass: "border-indigo-500/20",
      headerBgClass: "bg-indigo-500/5",
      buttonClass: "border-indigo-500/30 bg-indigo-500/15 text-indigo-300 hover:bg-indigo-500/25",
      dotColor: "bg-indigo-400",
    };
  }
  if (moduleId.includes("schreiben")) {
    return {
      badgeClass: "border-amber-500/30 bg-amber-500/10 text-amber-400",
      cardBorderClass: "border-amber-500/20 hover:border-amber-500/35 shadow-amber-500/5",
      headerBorderClass: "border-amber-500/20",
      headerBgClass: "bg-amber-500/5",
      buttonClass: "border-amber-500/30 bg-amber-500/15 text-amber-300 hover:bg-amber-500/25",
      dotColor: "bg-amber-400",
    };
  }
  return {
    badgeClass: "border-emerald-500/30 bg-emerald-500/10 text-emerald-400",
    cardBorderClass: "border-emerald-500/20 hover:border-emerald-500/35 shadow-emerald-500/5",
    headerBorderClass: "border-emerald-500/20",
    headerBgClass: "bg-emerald-500/5",
    buttonClass: "border-emerald-500/30 bg-emerald-500/15 text-emerald-300 hover:bg-emerald-500/25",
    dotColor: "bg-emerald-400",
  };
}

const heroStats =
  currentExam ?
    [
      { label: "Module", value: "4 Module (Lesen · Hören · Schreiben · Sprechen)", icon: Layers },
      { label: "Gesamtdauer", value: currentExam.totalDuration, icon: Clock },
      {
        label: "Bestehensgrenze",
        value: currentExam.passingScore.replace(" pro Modul", ""),
        icon: Award,
      },
      { label: "Simulation", value: "Modelltests verfügbar", icon: FileEdit },
    ]
  : [];

const heroExample =
  currentExam ?
    `Offizielle Prüfungsstruktur für ${currentExam.title}: Zeitlimits, Bewertungskriterien und Strategien`
  : undefined;
---

<Layout
  description={pageDescription}
  extraSchema={examSchema}
  title={pageTitle}
>
  {currentExam ?
    <div class="relative min-h-dvh py-6 tablet:py-10">
      <div class="animate-fade-in space-y-8 tablet:space-y-10">
        <!-- Hero Header -->
        <Hero
          category={currentExam.level}
          description={currentExam.description}
          example={heroExample}
          stats={heroStats}
          title={currentExam.title}
          variant="compact"
        />

        <!-- Quick Navigation & Simulation CTA -->
        <nav
          aria-label="Prüfungsmodule Schnellübersicht"
          class="rounded-2xl border-2 border-white/10 bg-card/60 p-5 shadow-lg backdrop-blur-(--glass-blur) tablet:p-6"
          data-animate="fade-up"
        >
          <div class="flex flex-col items-center gap-4 text-center">
            <div class="space-y-1.5">
              <div class="flex items-center justify-center gap-2">
                <span class="inline-flex size-2 rounded-full bg-yellow" data-gsap-pulse></span>
                <h2 class="text-sm font-bold tracking-tight text-white tablet:text-base">
                  Prüfungsmodule Schnellübersicht
                </h2>
              </div>
              <p class="mx-auto max-w-xl text-xs text-mist-400">
                Wähle ein Modul, um direkt zu Aufgabenformaten, Zeitlimits, Punkten und Strategien
                zu springen
              </p>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-2.5">
              {currentExam.sections.map((section, index) => {
                const theme = getExamModuleTheme(section.id);
                return (
                  <a
                    class="group inline-flex items-center gap-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-mist-200 no-underline transition-all hover:border-white/25 hover:bg-white/10 hover:text-white"
                    href={`#section-${section.id}`}
                  >
                    <span class:list={["size-2 rounded-full", theme.dotColor]}></span>
                    <span>
                      {index + 1}. {section.title}
                    </span>
                    <span class="text-mist-400">({section.duration})</span>
                  </a>
                );
              })}

              <a
                class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-amber-500/40 bg-amber-500/15 px-3.5 py-1.5 text-xs font-bold text-amber-300 no-underline shadow-sm shadow-amber-500/10 transition-all hover:border-amber-400 hover:bg-amber-500/25 hover:text-amber-200"
                href={`/pruefung/${currentExam.id}/modelltests/`}
              >
                <FileEdit class="size-3.5" />
                <span>Modelltests</span>
              </a>
            </div>
          </div>
        </nav>

        <!-- 4 Exam Module Sections (Single Frame per Module) -->
        <section aria-labelledby="exam-modules-heading" class="space-y-8 tablet:space-y-10">
          <h2 id="exam-modules-heading" class="sr-only">Prüfungsmodule Details</h2>
          {currentExam.sections.map((section) => {
            const theme = getExamModuleTheme(section.id);
            const isSpeakingOrWriting =
              section.id.includes("sprechen") || section.id.includes("schreiben");
            const moduleSlug = section.id.split("-", 2)[1] ?? section.id;

            return (
              <article
                aria-labelledby={`module-heading-${section.id}`}
                class:list={[
                  "overflow-hidden rounded-2xl border-2 bg-card/60 shadow-lg backdrop-blur-(--glass-blur) transition-all duration-200 scroll-mt-24",
                  theme.cardBorderClass,
                ]}
                data-animate="fade-up"
                id={`section-${section.id}`}
              >
                <!-- Module Header Bar -->
                <div
                  class:list={[
                    "flex flex-wrap items-center justify-between gap-4 border-b px-5 py-4 tablet:px-6 tablet:py-5",
                    theme.headerBorderClass,
                    theme.headerBgClass,
                  ]}
                >
                  <div class="flex flex-wrap items-center gap-3">
                    <h3
                      id={`module-heading-${section.id}`}
                      class:list={[
                        "inline-flex items-center rounded-lg border-[1.5px] px-2.5 py-1 text-xs font-bold tracking-wide uppercase",
                        theme.badgeClass,
                      ]}
                    >
                      Modul {section.title}
                    </h3>
                    <span class="text-xs font-medium text-mist-300 tablet:text-sm">
                      {section.description}
                    </span>
                  </div>

                  <div class="flex flex-wrap items-center gap-2.5">
                    <span class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-mist-300">
                      <Clock class="size-3.5 text-mist-400" />
                      <span>{section.duration}</span>
                    </span>
                    <span class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-amber-300">
                      <Award class="size-3.5 text-amber-400" />
                      <span>{section.points} Punkte</span>
                    </span>
                  </div>
                </div>

                <!-- Module Structure Table -->
                <div class="has-scrollbar overflow-x-auto">
                  <table class="w-full border-collapse text-left text-sm tablet:text-base">
                    <caption class="sr-only">Übersicht Modul {section.title}</caption>
                    <thead class="border-b border-white/10 bg-white/4 text-[11px] font-bold uppercase tracking-wider text-mist-300 tablet:text-xs">
                      <tr>
                        <th
                          class="px-4 py-3.5 tablet:px-6 tablet:py-4"
                          scope="col"
                        >
                          Teil
                        </th>
                        <th
                          class="px-4 py-3.5 tablet:px-6 tablet:py-4"
                          scope="col"
                        >
                          Aufgabentyp & Struktur
                        </th>
                        <th
                          class="px-4 py-3.5 text-center tablet:px-6 tablet:py-4"
                          scope="col"
                        >
                          Aufgaben
                        </th>
                        <th
                          class="px-4 py-3.5 text-right tablet:px-6 tablet:py-4"
                          scope="col"
                        >
                          Punkte
                        </th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                      {section.parts.map((part) => (
                        <tr class="group/row transition-colors hover:bg-white/4">
                          <!-- Part Name -->
                          <th scope="row" class="px-4 py-4 text-left align-top tablet:px-6">
                            <span class="inline-flex items-center rounded-lg border-[1.5px] border-white/15 bg-white/5 px-2.5 py-1 text-xs font-bold text-amber-300 whitespace-nowrap">
                              {part.name}
                            </span>
                          </th>

                          <!-- Task Type & Details -->
                          <td class="px-4 py-4 align-top tablet:px-6">
                            <div class="space-y-1.5">
                              <span class="font-semibold text-white/95">{part.taskType}</span>
                              {part.description && (
                                <p class="text-xs font-medium leading-relaxed text-mist-400 tablet:text-sm">
                                  {part.description}
                                </p>
                              )}
                              {part.checklist && part.checklist.length > 0 && (
                                <div class="flex flex-wrap items-center gap-1.5 pt-1">
                                  <span class="text-[11px] font-bold uppercase tracking-wider text-mist-400">
                                    Schritte:
                                  </span>
                                  {part.checklist.map((step) => (
                                    <span class="inline-flex items-center gap-1 rounded-md border-[1.5px] border-white/10 bg-white/4 px-2 py-0.5 text-[11px] font-medium text-mist-300">
                                      <Check class="size-2.5 text-emerald-400" />
                                      {step}
                                    </span>
                                  ))}
                                </div>
                              )}
                            </div>
                          </td>

                          <!-- Items / Tasks Count -->
                          <td class="px-4 py-4 text-center align-top whitespace-nowrap tablet:px-6">
                            <span class="inline-flex items-center whitespace-nowrap rounded-full border-[1.5px] border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-semibold text-mist-200">
                              {part.items} {part.items === 1 ? "Aufgabe" : "Aufgaben"}
                            </span>
                          </td>

                          <!-- Points -->
                          <td class="px-4 py-4 text-right align-top whitespace-nowrap tablet:px-6">
                            <span class="text-sm font-bold text-amber-300 whitespace-nowrap tablet:text-base">
                              {part.points} P.
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <!-- Mobile Scroll Hint -->
                <div class="flex items-center justify-between border-t border-white/5 px-4 py-2 text-[11px] text-mist-500 tablet:hidden">
                  <span>Horizontal scrollen für alle Spalten</span>
                </div>

                <!-- Tips & Training Action Footer inside the frame -->
                <div class="space-y-5 border-t border-white/10 bg-white/2 p-5 tablet:p-6">
                  <!-- Tips box -->
                  {section.tips && section.tips.length > 0 && (
                    <div class="overflow-hidden rounded-xl border-[1.5px] border-amber-500/20 bg-amber-500/5 p-4 tablet:p-5">
                      <div class="mb-3 flex items-center justify-between border-b border-amber-500/15 pb-2.5">
                        <div class="flex items-center gap-2">
                          <Lightbulb class="size-4 text-amber-400" />
                          <h4 class="text-xs font-bold uppercase tracking-wider text-amber-200 tablet:text-sm">
                            Strategie & wichtige Tipps
                          </h4>
                        </div>
                        <span class="rounded-full border-[1.5px] border-amber-500/20 bg-amber-500/10 px-2 py-0.5 text-[11px] font-semibold text-amber-300">
                          Goethe & ÖSD Standard
                        </span>
                      </div>
                      <ul class="space-y-2.5 text-xs font-medium text-mist-300 tablet:text-sm">
                        {section.tips.map((tip) => (
                          <li class="flex items-start gap-2.5">
                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-amber-400"></span>
                            <span class="leading-relaxed">{tip}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <!-- Action Buttons -->
                  <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                    <div class="flex flex-wrap items-center gap-3">
                      {isSpeakingOrWriting ?
                        <a
                          class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-mist-300 no-underline transition-colors hover:border-white/20 hover:bg-white/10 hover:text-white"
                          href={`/pruefung/${currentExam.id}/${moduleSlug}/`}
                        >
                          <MessageSquare class="size-4" />
                          <span>Lernmodus & Redemittel</span>
                        </a>
                      : <a
                          class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-mist-300 no-underline transition-colors hover:border-white/20 hover:bg-white/10 hover:text-white"
                          href={`/pruefung/${currentExam.id}/modelltests/`}
                        >
                          <FileEdit class="size-4" />
                          <span>Modelltests ansehen</span>
                        </a>
                      }
                    </div>

                    <span class="text-xs text-mist-500">Bestehen: mind. 60 von 100 Punkten</span>
                  </div>
                </div>
              </article>
            );
          })}
        </section>
      </div>
    </div>
  : <div class="px-4 py-12 text-center text-white tablet:py-16">
      <h1 class="mb-3 text-2xl font-bold tablet:text-3xl">Prüfung nicht gefunden</h1>
      <p class="mx-auto mb-6 max-w-md text-zinc-400 leading-relaxed">
        Die gewünschte Prüfungsstufe existiert nicht.
      </p>
      <BackButton />
    </div>
  }
</Layout>
