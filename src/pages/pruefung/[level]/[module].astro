---
import { getExamLevel, getRedemittel, ModuleStudyView } from "@/features/pruefung";
import { getThemen } from "@/features/themen";
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/shared/ui/BackButton.astro";

export async function getStaticPaths() {
  return [
    { params: { level: "b1", module: "sprechen" } },
    { params: { level: "b1", module: "schreiben" } },
    { params: { level: "b2", module: "sprechen" } },
    { params: { level: "b2", module: "schreiben" } },
  ];
}

const { level, module } = Astro.params;

if (!level || (module !== "sprechen" && module !== "schreiben")) {
  throw new Error("Ungültige Modul-Parameter.");
}

const [examResponse, redemittelResponse, themenResponse] = await Promise.all([
  getExamLevel(level),
  getRedemittel(level),
  getThemen(),
]);

const currentExam = examResponse.data;
const redemittel = redemittelResponse.data;
const themen = themenResponse.data;
---

<Layout
  description={`Struktur-Checkliste und Themen für den ${module}-Teil der Prüfung.`}
  title={
    currentExam ?
      `${currentExam.level} ${module.charAt(0).toUpperCase() + module.slice(1)} - Vorbereitung`
    : "Modul - Vorbereitung"
  }
>
  {!currentExam || !redemittel ?
    <div class="px-8 py-16 text-center text-white">
      <h1 class="mb-4 text-3xl">Lektion nicht gefunden</h1>
      <p class="mb-8 text-zinc-400">Das gewünschte Prüfungsmodul existiert nicht.</p>
      <BackButton
        href={`/pruefung/${level}`}
        label="Zurück zum Prüfungsniveau"
      />
    </div>
  : <main data-animate="fade-up">
      <ModuleStudyView
        client:load
        examData={currentExam}
        initialThemen={themen ?? []}
        level={level}
        module={module}
        redemittel={redemittel}
      />
    </main>
  }
</Layout>
