---
import { getExamLevel, getRedemittel, ModuleStudyView } from "@/features/pruefung";
import { getThemen } from "@/features/themen";
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/shared/ui/BackButton.astro";

export async function getStaticPaths() {
  return [
    { params: { level: "b1", module: "sprechen" } },
    { params: { level: "b1", module: "schreiben" } },
    { params: { level: "b2", module: "sprechen" } },
    { params: { level: "b2", module: "schreiben" } },
  ];
}

const { level, module } = Astro.params;

if (!level || (module !== "sprechen" && module !== "schreiben")) {
  throw new Error("Ungültige Modul-Parameter.");
}

const [examResponse, redemittelResponse, themenResponse] = await Promise.all([
  getExamLevel(level),
  getRedemittel(level),
  getThemen(),
]);

const currentExam = examResponse.data;
const redemittel = redemittelResponse.data;
const themen = themenResponse.data;

const moduleName = module.charAt(0).toUpperCase() + module.slice(1);
const pageTitle =
  currentExam ?
    `${currentExam.level.toUpperCase()} ${moduleName} Vorbereitung & Redemittel | Elite Regewelt`
  : `Modul ${moduleName} Vorbereitung | Elite Regewelt`;

const pageDescription =
  currentExam ?
    `Gezieltes Training für das Prüfungsmodul ${moduleName} (${currentExam.level.toUpperCase()}). Redemittel, Argumente und Themen für Goethe & ÖSD.`
  : `Struktur-Checkliste und Redemittel für den ${moduleName}-Teil der Deutschprüfung.`;

const moduleSchema =
  currentExam ?
    {
      "@type": "LearningResource",
      name: `${currentExam.level.toUpperCase()} ${moduleName} Training & Redemittel`,
      description: pageDescription,
      educationalLevel: currentExam.level,
      inLanguage: "de",
      learningResourceType: "Exam Preparation",
      provider: { "@type": "Organization", name: "Elite Regewelt" },
    }
  : undefined;
---

<Layout
  description={pageDescription}
  extraSchema={moduleSchema}
  title={pageTitle}
>
  {!currentExam || !redemittel ?
    <div class="px-8 py-16 text-center text-white">
      <h1 class="mb-4 text-3xl">Lektion nicht gefunden</h1>
      <p class="mb-8 text-zinc-400">Das gewünschte Prüfungsmodul existiert nicht.</p>
      <BackButton
        href={`/pruefung/${level}/`}
        label="Zurück zum Prüfungsniveau"
      />
    </div>
  : <div
      class="animate-fade-in"
      data-animate="fade-up"
    >
      <ModuleStudyView
        examData={currentExam}
        initialThemen={themen ?? []}
        level={level}
        module={module}
        redemittel={redemittel}
      />
    </div>
  }
</Layout>
