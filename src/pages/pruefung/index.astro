---
import { getExamLevels, PruefungSection } from "@/features/pruefung";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/shared/ui/PageHeader.astro";
import { ClipboardList } from "lucide-astro";

const { data: examLevels } = await getExamLevels();
---

<Layout
  description="B1/B2 Prüfungsvorbereitung - Modelltests, Lesen, Hören, Schreiben, Sprechen. Trainiere für deine Deutschprüfung."
  title="Prüfungstraining | Deutsch Lernen"
>
  <main class="animate-fade-in">
    <PageHeader
      icon={ClipboardList}
      subtitle="Strukturierte Vorbereitung auf die Goethe & ÖSD Zertifikate B1 und B2"
      title="Prüfungstraining"
    />
    <PruefungSection examLevels={examLevels ?? []} />
  </main>
</Layout>
