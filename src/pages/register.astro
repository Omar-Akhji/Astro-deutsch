---
import { AuthCard } from "@/features/auth";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  description="Erstelle ein kostenloses Konto bei Elite Regewelt, um deine Vokabel- und Grammatikfortschritte zu speichern."
  robots="noindex, nofollow"
  title="Registrieren | Elite Regewelt"
>
  <div class="flex w-full min-w-0 items-center justify-center py-6 tablet:py-10">
    <AuthCard
      client:load
      defaultView="signup"
    />
  </div>
</Layout>
