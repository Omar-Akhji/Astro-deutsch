---
import AuthCard from "../features/auth/ui/AuthCard.vue";
import Layout from "../layouts/Layout.astro";
---

<Layout
  description="Erstelle ein kostenloses Konto bei Deutsch Lernen, um deine Vokabel- und Grammatikfortschritte zu speichern."
  title="Registrieren | Deutsch Lernen"
>
  <main class="container mx-auto px-4 py-16 flex justify-center items-center">
    <AuthCard
      client:load
      defaultView="signup"
    />
  </main>
</Layout>
