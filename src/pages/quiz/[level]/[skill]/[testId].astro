---
import { getQuestions, quizQuestions, QuizView } from "@/features/quiz";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const paths = [];
  for (const [level, skillsMap] of quizQuestions.entries()) {
    for (const [skill, testsMap] of skillsMap.entries()) {
      for (const testId of testsMap.keys()) {
        paths.push({ params: { level: level.toLowerCase(), skill, testId: testId.toString() } });
      }
    }
  }
  return paths;
}

const { level, skill, testId } = Astro.params;

if (!level || !skill || !testId) {
  throw new Error("Fehlende Quiz-Parameter.");
}

const parsedTestId = Number(testId);
const { data: questions } = await getQuestions(level, skill, parsedTestId);
---

<Layout
  description="Teste dein Wissen mit interaktiven Quizfragen zu Lesen, Hören, Schreiben und Sprechen."
  title="Quiz | Deutsch Lernen"
>
  <QuizView
    client:load
    initialQuestions={questions ?? []}
    level={level}
    skill={skill}
    testId={testId}
  />
</Layout>
