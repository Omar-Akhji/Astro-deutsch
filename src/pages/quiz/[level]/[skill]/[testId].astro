---
import { QuizView } from "@/features/quiz";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const quizEntries = await getCollection("quiz");
  return quizEntries.map((entry) => ({
    params: {
      level: entry.data.level.toLowerCase(),
      skill: entry.data.skill.toLowerCase(),
      testId: entry.data.testId.toString(),
    },
    props: { questions: entry.data.questions },
  }));
}

const { level, skill, testId } = Astro.params;
const { questions } = Astro.props;

if (!level || !skill || !testId) {
  throw new Error("Fehlende Quiz-Parameter.");
}
---

<Layout
  description="Teste dein Wissen mit interaktiven Quizfragen zu Lesen, Hören, Schreiben und Sprechen."
  title="Quiz | Deutsch Lernen"
>
  <QuizView
    client:load
    initialQuestions={questions ?? []}
    level={level}
    skill={skill}
    testId={testId}
  />
</Layout>
