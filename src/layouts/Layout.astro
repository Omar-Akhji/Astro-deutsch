---
interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = "Elite Regewelt | Deine Plattform für Erfolg",
  description = "Die umfassende Plattform für dein Deutsch-Training. Vokabeln, Grammatik-Lektionen und gezielte Goethe & ÖSD Prüfungsvorbereitung für das B1 & B2 Zertifikat.",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
} = Astro.props;
import { ClientRouter } from "astro:transitions";
import Footer from "../shared/ui/Footer.astro";
import Navigation from "../shared/ui/Navigation.vue";
import SkeletonLayouts from "../shared/ui/SkeletonLayouts.vue";
import "../styles/global.css";

const pathname = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://deutsch-lernen.com").href;
const ogImageURL = new URL("/og-image.png", Astro.site ?? "https://deutsch-lernen.com").href;

// Breadcrumb structured data for Google SERP
const pathSegments = pathname.split("/").filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Startseite",
    item: Astro.site ? Astro.site.toString() : "https://deutsch-lernen.com",
  },
  ...pathSegments.map((segment, index) => {
    const url = new URL("/" + pathSegments.slice(0, index + 1).join("/"), Astro.site ?? "https://deutsch-lernen.com").href;
    const name = segment.charAt(0).toUpperCase() + segment.slice(1);
    return {
      "@type": "ListItem",
      position: index + 2,
      name,
      item: url,
    };
  }),
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://deutsch-lernen.com/#website",
      url: "https://deutsch-lernen.com",
      name: "Elite Regewelt",
      description: "Interaktive Lernplattform für die deutsche Sprache (A1 - B2).",
      inLanguage: "de",
      potentialAction: {
        "@type": "SearchAction",
        target: "https://deutsch-lernen.com/themen?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "EducationalOrganization",
      "@id": "https://deutsch-lernen.com/#organization",
      name: "Elite Regewelt",
      url: "https://deutsch-lernen.com",
      logo: "https://deutsch-lernen.com/logo.png",
      description: "Vorbereitung auf das Goethe-Zertifikat und ÖSD B1 & B2.",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
  ],
};
void schemaJson;
---

<!doctype html>
<html
  class="dark no-js"
  lang="de"
  style="--font-poppins: 'Poppins', system-ui, sans-serif; --font-arabic: 'Cairo', 'Noto Sans Arabic', system-ui, sans-serif;"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      content="width=device-width, initial-scale=1.0"
      name="viewport"
    />
    <title>{title}</title>
    <meta
      content={description}
      name="description"
    />
    <ClientRouter />

    <!-- Canonical & Sitemap Discovery -->
    <link
      href={canonicalURL}
      rel="canonical"
    />
    <link
      href="/sitemap-index.xml"
      rel="sitemap"
    />

    <!-- Robots Meta for Search Engines -->
    <meta
      content={robots}
      name="robots"
    />
    <meta
      content={robots.includes("noindex") ? "noindex, nofollow" : "index, follow"}
      name="googlebot"
    />

    <!-- Open Graph / Facebook -->
    <meta
      content="website"
      property="og:type"
    />
    <meta
      content="Elite Regewelt"
      property="og:site_name"
    />
    <meta
      content={canonicalURL}
      property="og:url"
    />
    <meta
      content={title}
      property="og:title"
    />
    <meta
      content={description}
      property="og:description"
    />
    <meta
      content={ogImageURL}
      property="og:image"
    />
    <meta
      content="image/png"
      property="og:image:type"
    />
    <meta
      content="1200"
      property="og:image:width"
    />
    <meta
      content="630"
      property="og:image:height"
    />
    <meta
      content={title}
      property="og:image:alt"
    />
    <meta
      content="de_DE"
      property="og:locale"
    />

    <!-- Twitter / X Cards -->
    <meta
      content="summary_large_image"
      name="twitter:card"
    />
    <meta
      content={canonicalURL}
      name="twitter:url"
    />
    <meta
      content={title}
      name="twitter:title"
    />
    <meta
      content={description}
      name="twitter:description"
    />
    <meta
      content={ogImageURL}
      name="twitter:image"
    />

    <!-- Structured Data (JSON-LD) for Rich Results -->
    <script
      is:inline
      type="application/ld+json"
    >{JSON.stringify(schemaJson)}</script>

    <!-- Favicon & Brand Icons -->
    <link
      href="/favicon.ico"
      rel="icon"
      sizes="any"
    />
    <link
      href="/logo.png"
      rel="icon"
      type="image/png"
    />
    <link
      href="/favicon-32x32.png"
      rel="icon"
      sizes="32x32"
      type="image/png"
    />
    <link
      href="/favicon.png"
      rel="apple-touch-icon"
      sizes="512x512"
    />
    <link
      href="https://fonts.googleapis.com"
      rel="preconnect"
    />
    <link
      crossorigin
      href="https://fonts.gstatic.com"
      rel="preconnect"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

  </head>
  <body class="antialiased">
    <script src="../shared/scripts/init.ts"></script>
    <script src="../shared/scripts/analytics.ts"></script>
    <div class="container mx-auto max-w-7xl">
      <Navigation
        client:load
        pathname={pathname}
      />
      <div class="px-3 mobile:px-6 tablet:px-8 pb-24 tablet:pb-0">
        <main>
          <!-- Skeleton container: hidden by default, shown during navigation -->
          <div
            aria-hidden="true"
            class="hidden"
            id="skeleton-container"
          >
            <div
              class="hidden"
              data-skeleton="/"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="home"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/themen"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="themen"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/grammatik"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="grammar-overview"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/grammatik/detail"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="grammar-detail"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/vokabeln"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="vocabulary-overview"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/vokabeln/level"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="vocabulary-level"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/vokabeln/detail"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="vocabulary-detail"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/vokabeln/family-tree"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="family-tree"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/pruefung"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="pruefung-overview"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/pruefung/level"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="pruefung-level"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/pruefung/modelltests"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="pruefung-modelltests"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/pruefung/study"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="pruefung-module-study"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/quiz"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="quiz"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/login"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="auth"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/register"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="auth"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="/404"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="404"
              />
            </div>
            <div
              class="hidden"
              data-skeleton="default"
            >
              <SkeletonLayouts
                client:only="vue"
                layout="default-pending"
              />
            </div>
          </div>

          <!-- Page Content -->
          <div id="page-content">
            <slot />
          </div>
        </main>
        <Footer />
      </div>
    </div>
    <script src="../shared/scripts/transitions.ts"></script>
    <script src="../shared/scripts/animations.ts"></script>
  </body>
</html>
