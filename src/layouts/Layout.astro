---
import { ClientRouter } from "astro:transitions";
import TransitionSkeletons from "./components/TransitionSkeletons.astro";
import { Footer, FooterSkeleton } from "@/widgets/footer";
import { Navigation } from "@/widgets/navigation";
import "@/styles/global.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  robots?: string | undefined;
  extraSchema?: Record<string, unknown>[] | Record<string, unknown> | undefined;
  customBreadcrumbs?: { name: string; item: string }[] | undefined;
}

const {
  title = "Elite Regewelt | Deine Plattform für Erfolg",
  description = "Die umfassende Plattform für dein Deutsch-Training. Vokabeln, Grammatik-Lektionen und gezielte Goethe & ÖSD Prüfungsvorbereitung für das B1 & B2 Zertifikat.",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  extraSchema,
  customBreadcrumbs,
} = Astro.props;

const pathname = Astro.url.pathname;
const normalizedPathname = pathname.endsWith("/") ? pathname : `${pathname}/`;
const siteUrl =
  Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://elite-regewelt.com";
const canonicalURL = new URL(normalizedPathname, siteUrl).href;
const ogImageURL = new URL("/og-image.png", siteUrl).href;

const BREADCRUMB_MAP: Record<string, string> = {
  vokabeln: "Vokabeln",
  grammatik: "Grammatik",
  pruefung: "Prüfung",
  themen: "B1 Themen",
  quiz: "Quiz",
  modelltests: "Modelltests",
  b1: "Niveau B1",
  b2: "Niveau B2",
  lesen: "Lesen",
  hoeren: "Hören",
  schreiben: "Schreiben",
  sprechen: "Sprechen",
  verben: "Verben",
  nomen: "Nomen",
  praepositionen: "Präpositionen",
  satz: "Satzbau",
  adverbien: "Adverbien",
  partikeln: "Partikeln",
  "1": "Familie & Alltag",
  "2": "Wohnen & Haushalt",
  "3": "Essen & Trinken",
  "4": "Reisen & Verkehr",
  "5": "Stadt & Einkaufen",
  "6": "Schule & Beruf",
  "7": "Medien & Technik",
  "8": "Freizeit & Hobbys",
  "9": "Gesundheit & Körper",
  "10": "Notfall & Hilfe",
  "11": "Wetter & Natur",
  "12": "Zeit & Kalender",
};

const formatSegmentName = (segment: string) => {
  if (BREADCRUMB_MAP[segment.toLowerCase()]) {
    return BREADCRUMB_MAP[segment.toLowerCase()];
  }
  return segment
    .split(/[-_]/)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
};

// Breadcrumb structured data for Google SERP
const pathSegments = pathname.split("/").filter(Boolean);
const breadcrumbItems =
  customBreadcrumbs ?
    customBreadcrumbs.map((b, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: b.name,
      item: b.item,
    }))
  : [
      { "@type": "ListItem", position: 1, name: "Startseite", item: `${siteUrl}/` },
      ...pathSegments.map((segment, index) => {
        const url = new URL("/" + pathSegments.slice(0, index + 1).join("/") + "/", siteUrl).href;
        const name = formatSegmentName(segment);
        return { "@type": "ListItem", position: index + 2, name, item: url };
      }),
    ];

const additionalSchemas =
  Array.isArray(extraSchema) ? extraSchema
  : extraSchema ? [extraSchema]
  : [];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "Elite Regewelt",
      description: "Interaktive Lernplattform für die deutsche Sprache (A1 - B2).",
      inLanguage: "de",
      potentialAction: {
        "@type": "SearchAction",
        target: { "@type": "EntryPoint", urlTemplate: siteUrl + "/themen/?q={search_term_string}" },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "EducationalOrganization",
      "@id": `${siteUrl}/#organization`,
      name: "Elite Regewelt",
      url: `${siteUrl}/`,
      logo: `${siteUrl}/logo.png`,
      description: "Vorbereitung auf das Goethe-Zertifikat und ÖSD B1 & B2.",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
    ...additionalSchemas,
  ],
};
---

<!doctype html>
<html
  class="dark no-js"
  lang="de"
  style="--font-poppins: 'Poppins', system-ui, sans-serif; --font-arabic: 'Cairo', 'Noto Sans Arabic', system-ui, sans-serif;"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      content="width=device-width, initial-scale=1.0"
      name="viewport"
    />
    <title>{title}</title>
    <meta
      content={description}
      name="description"
    />
    <meta
      content="#0d0e12"
      name="theme-color"
    />
    <meta
      content="telephone=no"
      name="format-detection"
    />
    <ClientRouter />

    <!-- Canonical & Sitemap Discovery -->
    <link
      href={canonicalURL}
      rel="canonical"
    />
    <link
      href="/sitemap-index.xml"
      rel="sitemap"
    />

    <!-- Robots Meta for Search Engines -->
    <meta
      content={robots}
      name="robots"
    />
    <meta
      content={robots.includes("noindex") ? "noindex, nofollow" : "index, follow"}
      name="googlebot"
    />

    <!-- Open Graph / Facebook -->
    <meta
      content="website"
      property="og:type"
    />
    <meta
      content="Elite Regewelt"
      property="og:site_name"
    />
    <meta
      content={canonicalURL}
      property="og:url"
    />
    <meta
      content={title}
      property="og:title"
    />
    <meta
      content={description}
      property="og:description"
    />
    <meta
      content={ogImageURL}
      property="og:image"
    />
    <meta
      content="image/png"
      property="og:image:type"
    />
    <meta
      content="1200"
      property="og:image:width"
    />
    <meta
      content="630"
      property="og:image:height"
    />
    <meta
      content={title}
      property="og:image:alt"
    />
    <meta
      content="de_DE"
      property="og:locale"
    />

    <!-- Twitter / X Cards -->
    <meta
      content="summary_large_image"
      name="twitter:card"
    />
    <meta
      content={canonicalURL}
      name="twitter:url"
    />
    <meta
      content={title}
      name="twitter:title"
    />
    <meta
      content={description}
      name="twitter:description"
    />
    <meta
      content={ogImageURL}
      name="twitter:image"
    />

    <!-- Structured Data (JSON-LD) for Rich Results -->
    <script
      is:inline
      set:html={JSON.stringify(schemaJson)}
      type="application/ld+json"
    ></script>
    <!-- Favicon & Brand Icons -->
    <link
      href="/favicon.ico"
      rel="icon"
      sizes="any"
    />
    <link
      href="/logo.png"
      rel="icon"
      type="image/png"
    />
    <link
      href="/favicon-32x32.png"
      rel="icon"
      sizes="32x32"
      type="image/png"
    />
    <link
      href="/favicon.png"
      rel="apple-touch-icon"
      sizes="512x512"
    />
    <link
      href="https://fonts.googleapis.com"
      rel="preconnect"
    />
    <link
      crossorigin
      href="https://fonts.gstatic.com"
      rel="preconnect"
    />
    <link
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="preload"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
      rel="stylesheet"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class="antialiased">
    <script src="@/shared/scripts/init.ts"></script>
    <script src="@/shared/scripts/analytics.ts"></script>
    <div class="container mx-auto max-w-7xl">
      <Navigation pathname={pathname} />
      <div class="px-4 mobile:px-6 tablet:px-8 pb-24 tablet:pb-28 laptop:pb-0">
        <main>
          <!-- Skeleton container: hidden by default, shown during navigation -->
          <TransitionSkeletons />

          <!-- Page Content -->
          <div id="page-content">
            <slot />
          </div>
        </main>
        <!-- Footer with transition skeleton support -->
        <div
          aria-hidden="true"
          class="hidden"
          id="footer-skeleton"
        >
          <FooterSkeleton />
        </div>
        <div id="footer-content">
          <Footer />
        </div>
      </div>
    </div>
    <script src="@/shared/scripts/transitions.ts"></script>
    <script src="@/shared/scripts/animations.ts"></script>
  </body>
</html>
