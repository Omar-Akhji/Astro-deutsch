---
import CardSkeleton from "@/shared/ui/CardSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/PageHeaderSkeleton.astro";
import Skeleton from "@/shared/ui/Skeleton.astro";
import { HeroSkeleton } from "@/widgets/hero";

interface Props {
  variant?: "overview" | "detail";
}

const { variant = "overview" } = Astro.props;
---

{variant === "overview" && (
  <div class="py-4 mobile:py-8">
    <PageHeaderSkeleton />

    {["sec1", "sec2", "sec3"].map(() => (
      <div class="mbe-16">
        <div class="mbe-8 flex items-center gap-3 tablet:gap-4">
          <Skeleton class="size-10 shrink-0 rounded-full border-[3px] border-white/10 bg-white/5 tablet:size-12" />
          <Skeleton class="h-8 w-52 rounded-md bg-white/10 tablet:h-9 tablet:w-64" />
        </div>

        <div class="grid grid-cols-1 gap-6 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
          {["g1", "g2", "g3"].map(() => (
            <CardSkeleton />
          ))}
        </div>
      </div>
    ))}
  </div>
)}

{variant === "detail" && (
  <div class="relative min-h-dvh py-8">
    <div class="animate-fade-in space-y-8">
      <!-- Compact Hero Header -->
      <HeroSkeleton variant="compact" statsCount={3} hasExample={true} />

      <!-- Overview Navigation Bar -->
      <div class="rounded-2xl border-2 border-white/10 bg-card/60 p-5 shadow-lg backdrop-blur-(--glass-blur) tablet:p-6">
        <div class="flex flex-col items-center gap-4 text-center">
          <div class="space-y-1.5">
            <div class="flex items-center justify-center gap-2">
              <span class="size-2 rounded-full bg-white/40"></span>
              <Skeleton class="h-4.5 w-60 rounded-md bg-white/15 tablet:h-5 tablet:w-72" />
            </div>
            <Skeleton class="mx-auto h-3.5 w-full max-w-xl rounded-md bg-white/5" />
          </div>

          <nav aria-label="Unterthemen Navigation" class="flex flex-wrap items-center justify-center gap-2.5">
            <!-- 1.1 haben – sein – werden (Gebrauch) (269px) -->
            <div class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-white/10 bg-white/5 px-3 py-1 max-w-full" style="width: 269px;">
              <Skeleton class="h-3.5 w-4 shrink-0 rounded-md bg-white/20" />
              <Skeleton class="h-3.5 flex-1 rounded-md bg-white/10" style="width: 224px;" />
            </div>

            <!-- 1.2 haben – sein – werden (Konjugation) (286px) -->
            <div class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-white/10 bg-white/5 px-3 py-1 max-w-full" style="width: 286px;">
              <Skeleton class="h-3.5 w-4 shrink-0 rounded-md bg-white/20" />
              <Skeleton class="h-3.5 flex-1 rounded-md bg-white/10" style="width: 239px;" />
            </div>

            <!-- 1.3 Modalverben (132px) -->
            <div class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-white/10 bg-white/5 px-3 py-1 max-w-full" style="width: 132px;">
              <Skeleton class="h-3.5 w-4 shrink-0 rounded-md bg-white/20" />
              <Skeleton class="h-3.5 flex-1 rounded-md bg-white/10" style="width: 84px;" />
            </div>

            <!-- 1.4 Modalverben (Konjugation) (227px) -->
            <div class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-white/10 bg-white/5 px-3 py-1 max-w-full" style="width: 227px;">
              <Skeleton class="h-3.5 w-4 shrink-0 rounded-md bg-white/20" />
              <Skeleton class="h-3.5 flex-1 rounded-md bg-white/10" style="width: 178px;" />
            </div>
          </nav>
        </div>
      </div>

      <!-- Subtopics Sections -->
      <section class="space-y-8">
        {["subtopic-1", "subtopic-2"].map((_, index) => (
          <article class="overflow-hidden rounded-3xl border-2 border-white/10 bg-card/60 shadow-xl backdrop-blur-(--glass-blur)">
            <!-- Subtopic Header Banner -->
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 bg-white/5 px-5 py-4 tablet:px-7">
              <div class="flex items-center gap-3">
                <Skeleton class="h-6 w-8 rounded-lg bg-white/20" />
                <Skeleton class="h-6 w-48 rounded-md bg-white/15 tablet:w-64" />
              </div>

              <div class="flex items-center gap-2">
                <Skeleton class="h-5 w-16 rounded-full border-[1.5px] border-white/10 bg-white/5" />
                <Skeleton class="h-5 w-20 rounded-full border-[1.5px] border-white/10 bg-white/5" />
              </div>
            </header>

            <!-- Subtopic Content Body -->
            <div class="space-y-6 p-5 tablet:p-7">
              <Skeleton class="h-4 w-3/4 max-w-xl rounded-md bg-white/5" />

              <!-- Nested Table (for subtopic with table) -->
              {index === 0 && (
                <div class="overflow-hidden rounded-2xl border-2 border-white/10 bg-card/60 shadow-lg backdrop-blur-(--glass-blur)">
                  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 bg-white/5 px-4 py-3.5 tablet:px-6">
                    <Skeleton class="h-4 w-44 rounded-md bg-white/10" />
                    <Skeleton class="h-5 w-18 rounded-full border-[1.5px] border-white/10 bg-white/5" />
                  </div>
                  <div class="has-scrollbar overflow-x-auto">
                    <table class="w-full border-collapse text-left text-sm tablet:text-base">
                      <thead class="border-b border-white/10 bg-white/5">
                        <tr>
                          {["th1", "th2", "th3", "th4"].map(() => (
                            <th class="px-4 py-3.5 tablet:px-6">
                              <Skeleton class="h-4 w-20 rounded-md bg-white/10" />
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-white/5">
                        {["r1", "r2", "r3", "r4"].map(() => (
                          <tr>
                            <td class="px-4 py-3 tablet:px-6">
                              <Skeleton class="h-4 w-20 rounded-md bg-white/15" />
                            </td>
                            <td class="px-4 py-3 tablet:px-6">
                              <Skeleton class="h-4 w-24 rounded-md bg-white/5" />
                            </td>
                            <td class="px-4 py-3 tablet:px-6">
                              <Skeleton class="h-4 w-28 rounded-md bg-white/5" />
                            </td>
                            <td class="px-4 py-3 tablet:px-6">
                              <Skeleton class="h-4 w-20 rounded-md bg-white/5" />
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              <!-- Content Rule Block Frame -->
              <div class="overflow-hidden rounded-2xl border-2 border-white/10 bg-card/60 shadow-md backdrop-blur-(--glass-blur)">
                <div class="flex items-center justify-between border-b border-white/10 bg-white/5 px-4 py-3 tablet:px-6">
                  <Skeleton class="h-4 w-32 rounded-md bg-white/15" />
                  <Skeleton class="h-4 w-20 rounded-full border-[1.5px] border-white/10 bg-white/5" />
                </div>
                <div class="divide-y divide-white/5">
                  {["item1", "item2"].map(() => (
                    <div class="space-y-2 p-4 tablet:p-5">
                      <div class="flex flex-wrap items-center gap-2">
                        <Skeleton class="h-5 w-16 rounded-md bg-white/10" />
                        <Skeleton class="h-4 w-48 rounded-md bg-white/10" />
                      </div>
                      <Skeleton class="h-3.5 w-3/4 rounded-md bg-white/5" />
                    </div>
                  ))}
                </div>
              </div>

              <!-- Tips Box -->
              <div class="overflow-hidden rounded-2xl border-2 border-white/10 bg-card/60 p-5 shadow-lg backdrop-blur-(--glass-blur) tablet:p-6">
                <div class="mb-4 flex items-center justify-between border-b border-white/10 pb-3">
                  <div class="flex items-center gap-2.5">
                    <Skeleton class="size-7 rounded-lg border-[1.5px] border-white/10 bg-white/10" />
                    <Skeleton class="h-4 w-44 rounded-md bg-white/15" />
                  </div>
                  <Skeleton class="h-5 w-24 rounded-full border-[1.5px] border-white/10 bg-white/5" />
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                  {["t1", "t2"].map(() => (
                    <div class="flex items-start gap-3 rounded-xl border-[1.5px] border-white/10 bg-white/5 p-3.5">
                      <Skeleton class="mt-1 size-5 shrink-0 rounded-full bg-white/15" />
                      <Skeleton class="h-4 w-full rounded-md bg-white/5" />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </section>
    </div>
  </div>
)}
