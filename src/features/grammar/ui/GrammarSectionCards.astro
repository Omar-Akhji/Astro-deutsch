---
import { BookOpen, Clock, FileText, LayoutList, Link, MessageCircle } from "lucide-astro";
import { getGradient } from "../../../shared/lib/utilities";
import Card from "../../../shared/ui/Card.astro";
import type { GrammarSection } from "../model/types";

interface Props {
  section: GrammarSection;
}

const { section } = Astro.props;

const ICON_MAP: Record<string, any> = {
  BookOpen,
  FileText,
  Link,
  LayoutList,
  Clock,
  MessageCircle,
};

const SectionIcon = ICON_MAP[section.icon] ?? BookOpen;
---

<section
  aria-labelledby={`${section.id}-heading`}
  class="mbe-16"
>
  <h2
    class="mbe-8 flex items-center gap-3 text-2xl text-text text-shadow-sm tablet:text-3xl"
    id={`${section.id}-heading`}
  >
    <span
      aria-hidden="true"
      class="flex size-10 shrink-0 items-center justify-center rounded-full border-[3px] border-solid border-yellow bg-mist-900/50 text-yellow shadow-sm tablet:size-12"
    >
      <SectionIcon class="size-5 tablet:size-6" />
    </span>
    {section.title}
  </h2>

  <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
    {section.topics.map((topic, index) => (
      <li class="h-full">
        <Card
          category={topic.number}
          description={topic.description}
          gradient={getGradient(index, section.gradients)}
          href={`/grammatik/${section.id}/${topic.id}`}
          subtitle={topic.category}
          title={topic.title}
        />
      </li>
    ))}
  </ul>
</section>
