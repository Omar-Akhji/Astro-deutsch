---
import type { GrammarThemePalette } from "../lib/theme.ts";
import type { GrammarTableData } from "../model/types.ts";
import ContentItem from "./ContentItem.astro";

interface Props {
  data: GrammarTableData;
  theme?: GrammarThemePalette | undefined;
}

const { data, theme } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-2xl border-2 bg-card/60 shadow-lg backdrop-blur-(--glass-blur) transition-all duration-200",
    theme?.cardBorderClass ?? "border-white/10 hover:border-white/20",
  ]}
  data-animate="fade-up"
>
  <!-- Table Header Bar -->
  <div
    class:list={[
      "flex flex-wrap items-center justify-between gap-3 border-b px-4 py-3.5 tablet:px-6",
      theme?.headerBorderClass ?? "border-white/10",
      theme?.headerBgClass ?? "bg-white/5",
    ]}
  >
    <div class="flex items-center gap-2.5">
      <h4 class="text-sm font-bold tracking-tight text-white tablet:text-base">
        {data.caption ?? "Grammatik-Übersichtstabelle"}
      </h4>
    </div>

    <div class="flex items-center gap-2">
      <span class="rounded-full border-[1.5px] border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-medium text-mist-400">
        {data.rows.length} {data.rows.length === 1 ? "Form" : "Formen"}
      </span>
    </div>
  </div>

  <!-- Scrollable Table Container -->
  <div class="has-scrollbar overflow-x-auto">
    <table class="w-full border-collapse text-left text-sm tablet:text-base">
      <caption class="sr-only">{data.caption ?? "Grammatik-Übersichtstabelle"}</caption>
      <thead class="border-b border-white/10 bg-white/5 text-[11px] font-bold uppercase tracking-wider text-mist-300 tablet:text-xs">
        <tr>
          {data.headers.map((header, colIndex) => (
            <th
              class:list={{
                "px-4 py-3.5 tablet:px-6 tablet:py-4": true,
                "text-amber-400 font-bold": colIndex === 0,
                "text-mist-200 font-semibold": colIndex !== 0,
              }}
              scope="col"
            >
              {header}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {data.rows.map((row) => (
          <tr class="group/row transition-colors hover:bg-white/4">
            {row.map((cell, colIndex) => {
              const isPerson = colIndex === 0;

              return isPerson ? (
                <th
                  class="whitespace-nowrap px-4 py-3 text-left font-semibold text-amber-300/90 tablet:px-6 tablet:py-3.5"
                  scope="row"
                >
                  <div class="leading-relaxed">
                    <ContentItem content={cell} />
                  </div>
                </th>
              ) : (
                <td class="px-4 py-3 text-white/90 tablet:px-6 tablet:py-3.5">
                  <div class="leading-relaxed">
                    <ContentItem content={cell} />
                  </div>
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Table Mobile Hint -->
  <div class="flex items-center justify-between border-t border-white/5 px-4 py-2 text-[11px] text-mist-500 tablet:hidden">
    <span>Horizontal scrollen für alle Spalten</span>
  </div>
</div>
