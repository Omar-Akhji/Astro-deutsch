---
import type { GrammarCell } from "../model/types.ts";
import FormattedText from "./FormattedText.astro";

interface Props {
  content: GrammarCell;
}

const { content } = Astro.props;
const text = typeof content === "string" ? content : content.text;
const isHighlighted = typeof content !== "string" && Boolean(content.highlight);
---

<span class:list={[{ "font-medium text-yellow": isHighlighted }]}>
  <FormattedText text={text} />
</span>
