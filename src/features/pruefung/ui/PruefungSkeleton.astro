---
import { ThemaCardSkeleton } from "@/features/themen";
import CardSkeleton from "@/shared/ui/CardSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/PageHeaderSkeleton.astro";
import Skeleton from "@/shared/ui/Skeleton.astro";
import { HeroSkeleton } from "@/widgets/hero";

interface Props {
  variant?: "overview" | "level" | "modelltests" | "study";
}

const { variant = "overview" } = Astro.props;
---

{variant === "overview" && (
  <div class="animate-fade-in py-4 mobile:py-8">
    <PageHeaderSkeleton />

    <section class="py-4">
      <div class="grid grid-cols-1 gap-6 py-4 tablet:grid-cols-2 tablet:gap-8">
        {["po1", "po2"].map(() => (
          <CardSkeleton variant="large" />
        ))}
      </div>
    </section>
  </div>
)}

{variant === "level" && (
  <div class="relative min-h-dvh py-6 tablet:py-10">
    <div class="animate-fade-in space-y-8 tablet:space-y-10">
      <!-- Compact Hero Header -->
      <HeroSkeleton
        variant="compact"
        statsCount={2}
        hasExample={true}
      />

      <!-- Quick Navigation & Simulation CTA -->
      <div class="rounded-2xl border-2 border-white/10 bg-card/60 p-5 shadow-lg backdrop-blur-(--glass-blur) tablet:p-6">
        <div class="flex flex-col items-center gap-4 text-center">
          <div class="space-y-1.5">
            <div class="flex items-center justify-center gap-2">
              <span class="size-2 rounded-full bg-white/40"></span>
              <Skeleton class="h-4.5 w-56 rounded-md bg-white/15 tablet:h-5 tablet:w-64" />
            </div>
            <Skeleton class="mx-auto h-3.5 w-full max-w-xl rounded-md bg-white/5" />
          </div>

          <div class="flex flex-wrap items-center justify-center gap-2.5">
            <!-- 1. Lesen (65 Minuten) (Live width: 175px) -->
            <div
              class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 px-3 py-1.5"
              style="width: 175px;"
            >
              <span class="size-2 shrink-0 rounded-full bg-white/20"></span>
              <Skeleton
                class="h-3.5 rounded-md bg-white/15"
                style="width: 45px;"
              />
              <Skeleton
                class="h-3.5 flex-1 rounded-md bg-white/10"
                style="width: 80px;"
              />
            </div>

            <!-- 2. Hören (40 Minuten) (Live width: 180px) -->
            <div
              class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 px-3 py-1.5"
              style="width: 180px;"
            >
              <span class="size-2 shrink-0 rounded-full bg-white/20"></span>
              <Skeleton
                class="h-3.5 rounded-md bg-white/15"
                style="width: 49px;"
              />
              <Skeleton
                class="h-3.5 flex-1 rounded-md bg-white/10"
                style="width: 80px;"
              />
            </div>

            <!-- 3. Schreiben (60 Minuten) (Live width: 205px) -->
            <div
              class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 px-3 py-1.5"
              style="width: 205px;"
            >
              <span class="size-2 shrink-0 rounded-full bg-white/20"></span>
              <Skeleton
                class="h-3.5 rounded-md bg-white/15"
                style="width: 75px;"
              />
              <Skeleton
                class="h-3.5 flex-1 rounded-md bg-white/10"
                style="width: 80px;"
              />
            </div>

            <!-- 4. Sprechen (15 Minuten (+ 15 Min. Vorbereitung)) (Live width: 348px) -->
            <div
              class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 px-3 py-1.5 max-w-full"
              style="width: 348px;"
            >
              <span class="size-2 shrink-0 rounded-full bg-white/20"></span>
              <Skeleton
                class="h-3.5 shrink-0 rounded-md bg-white/15"
                style="width: 72px;"
              />
              <Skeleton
                class="h-3.5 flex-1 rounded-md bg-white/10"
                style="width: 226px;"
              />
            </div>

            <!-- Modelltests CTA Button (Live width: 124px) -->
            <div
              class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 px-3.5 py-1.5 shadow-sm"
              style="width: 124px;"
            >
              <Skeleton class="size-3.5 shrink-0 rounded-sm bg-white/15" />
              <Skeleton
                class="h-3.5 flex-1 rounded-md bg-white/15"
                style="width: 72px;"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- 4 Exam Module Sections -->
      <section class="space-y-8 tablet:space-y-10">
        {["Lesen", "Hören", "Schreiben", "Sprechen"].map(() => (
          <div class="overflow-hidden rounded-2xl border-2 border-white/10 bg-card/60 shadow-lg backdrop-blur-(--glass-blur)">
            <!-- Module Header Bar -->
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 bg-white/5 px-5 py-4 tablet:px-6 tablet:py-5">
              <div class="flex flex-wrap items-center gap-3">
                <Skeleton class="h-6 w-28 rounded-lg border-[1.5px] border-white/10 bg-white/10" />
                <Skeleton class="h-4 w-48 rounded-md bg-white/10" />
              </div>

              <div class="flex flex-wrap items-center gap-2.5">
                <Skeleton class="h-6 w-24 rounded-full border-[1.5px] border-white/10 bg-white/5" />
                <Skeleton class="h-6 w-24 rounded-full border-[1.5px] border-white/10 bg-white/5" />
              </div>
            </div>

            <!-- Module Structure Table (Exact 4 columns: Teil, Aufgabentyp & Struktur, Aufgaben, Punkte) -->
            <div class="has-scrollbar overflow-x-auto">
              <table class="w-full border-collapse text-left text-sm tablet:text-base">
                <thead class="border-b border-white/10 bg-white/4 text-[11px] font-bold uppercase tracking-wider text-mist-300 tablet:text-xs">
                  <tr>
                    <th class="w-24 px-4 py-3.5 whitespace-nowrap tablet:w-28 tablet:px-6 tablet:py-4">
                      <Skeleton class="h-3.5 w-12 rounded-md bg-white/10" />
                    </th>
                    <th class="px-4 py-3.5 tablet:px-6 tablet:py-4">
                      <Skeleton class="h-3.5 w-44 rounded-md bg-white/10" />
                    </th>
                    <th class="w-32 px-4 py-3.5 text-center whitespace-nowrap tablet:w-36 tablet:px-6 tablet:py-4">
                      <Skeleton class="mx-auto h-3.5 w-16 rounded-md bg-white/10" />
                    </th>
                    <th class="w-24 px-4 py-3.5 text-right whitespace-nowrap tablet:w-28 tablet:px-6 tablet:py-4">
                      <Skeleton class="ml-auto h-3.5 w-12 rounded-md bg-white/10" />
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {["p1", "p2", "p3", "p4"].map(() => (
                    <tr>
                      <!-- Part Pill -->
                      <td class="w-24 px-4 py-4 align-top whitespace-nowrap tablet:w-28 tablet:px-6">
                        <Skeleton class="h-6 w-16 rounded-lg border-[1.5px] border-white/15 bg-white/5" />
                      </td>
                      <!-- Task Type & Details -->
                      <td class="px-4 py-4 align-top tablet:px-6">
                        <div class="space-y-1.5">
                          <Skeleton class="h-4 w-44 rounded-md bg-white/15" />
                          <Skeleton class="h-3.5 w-full max-w-md rounded-md bg-white/5" />
                        </div>
                      </td>
                      <!-- Tasks Count Pill -->
                      <td class="w-32 px-4 py-4 text-center align-top whitespace-nowrap tablet:w-36 tablet:px-6">
                        <Skeleton class="mx-auto h-5 w-22 rounded-full border-[1.5px] border-white/10 bg-white/5" />
                      </td>
                      <!-- Points -->
                      <td class="w-24 px-4 py-4 text-right align-top whitespace-nowrap tablet:w-28 tablet:px-6">
                        <Skeleton class="ml-auto h-5 w-12 rounded-md bg-white/15" />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Tips & Strategy Box with Bottom Actions -->
            <div class="space-y-5 border-t border-white/10 bg-white/2 p-5 tablet:p-6">
              <div class="overflow-hidden rounded-xl border-[1.5px] border-white/10 bg-white/5 p-4 tablet:p-5">
                <div class="mb-3 flex items-center justify-between border-b border-white/10 pb-2.5">
                  <div class="flex items-center gap-2">
                    <Skeleton class="size-4 rounded-full bg-white/20" />
                    <Skeleton class="h-4 w-48 rounded-md bg-white/15" />
                  </div>
                  <Skeleton class="h-5 w-32 rounded-full border-[1.5px] border-white/10 bg-white/5" />
                </div>
                <div class="space-y-2.5">
                  <div class="flex items-start gap-2.5">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-white/20"></span>
                    <Skeleton class="h-3.5 w-full rounded-md bg-white/5" />
                  </div>
                  <div class="flex items-start gap-2.5">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-white/20"></span>
                    <Skeleton class="h-3.5 w-4/5 rounded-md bg-white/5" />
                  </div>
                </div>
              </div>

              <!-- Bottom Actions & Passing Score -->
              <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                <div class="flex flex-wrap items-center gap-3">
                  <Skeleton class="h-10 w-40 rounded-xl border-[1.5px] border-white/10 bg-white/5" />
                  <Skeleton class="h-10 w-32 rounded-xl border-[1.5px] border-white/10 bg-white/5" />
                </div>
                <Skeleton class="h-4 w-48 rounded-md bg-white/5" />
              </div>
            </div>
          </div>
        ))}
      </section>
    </div>
  </div>
)}

{variant === "modelltests" && (
  <div class="relative min-h-dvh py-8">
    <div class="space-y-8">
      <!-- Glass Hero Header -->
      <HeroSkeleton
        variant="glass"
        statsCount={2}
      />

      <div class="mt-8 mb-12 flex justify-center">
        <Skeleton class="h-10 w-48 rounded-full border-[1.5px] border-white/20 bg-white/5" />
      </div>

      <div class="grid gap-12">
        {["Lesen", "Hören", "Schreiben", "Sprechen"].map(() => (
          <section>
            <div class="mbe-6 flex items-center gap-3 tablet:mbe-8 tablet:gap-4">
              <Skeleton class="size-10 shrink-0 rounded-full border-[3px] border-white/10 bg-white/5 tablet:size-12" />
              <Skeleton class="h-7 w-32 rounded-md bg-white/10" />
            </div>
            <div class="grid grid-cols-1 gap-6 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
              {["mt1", "mt2", "mt3"].map(() => (
                <CardSkeleton />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
)}

{variant === "study" && (
  <div class="space-y-12 pbe-20">
    <!-- Compact Hero Header -->
    <HeroSkeleton
      variant="compact"
      statsCount={2}
    />

    <!-- Parts List -->
    <div class="space-y-16">
      {["Part 1", "Part 2"].map(() => (
        <section class="relative space-y-8">
          <!-- Part Header -->
          <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <Skeleton class="h-6 w-16 rounded-lg bg-white/10" />
                <Skeleton class="h-8 w-48 rounded-md bg-white/15" />
              </div>
              <Skeleton class="h-4 w-3/4 rounded-md bg-white/5" />
            </div>
            <Skeleton class="h-9 w-24 rounded-full bg-white/10" />
          </div>

          <!-- Category Separator -->
          <div class="space-y-6">
            <div class="flex items-center gap-6">
              <div class="h-0.75 flex-1 rounded-full bg-white/10" />
              <Skeleton class="h-4 w-32 rounded-md bg-white/10" />
              <div class="h-0.75 flex-1 rounded-full bg-white/10" />
            </div>

            <!-- Checklist Box -->
            <div class="overflow-hidden rounded-2xl border-[1.5px] border-white/10 bg-white/5 backdrop-blur-sm">
              <div class="border-b border-white/10 bg-white/5 px-6 py-3">
                <Skeleton class="h-5 w-44 rounded-md bg-white/10" />
              </div>
              <div class="divide-y divide-white/10">
                {["i1", "i2", "i3"].map(() => (
                  <div class="flex items-center justify-between p-4">
                    <div class="flex items-center gap-3">
                      <Skeleton class="size-6 shrink-0 rounded-full bg-white/10" />
                      <Skeleton class="h-5 w-40 rounded-md bg-white/10" />
                    </div>
                    <Skeleton class="size-4 rounded-md bg-white/5" />
                  </div>
                ))}
              </div>
            </div>

            <!-- Email Visual Frame Skeleton -->
            <div class="mt-8 overflow-hidden rounded-2xl border-[1.5px] border-white/10 bg-zinc-900/50 shadow-2xl backdrop-blur-xl">
              <!-- Browser Header with 3 dots -->
              <div class="flex items-center gap-3 border-b border-white/10 bg-white/5 px-3 py-2.5 mobile:px-4 mobile:py-3">
                <div class="flex shrink-0 gap-1.5">
                  <Skeleton class="size-3 rounded-full bg-white/20" />
                  <Skeleton class="size-3 rounded-full bg-white/20" />
                  <Skeleton class="size-3 rounded-full bg-white/20" />
                </div>
                <div class="flex min-w-0 flex-1 justify-center">
                  <Skeleton class="h-6 w-32 max-w-full rounded-lg bg-white/10 mobile:w-48" />
                </div>
              </div>
              <!-- Email Fields Header -->
              <div class="space-y-3 border-b border-white/10 bg-white/2 px-4 py-2.5 mobile:px-6 mobile:py-3">
                <div class="flex items-center gap-2.5 mobile:gap-3">
                  <Skeleton class="h-4 w-8 shrink-0 rounded-md bg-white/10" />
                  <Skeleton class="h-6 w-24 rounded-full bg-white/10 mobile:w-32" />
                </div>
                <div class="flex items-center gap-2.5 mobile:gap-3">
                  <Skeleton class="h-4 w-14 shrink-0 rounded-md bg-white/10" />
                  <Skeleton class="h-5 w-44 max-w-[calc(100%-4.5rem)] rounded-md bg-white/10 mobile:w-64" />
                </div>
              </div>
              <!-- Email Body Blocks -->
              <div class="space-y-4 p-4 mobile:p-6 tablet:p-8">
                {["s1", "s2", "s3", "s4"].map(() => (
                  <div class="space-y-2 rounded-xl border-[1.5px] border-white/10 bg-white/5 p-3.5 mobile:p-4">
                    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                      <Skeleton class="h-3.5 w-24 rounded-md bg-white/10" />
                      <Skeleton class="h-3.5 w-32 rounded-md bg-white/5" />
                    </div>
                    <Skeleton class="h-5 w-full rounded-md bg-white/5" />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Topics Integration Section -->
    <section class="border-t border-white/10 pt-12">
      <div class="mb-10 space-y-2">
        <Skeleton class="h-8 w-64 rounded-md bg-white/15" />
        <Skeleton class="h-5 w-full max-w-2xl rounded-md bg-white/5" />
      </div>

      <!-- Embedded Themen Navigation Bar -->
      <nav class="mb-8 rounded-2xl border-[1.5px] border-white/5 bg-zinc-950/50 p-4 shadow-xl backdrop-blur-md">
        <div class="mx-auto flex max-w-7xl flex-wrap justify-center gap-2">
          {["n1", "n2", "n3", "n4", "n5", "n6"].map(() => (
            <Skeleton class="h-8 w-24 rounded-full bg-white/10" />
          ))}
        </div>
      </nav>

      <div class="grid grid-cols-1 gap-6 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
        {["tc1", "tc2", "tc3"].map(() => (
          <ThemaCardSkeleton />
        ))}
      </div>
    </section>
  </div>
)}
