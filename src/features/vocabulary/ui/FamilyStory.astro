---
import type { FamilyMember, Word } from "../model/types.ts";

interface Props {
  members: FamilyMember[];
  words: Word[];
}

const { members, words } = Astro.props;
const familyTranslations: Record<string, string> = {
  "die Großmutter": "grandmother", "der Großvater": "grandfather",
  "die Mutter": "mother", "der Vater": "father", "die Tante": "aunt",
  "der Onkel": "uncle", "der Sohn": "son", "der Bruder": "brother",
  "die Schwester": "sister", "der Schwiegersohn": "son-in-law",
  "die Schwiegertochter": "daughter-in-law", "der Schwager": "brother-in-law",
  "die Schwägerin": "sister-in-law", "der Cousin": "male cousin",
  "die Cousine": "female cousin", "der Enkel": "grandson", "die Enkelin": "granddaughter",
};
const examples: Record<string, string> = {
  "die Großmutter": "Meine Großmutter erzählt gern Geschichten.",
  "der Großvater": "Mein Großvater lebt auf dem Land.",
  "die Mutter": "Meine Mutter hat zwei Kinder.",
  "der Vater": "Der Vater zeigt alte Fotos.",
  "die Tante": "Meine Tante besucht uns am Sonntag.",
  "der Onkel": "Mein Onkel wohnt in Hamburg.",
  "der Sohn": "Ihr Sohn ist zwölf Jahre alt.",
  "der Bruder": "Mein Bruder studiert Medizin.",
  "die Schwester": "Meine Schwester ist älter als ich.",
  "der Schwiegersohn": "Der Schwiegersohn hilft beim Kochen.",
  "die Schwiegertochter": "Unsere Schwiegertochter kommt aus Wien.",
  "der Schwager": "Mein Schwager spielt gern Fußball.",
  "die Schwägerin": "Meine Schwägerin spricht drei Sprachen.",
  "der Cousin": "Mein Cousin wohnt in der Nähe.",
  "die Cousine": "Meine Cousine hat zwei Kinder.",
  "der Enkel": "Der Enkel besucht seine Großeltern.",
  "die Enkelin": "Die Enkelin liest ihrer Oma vor.",
};
const glossary = [
  ...members.map((member) => ({
    german: member.german,
    arabic: member.arabic,
    translation: familyTranslations[member.german] ?? "family member",
    explanation: `A family relationship: ${familyTranslations[member.german] ?? "family member"}.`,
    example: examples[member.german] ?? `${member.german} gehört zu meiner Familie.`,
  })),
  ...words.map((word) => ({
    german: word.german,
    arabic: word.arabic,
    translation: word.english ?? "",
    explanation: word.english ? `A word used to talk about family: ${word.english}.` : "A word used to talk about family.",
    example: word.example ?? "",
  })),
];
---

<article class="family-story w-full rounded-2xl" aria-labelledby="story-heading">
  <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-amber-300 uppercase">Eine Familiengeschichte</p>
      <h2 id="story-heading" class="text-2xl font-bold text-white @md:text-3xl">Ein Foto erzählt</h2>
    </div>
    <p class="text-sm text-mist-400">Fahre über die markierten Wörter oder wähle sie mit der Tastatur aus.</p>
  </div>

  <div class="space-y-5 text-base leading-8 text-mist-200 @md:text-lg @md:leading-9">
    <p>
      Am Sonntag besucht Amir seine <span class="story-word" tabindex="0" data-word="die Großmutter">Großmutter</span> und seinen <span class="story-word" tabindex="0" data-word="der Großvater">Großvater</span>. Sie sitzen zusammen und schauen sich ein altes Familienfoto an. „Das sind meine <span class="story-word" tabindex="0" data-word="die Großeltern">Großeltern</span>“, sagt Amir. „Sie sind die <span class="story-word" tabindex="0" data-word="der Vorfahre">Vorfahren</span> unserer Familie.“ Auf dem Foto sieht man auch seine <span class="story-word" tabindex="0" data-word="die Mutter">Mutter</span> und seinen <span class="story-word" tabindex="0" data-word="der Vater">Vater</span>. Zusammen sind sie Amirs <span class="story-word" tabindex="0" data-word="die Eltern">Eltern</span>.
    </p>
    <p>
      Amirs Mutter hat eine Schwester: seine <span class="story-word" tabindex="0" data-word="die Tante">Tante</span>. Der Mann neben ihr ist sein <span class="story-word" tabindex="0" data-word="der Onkel">Onkel</span>. Die beiden sind ein <span class="story-word" tabindex="0" data-word="das Ehepaar">Ehepaar</span>. Amirs Tante ist <span class="story-word" tabindex="0" data-word="verheiratet">verheiratet</span>, aber sein Onkel war früher <span class="story-word" tabindex="0" data-word="geschieden">geschieden</span>. Amirs Cousin ist noch <span class="story-word" tabindex="0" data-word="ledig">ledig</span>, und seine Cousine ist seit Kurzem <span class="story-word" tabindex="0" data-word="verlobt">verlobt</span>.
    </p>
    <p>
      Auf dem Bild steht Amir als kleiner <span class="story-word" tabindex="0" data-word="der Sohn">Sohn</span> neben seinem <span class="story-word" tabindex="0" data-word="der Bruder">Bruder</span> und seiner <span class="story-word" tabindex="0" data-word="die Schwester">Schwester</span>. Heute hat seine Schwester einen Mann, Amirs <span class="story-word" tabindex="0" data-word="der Schwager">Schwager</span>. Amirs Bruder ist mit einer Frau verheiratet; sie ist seine <span class="story-word" tabindex="0" data-word="die Schwägerin">Schwägerin</span>. Der Mann seiner Cousine ist ihr <span class="story-word" tabindex="0" data-word="der Schwiegersohn">Schwiegersohn</span> in der Familie, und die Frau seines Cousins ist die <span class="story-word" tabindex="0" data-word="die Schwiegertochter">Schwiegertochter</span> seiner Tante.
    </p>
    <p>
      Inzwischen hat Amirs Schwester zwei Kinder: einen <span class="story-word" tabindex="0" data-word="der Enkel">Enkel</span> und eine <span class="story-word" tabindex="0" data-word="die Enkelin">Enkelin</span> für die Großeltern. Alle diese Menschen sind <span class="story-word" tabindex="0" data-word="der/die Verwandte">Verwandte</span> und miteinander <span class="story-word" tabindex="0" data-word="verwandt">verwandt</span>. Amirs Nachbar ist dagegen nicht mit ihnen verwandt. Er ist seit einem Jahr <span class="story-word" tabindex="0" data-word="verwitwet">verwitwet</span>. „Eine Familie kann viele Geschichten haben“, sagt Amir. „Und jede Generation gehört zu unserem Stammbaum.“
    </p>
  </div>

  <div class="mt-8 flex items-center gap-2 text-sm text-mist-400">
    <span class="h-0.5 w-6 rounded bg-amber-300"></span>
    Markierte Wörter: Übersetzung, Erklärung und Beispielsatz
  </div>
  <div class="story-tooltip" role="tooltip" hidden></div>
  <script type="application/json" class="story-glossary" set:html={JSON.stringify(glossary)}></script>
</article>

<style>
  .story-word {
    color: #fcd34d;
    text-decoration: underline;
    text-decoration-color: rgb(252 211 77 / 65%);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    cursor: help;
  }
  .story-word:hover,
  .story-word:focus-visible {
    color: #fff;
    text-decoration-thickness: 2px;
    outline: none;
  }
  .story-tooltip {
    position: fixed;
    z-index: 50;
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.9rem 1rem;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 0.85rem;
    background: #171923;
    color: #f4f4f5;
    box-shadow: 0 12px 40px rgb(0 0 0 / 40%);
    font-size: 0.875rem;
    line-height: 1.5;
    pointer-events: none;
  }
  .story-tooltip[hidden] { display: none; }
  .story-tooltip strong { display: block; color: #fcd34d; font-size: 1rem; }
  .story-tooltip .translation { margin-top: 0.2rem; }
  .story-tooltip .arabic { color: #d4d4d8; font-family: var(--font-arabic, sans-serif); }
  .story-tooltip .explanation { margin-top: 0.55rem; color: #d4d4d8; }
  .story-tooltip .example { margin-top: 0.5rem; color: #a1a1aa; font-style: italic; }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".family-story").forEach((story) => {
    const tooltip = story.querySelector<HTMLElement>(".story-tooltip");
    const glossaryNode = story.querySelector<HTMLScriptElement>(".story-glossary");
    if (!tooltip || !glossaryNode) return;

    const entries = new Map<string, { german: string; arabic: string; translation: string; explanation: string; example: string }>(
      (JSON.parse(glossaryNode.textContent ?? "[]") as Array<{ german: string; arabic: string; translation: string; explanation: string; example: string }>).map((entry) => [entry.german, entry]),
    );
    const escape = (value: string) => value.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] ?? char);

    const hide = () => { tooltip.hidden = true; };
    const show = (word: HTMLElement) => {
      const entry = entries.get(word.dataset["word"] ?? "");
      if (!entry) return;
      tooltip.innerHTML = `<strong>${escape(entry.german)}</strong><div class="translation">${escape(entry.translation)}</div><div class="arabic" dir="rtl">${escape(entry.arabic)}</div><div class="explanation">${escape(entry.explanation)}</div><div class="example">${escape(entry.example)}</div>`;
      tooltip.hidden = false;
      const bounds = word.getBoundingClientRect();
      const left = Math.max(16, Math.min(bounds.left, window.innerWidth - tooltip.offsetWidth - 16));
      const top = bounds.bottom + tooltip.offsetHeight + 12 < window.innerHeight ? bounds.bottom + 8 : Math.max(16, bounds.top - tooltip.offsetHeight - 8);
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;
    };

    story.querySelectorAll<HTMLElement>(".story-word").forEach((word) => {
      word.addEventListener("mouseenter", () => show(word));
      word.addEventListener("mouseleave", hide);
      word.addEventListener("focus", () => show(word));
      word.addEventListener("blur", hide);
    });
    window.addEventListener("scroll", hide, { passive: true });
  });
</script>
