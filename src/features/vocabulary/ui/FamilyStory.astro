---
import TextAudioPlayer from "@/shared/ui/TextAudioPlayer.vue";
import type { FamilyMember, Word } from "../model/types.ts";

interface Props {
  members: FamilyMember[];
  words: Word[];
}

const { members, words } = Astro.props;

const familyTranslations: Record<string, string> = {
  "die Großmutter": "grandmother",
  "der Großvater": "grandfather",
  "die Mutter": "mother",
  "der Vater": "father",
  "die Tante": "aunt",
  "der Onkel": "uncle",
  "der Sohn": "son",
  "der Bruder": "brother",
  "die Schwester": "sister",
  "der Schwiegersohn": "son-in-law",
  "die Schwiegertochter": "daughter-in-law",
  "der Schwager": "brother-in-law",
  "die Schwägerin": "sister-in-law",
  "der Cousin": "male cousin",
  "die Cousine": "female cousin",
  "der Enkel": "grandson",
  "die Enkelin": "granddaughter",
};

const examples: Record<string, string> = {
  "die Großmutter": "Meine Großmutter erzählt gern Geschichten.",
  "der Großvater": "Mein Großvater lebt auf dem Land.",
  "die Mutter": "Meine Mutter hat zwei Kinder.",
  "der Vater": "Der Vater zeigt alte Fotos.",
  "die Tante": "Meine Tante besucht uns am Sonntag.",
  "der Onkel": "Mein Onkel wohnt in Hamburg.",
  "der Sohn": "Ihr Sohn ist zwölf Jahre alt.",
  "der Bruder": "Mein Bruder studiert Medizin.",
  "die Schwester": "Meine Schwester ist älter als ich.",
  "der Schwiegersohn": "Der Schwiegersohn hilft beim Kochen.",
  "die Schwiegertochter": "Unsere Schwiegertochter kommt aus Wien.",
  "der Schwager": "Mein Schwager spielt gern Fußball.",
  "die Schwägerin": "Meine Schwägerin spricht drei Sprachen.",
  "der Cousin": "Mein Cousin wohnt in der Nähe.",
  "die Cousine": "Meine Cousine hat zwei Kinder.",
  "der Enkel": "Der Enkel besucht seine Großeltern.",
  "die Enkelin": "Die Enkelin liest ihrer Oma vor.",
};

const glossary = [
  ...members.map((member) => ({
    german: member.german,
    arabic: member.arabic,
    translation: familyTranslations[member.german] ?? "family member",
    explanation: `A family relationship: ${familyTranslations[member.german] ?? "family member"}.`,
    example: examples[member.german] ?? `${member.german} gehört zu meiner Familie.`,
  })),
  ...words.map((word) => ({
    german: word.german,
    arabic: word.arabic,
    translation: word.english ?? "",
    explanation:
      word.english ?
        `A word used to talk about family: ${word.english}.`
      : "A word used to talk about family.",
    example: word.example ?? "",
  })),
];

const storySentences = [
  "Am Sonntag besucht Amir seine Großmutter und seinen Großvater.",
  "Sie sitzen zusammen und schauen sich ein altes Familienfoto an.",
  "„Das sind meine Großeltern“, sagt Amir.",
  "„Sie sind die Vorfahren unserer Familie.“",
  "Auf dem Foto sieht man auch seine Mutter und seinen Vater.",
  "Zusammen sind sie Amirs Eltern.",
  "Amirs Mutter hat eine Schwester: seine Tante.",
  "Der Mann neben ihr ist sein Onkel.",
  "Die beiden sind ein Ehepaar.",
  "Amirs Tante ist verheiratet, aber sein Onkel war früher geschieden.",
  "Amirs Cousin ist noch ledig, und seine Cousine ist seit Kurzem verlobt.",
  "Auf dem Bild steht Amir als kleiner Sohn neben seinem Bruder und seiner Schwester.",
  "Heute hat seine Schwester einen Mann, Amirs Schwager.",
  "Amirs Bruder ist mit einer Frau verheiratet; sie ist seine Schwägerin.",
  "Der Mann seiner Cousine ist ihr Schwiegersohn in der Familie, und die Frau seines Cousins ist die Schwiegertochter seiner Tante.",
  "Inzwischen hat Amirs Schwester zwei Kinder: einen Enkel und eine Enkelin für die Großeltern.",
  "Alle diese Menschen sind Verwandte und miteinander verwandt.",
  "Amirs Nachbar ist dagegen nicht mit ihnen verwandt.",
  "Er ist seit einem Jahr verwitwet.",
  "„Eine Familie kann viele Geschichten haben“, sagt Amir.",
  "„Und jede Generation gehört zu unserem Stammbaum.“",
];
---

<article
  aria-labelledby="story-heading"   class="family-story relative w-full overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card p-4 shadow-2xl backdrop-blur-(--glass-blur) transition-all mobile:p-6 tablet:p-8 [&_.story-word]:cursor-help [&_.story-word]:font-semibold [&_.story-word]:text-amber-300 [&_.story-word]:underline [&_.story-word]:decoration-amber-300/70 [&_.story-word]:decoration-[1.5px] [&_.story-word]:underline-offset-4 [&_.story-word]:transition-colors [&_.story-word]:duration-150 [&_.story-word:hover]:rounded [&_.story-word:hover]:bg-amber-300/25 [&_.story-word:hover]:text-white [&_.story-word:hover]:decoration-2 [&_.story-word:focus-visible]:rounded [&_.story-word:focus-visible]:bg-amber-300/25 [&_.story-word:focus-visible]:text-white [&_.story-word:focus-visible]:decoration-2 [&_.story-word:focus-visible]:outline-none [&_.story-sentence:focus]:outline-none [&_.story-sentence:focus-visible]:outline-none [&_.story-sentence.is-active]:bg-white/15 [&_.story-sentence.is-active]:text-white"
  data-glossary={JSON.stringify(glossary)}
>
  <!-- Header -->
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-amber-300 uppercase">
        Eine Familiengeschichte
      </p>
      <h2
        class="text-2xl font-bold text-white @md:text-3xl"         id="story-heading"
      >
        Ein Foto erzählt
      </h2>
    </div>
    <p class="text-sm text-mist-400">
      Fahre über die markierten Wörter oder wähle sie mit der Tastatur aus.
    </p>
  </div>

  <!-- Story Content with Native Highlightable Words and Read-Along Sentences -->
  <div class="family-story-content space-y-5 text-base leading-8 text-mist-200 @md:text-lg @md:leading-9">
    <p>
      <span
        aria-label="Satz 1 vorlesen"         class="story-sentence inline cursor-pointer rounded-sm px-1 py-0.5 transition-all duration-200 hover:bg-white/8 hover:text-white focus-visible:bg-white/15 focus-visible:text-white"         data-sentence-index="0"         role="button"         tabindex="0"
        title="Klicken zum Vorlesen ab diesem Satz"
      >
        Am Sonntag besucht Amir seine{" "}
        <span
          class="story-word cursor-help font-semibold text-amber-300 underline decoration-amber-300/70 decoration-[1.5px] underline-offset-4 transition-colors duration-150 hover:rounded hover:bg-amber-300/25 hover:text-white hover:decoration-2 focus-visible:rounded focus-visible:bg-amber-300/25 focus-visible:text-white focus-visible:decoration-2 focus-visible:outline-none"
          data-word="die Großmutter"           tabindex="0"
        >
          Großmutter
        </span>{" "}
        und seinen{" "}
        <span
          class="story-word cursor-help font-semibold text-amber-300 underline decoration-amber-300/70 decoration-[1.5px] underline-offset-4 transition-colors duration-150 hover:rounded hover:bg-amber-300/25 hover:text-white hover:decoration-2 focus-visible:rounded focus-visible:bg-amber-300/25 focus-visible:text-white focus-visible:decoration-2 focus-visible:outline-none"
          data-word="der Großvater"           tabindex="0"
        >
          Großvater
        </span>
        .
      </span>
      <span
        aria-label="Satz 2 vorlesen"         class="story-sentence inline cursor-pointer rounded-sm px-1 py-0.5 transition-all duration-200 hover:bg-white/8 hover:text-white"         data-sentence-index="1"         role="button"         tabindex="0"
        title="Klicken zum Vorlesen ab diesem Satz"
      >
        Sie sitzen zusammen und schauen sich ein altes Familienfoto an.
      </span>
      <span
        aria-label="Satz 3 vorlesen"         class="story-sentence inline cursor-pointer rounded-sm px-1 py-0.5 transition-all duration-200 hover:bg-white/8 hover:text-white"         data-sentence-index="2"         role="button"         tabindex="0"
        title="Klicken zum Vorlesen ab diesem Satz"
      >
        „Das sind meine{" "}
        <span
          class="story-word"
          data-word="die Großeltern"           tabindex="0"
        >
          Großeltern
        </span>
