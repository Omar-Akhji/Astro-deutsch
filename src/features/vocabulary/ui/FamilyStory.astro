  <div class="mt-8">
    <TextAudioPlayer
      client:load
      sentences={storySentences}
      subtitle="Höre dir die Geschichte Satz für Satz an oder klicke auf einen Satz im Text"       targetSelector=".family-story-content"       title="Audio-Begleiter"
    />
  </div>

  <!-- Footer Help Tip & Legend -->
  <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-white/8 pt-5 text-sm text-mist-400">
    <div class="flex items-center gap-2">
      <span class="h-0.5 w-6 rounded bg-amber-300"></span>
      <span>Markierte Wörter: Übersetzung, Erklärung und Beispielsatz (Hover / Tastatur)</span>
    </div>
    <div class="text-xs text-mist-500">
      Tipp: Du kannst jeden Satz anklicken, um direkt ab dort zu hören.
    </div>
  </div>

  <!-- Tooltip Modal for Word Explanations -->
  <div
    class="story-tooltip fixed top-(--tooltip-top) left-(--tooltip-left) z-9999 w-[min(22rem,calc(100vw-2rem))] rounded-[0.85rem] border border-white/20 bg-[#171923] px-4 py-[0.9rem] text-sm leading-normal text-zinc-100 shadow-[0_16px_48px_rgba(0,0,0,0.6),0_0_0_1px_rgba(252,211,77,0.15)] pointer-events-none backdrop-blur-xl"
    hidden     role="tooltip"
  >
    <strong class="mb-1 block text-[1.05rem] text-amber-300" data-tooltip-german></strong>
