    <div class="mt-1 font-arabic text-[1.1rem] text-yellow-200" data-tooltip-arabic dir="rtl"></div>
    <div class="mt-2 border-t border-white/10 pt-2 text-zinc-300" data-tooltip-explanation></div>
    <div class="mt-2 rounded-md bg-white/5 px-2 py-1.5 text-zinc-400 italic" data-tooltip-example hidden></div>
  </div>
</article>

<script src="../lib/family-story.ts"></script>
