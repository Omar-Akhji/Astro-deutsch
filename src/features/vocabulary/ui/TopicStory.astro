---
import TextAudioPlayer from "@/shared/ui/TextAudioPlayer.vue";
import {
  cleanTextForSpeech,
  getTopicStory,
  parseSentenceTokens,
} from "../data/topic-stories.ts";
import type { FamilyMember, Topic, Word } from "../model/types.ts";

interface Props {
  topic: Topic;
  categoryTitle?: string | undefined;
  words?: Word[] | undefined;
  familyTree?: FamilyMember[] | undefined;
}

const {
  topic,
  categoryTitle,
  words = topic.words ?? [],
  familyTree = topic.familyTree,
} = Astro.props;

const story = topic.story ?? getTopicStory(topic.id, topic, categoryTitle);

const familyTranslations: Record<string, string> = {
  "die Großmutter": "grandmother",
  "der Großvater": "grandfather",
  "die Mutter": "mother",
  "der Vater": "father",
  "die Tante": "aunt",
  "der Onkel": "uncle",
  "der Sohn": "son",
  "der Bruder": "brother",
  "die Schwester": "sister",
  "der Schwiegersohn": "son-in-law",
  "die Schwiegertochter": "daughter-in-law",
  "der Schwager": "brother-in-law",
  "die Schwägerin": "sister-in-law",
  "der Cousin": "male cousin",
  "die Cousine": "female cousin",
  "der Enkel": "grandson",
  "die Enkelin": "granddaughter",
};

const familyExamples: Record<string, string> = {
  "die Großmutter": "Meine Großmutter erzählt gern Geschichten.",
  "der Großvater": "Mein Großvater lebt auf dem Land.",
  "die Mutter": "Meine Mutter hat zwei Kinder.",
  "der Vater": "Der Vater zeigt alte Fotos.",
  "die Tante": "Meine Tante besucht uns am Sonntag.",
  "der Onkel": "Mein Onkel wohnt in Hamburg.",
  "der Sohn": "Ihr Sohn ist zwölf Jahre alt.",
  "der Bruder": "Mein Bruder studiert Medizin.",
  "die Schwester": "Meine Schwester ist älter als ich.",
  "der Schwiegersohn": "Der Schwiegersohn hilft beim Kochen.",
  "die Schwiegertochter": "Unsere Schwiegertochter kommt aus Wien.",
  "der Schwager": "Mein Schwager spielt gern Fußball.",
  "die Schwägerin": "Meine Schwägerin spricht drei Sprachen.",
  "der Cousin": "Mein Cousin wohnt in der Nähe.",
  "die Cousine": "Meine Cousine hat zwei Kinder.",
  "der Enkel": "Der Enkel besucht seine Großeltern.",
  "die Enkelin": "Die Enkelin liest ihrer Oma vor.",
};

const safeWords: Word[] = words ?? [];
const safeMembers: FamilyMember[] = familyTree ?? [];

const glossary = [
  ...safeMembers.map((member: FamilyMember) => ({
    german: member.german,
    arabic: member.arabic,
    translation: familyTranslations[member.german] ?? "family member",
    explanation: `Familienbeziehung: ${familyTranslations[member.german] ?? member.german}.`,
    example: familyExamples[member.german] ?? `${member.german} gehört zu unserer Familie.`,
  })),
  ...safeWords.map((word: Word) => ({
    german: word.german,
    arabic: word.arabic,
    translation: word.english ?? "",
    explanation: word.english ? `Wortschatz-Bedeutung: ${word.english}.` : "Wichtiger Begriff zum Thema.",
    example: word.example ?? "",
  })),
];

// Build plain audio speech sentences and structured display tokens
const storySentences: string[] = [];
let runningSentenceIndex = 0;

const preparedParagraphs = story.paragraphs.map((paragraph) => {
  return paragraph.map((sentence) => {
    const plain = cleanTextForSpeech(sentence);
    storySentences.push(plain);
    const index = runningSentenceIndex;
    runningSentenceIndex += 1;
    return {
      index,
      tokens: parseSentenceTokens(sentence),
    };
  });
});
---

<article
  class="topic-story relative w-full overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card p-4 shadow-2xl backdrop-blur-(--glass-blur) transition-all mobile:p-6 tablet:p-8"
  aria-labelledby="topic-story-heading"
  data-glossary={JSON.stringify(glossary)}
>
  <!-- Header -->
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-amber-300 uppercase">
        {story.badge}
      </p>
      <h2 id="topic-story-heading" class="text-2xl font-bold text-white @md:text-3xl">
        {story.title}
      </h2>
    </div>
    <p class="text-sm text-mist-400">
      {story.intro ?? "Fahre über die markierten Wörter oder wähle sie mit der Tastatur aus."}
    </p>
  </div>

  <!-- Story Content with Native Highlightable Words and Read-Along Sentences -->
  <div class="topic-story-content space-y-5 text-base leading-8 text-mist-200 @md:text-lg @md:leading-9">
    {preparedParagraphs.map((paragraph) => (
      <p>
        {paragraph.map((sentence) => (
          <span
            class="story-sentence inline cursor-pointer rounded-sm px-1 py-0.5 transition-all duration-200 hover:bg-white/8 hover:text-white"
            data-sentence-index={sentence.index}
            tabindex="0"
            role="button"
            aria-label={`Satz ${sentence.index + 1} vorlesen`}
            title="Klicken zum Vorlesen ab diesem Satz"
          >
            {sentence.tokens.map((token) =>
              token.type === "word" ? (
                <span class="story-word" tabindex="0" data-word={token.baseWord}>
                  {token.display}
                </span>
              ) : (
                token.content
              )
            )}
          </span>
        ))}
      </p>
    ))}
  </div>

  <!-- Reusable Audio Player Component Island (Below Story Text) -->
  <div class="mt-8">
    <TextAudioPlayer
      client:load
      sentences={storySentences}
      targetSelector=".topic-story-content"
      title="Audio-Begleiter"
      subtitle="Höre dir die Geschichte Satz für Satz an oder klicke auf einen Satz im Text"
    />
  </div>

  <!-- Footer Help Tip & Legend -->
  <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-white/8 pt-5 text-sm text-mist-400">
    <div class="flex items-center gap-2">
      <span class="h-0.5 w-6 rounded bg-amber-300"></span>
      <span>Markierte Wörter: Übersetzung, Erklärung und Beispielsatz (Hover / Tastatur)</span>
    </div>
    <div class="text-xs text-mist-500">
      Tipp: Du kannst jeden Satz anklicken, um direkt ab dort zu hören.
    </div>
  </div>

  <!-- Tooltip Modal for Word Explanations -->
  <div class="story-tooltip" role="tooltip" hidden></div>
</article>

<script src="../lib/family-story.ts"></script>

<style>
  /* Word glossary styling */
  .story-word {
    color: #fcd34d;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(252 211 77 / 70%);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    cursor: help;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .story-word:hover,
  .story-word:focus-visible {
    color: #ffffff;
    background-color: rgb(252 211 77 / 25%);
    border-radius: 0.25rem;
    text-decoration-thickness: 2px;
    outline: none;
  }

  /* Sentence Read-Along styling */
  .story-sentence {
    position: relative;
    border-radius: 0.375rem;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  :global(.story-sentence.is-active) {
    background-color: rgb(255 255 255 / 15%);
    color: #ffffff;
  }

  /* Tooltip box styling */
  .story-tooltip {
    position: fixed;
    z-index: 9999;
    width: min(22rem, calc(100vw - 2rem));
    padding: 0.9rem 1rem;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 0.85rem;
    background: #171923;
    color: #f4f4f5;
    box-shadow: 0 16px 48px rgb(0 0 0 / 60%), 0 0 0 1px rgb(252 211 77 / 15%);
    font-size: 0.875rem;
    line-height: 1.5;
    pointer-events: none;
    backdrop-filter: blur(12px);
  }
  .story-tooltip[hidden] {
    display: none;
  }
  :global(.story-tooltip strong) {
    display: block;
    color: #fcd34d;
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }
  :global(.story-tooltip .translation) {
    color: #e4e4e7;
    font-weight: 500;
    font-size: 0.9rem;
  }
  :global(.story-tooltip .arabic) {
    color: #fef08a;
    font-family: var(--font-arabic, sans-serif);
    font-size: 1.1rem;
    margin-top: 0.2rem;
  }
  :global(.story-tooltip .explanation) {
    margin-top: 0.55rem;
    color: #d4d4d8;
    border-top: 1px solid rgb(255 255 255 / 10%);
    padding-top: 0.4rem;
  }
  :global(.story-tooltip .example) {
    margin-top: 0.45rem;
    color: #a1a1aa;
    font-style: italic;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.5rem;
    border-radius: 0.375rem;
  }
</style>
