---
import TextAudioPlayer from "@/shared/ui/TextAudioPlayer.vue";
import {
  cleanTextForSpeech,
  getTopicStories,
  getTopicStory,
  parseSentenceTokens,
} from "../data/topic-stories.ts";
import type { CefrLevel, FamilyMember, Topic, Word } from "../model/types.ts";

interface Props {
  topic: Topic;
  categoryTitle?: string | undefined;
  words?: Word[] | undefined;
  familyTree?: FamilyMember[] | undefined;
}

const {
  topic,
  categoryTitle,
  words = topic.words ?? [],
  familyTree = topic.familyTree,
} = Astro.props;

const storiesRecord = topic.stories ?? getTopicStories(topic.id, topic, categoryTitle);
const levels: CefrLevel[] = ["A1", "A2", "B1", "B2"];

const levelConfigs: Record<CefrLevel, { pillClass: string; levelName: string }> = {
  A1: {
    pillClass: "border-emerald-400/30 bg-emerald-500/10 text-emerald-300",
    levelName: "Grundstufe",
  },
  A2: { pillClass: "border-sky-400/30 bg-sky-500/10 text-sky-300", levelName: "Alltag & Praxis" },
  B1: {
    pillClass: "border-amber-400/30 bg-amber-500/10 text-amber-300",
    levelName: "Selbstständige Sprachanwendung",
  },
  B2: {
    pillClass: "border-purple-400/30 bg-purple-500/10 text-purple-300",
    levelName: "Differenziert & Komplex",
  },
};

const familyTranslations: Record<string, string> = {
  "die Großmutter": "grandmother",
  "der Großvater": "grandfather",
  "die Mutter": "mother",
  "der Vater": "father",
  "die Tante": "aunt",
  "der Onkel": "uncle",
  "der Sohn": "son",
  "der Bruder": "brother",
  "die Schwester": "sister",
  "der Schwiegersohn": "son-in-law",
  "die Schwiegertochter": "daughter-in-law",
  "der Schwager": "brother-in-law",
  "die Schwägerin": "sister-in-law",
  "der Cousin": "male cousin",
  "die Cousine": "female cousin",
  "der Enkel": "grandson",
  "die Enkelin": "granddaughter",
};

const familyExamples: Record<string, string> = {
  "die Großmutter": "Meine Großmutter erzählt gern Geschichten.",
  "der Großvater": "Mein Großvater lebt auf dem Land.",
  "die Mutter": "Meine Mutter hat zwei Kinder.",
  "der Vater": "Der Vater zeigt alte Fotos.",
  "die Tante": "Meine Tante besucht uns am Sonntag.",
  "der Onkel": "Mein Onkel wohnt in Hamburg.",
  "der Sohn": "Ihr Sohn ist zwölf Jahre alt.",
  "der Bruder": "Mein Bruder studiert Medizin.",
  "die Schwester": "Meine Schwester ist älter als ich.",
  "der Schwiegersohn": "Der Schwiegersohn hilft beim Kochen.",
  "die Schwiegertochter": "Unsere Schwiegertochter kommt aus Wien.",
  "der Schwager": "Mein Schwager spielt gern Fußball.",
  "die Schwägerin": "Meine Schwägerin spricht drei Sprachen.",
  "der Cousin": "Mein Cousin wohnt in der Nähe.",
  "die Cousine": "Meine Cousine hat zwei Kinder.",
  "der Enkel": "Der Enkel besucht seine Großeltern.",
  "die Enkelin": "Die Enkelin liest ihrer Oma vor.",
};

const safeWords: Word[] = words ?? [];
const safeMembers: FamilyMember[] = familyTree ?? [];

const glossary = [
  ...safeMembers.map((member: FamilyMember) => ({
    german: member.german,
    arabic: member.arabic,
    translation: familyTranslations[member.german] ?? "family member",
    explanation: `Familienbeziehung: ${familyTranslations[member.german] ?? member.german}.`,
    example: familyExamples[member.german] ?? `${member.german} gehört zu unserer Familie.`,
  })),
  ...safeWords.map((word: Word) => ({
    german: word.german,
    arabic: word.arabic,
    translation: word.english ?? "",
    explanation:
      word.english ? `Wortschatz-Bedeutung: ${word.english}.` : "Wichtiger Begriff zum Thema.",
    example: word.example ?? "",
  })),
];

const preparedLevels = levels.map((lvl) => {
  const lvlStory =
    storiesRecord[lvl] ?? topic.story ?? getTopicStory(topic.id, topic, categoryTitle, lvl);
  const sentences: string[] = [];
  let runningSentenceIndex = 0;

  const preparedParagraphs = lvlStory.paragraphs.map((paragraph) => {
    return paragraph.map((sentence) => {
      const plain = cleanTextForSpeech(sentence);
      sentences.push(plain);
      const sIndex = runningSentenceIndex;
      runningSentenceIndex += 1;
      return { index: sIndex, tokens: parseSentenceTokens(sentence) };
    });
  });

  return {
    level: lvl,
    story: lvlStory,
    sentences,
    sentenceCount: sentences.length,
    preparedParagraphs,
    pillClass: levelConfigs[lvl].pillClass,
    levelName: levelConfigs[lvl].levelName,
  };
});
---

<div
  class="topic-story topic-stories-suite space-y-4"
  data-glossary={JSON.stringify(glossary)}
>
  <!-- Section Title -->
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3 px-1">
    <div>
      <p class="text-xs font-semibold tracking-[0.18em] text-amber-300 uppercase">
        Texte nach Sprachniveau (GER / CEFR)
      </p>
    </div>
    <p class="text-xs text-mist-400">
      4 Niveaustufen (A1, A2, B1, B2) zum systematischen Lernen, Lesen & Mitlesen
    </p>
  </div>

  <!-- 4 Stacked CEFR Level Cards (Static boxes, no collapsing or size changes on activation) -->
  <div class="space-y-6">
    {preparedLevels.map((item) => (
      <article class="topic-level-card overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card p-5 shadow-xl backdrop-blur-(--glass-blur) transition-all duration-300 hover:border-white/15 tablet:p-7">
        <header class="mb-5 border-b border-white/8 pb-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <span
                class:list={[
                  "rounded-full border-[1.5px] px-3 py-1 text-xs font-bold tracking-wide",
                  item.pillClass,
                ]}
              >
                {item.level}
              </span>
              <span class="text-xs font-medium text-mist-400">
                {item.levelName}
              </span>
            </div>

            <span class="rounded-full border-[1.5px] border-white/8 bg-white/5 px-2.5 py-0.5 text-xs font-medium text-mist-400">
              {item.sentenceCount} Sätze
            </span>
          </div>

          <h3 class="mt-3.5 text-xl font-bold text-white tablet:text-2xl">{item.story.title}</h3>

          <p class="mt-2 text-sm text-mist-400">
            {item.story.intro
              ?? "Fahre über die markierten Wörter oder klicke auf einen Satz zum Vorlesen."}
          </p>
        </header>

        <!-- Story Content with Native Highlightable Words and Read-Along Sentences -->
        <div
          id={`story-content-${item.level.toLowerCase()}-${topic.id}`}
          class="topic-story-content space-y-4 text-base leading-8 text-mist-200 tablet:text-lg tablet:leading-9"
        >
          {item.preparedParagraphs.map((paragraph) => (
            <p>
              {paragraph.map((sentence) => (
                <span
                  class="story-sentence inline cursor-pointer rounded-sm px-1 py-0.5 transition-all duration-200 hover:bg-white/8 hover:text-white"
                  data-sentence-index={sentence.index}
                  tabindex="0"
                  role="button"
                  aria-label={`Satz ${sentence.index + 1} vorlesen`}
                  title="Klicken zum Vorlesen ab diesem Satz"
                >
                  {sentence.tokens.map((token) =>
                    token.type === "word" ?
                      <span
                        class="story-word"
                        tabindex="0"
                        data-word={token.baseWord}
                      >
                        {token.display}
                      </span>
                    : token.content,
                  )}
                </span>
              ))}
            </p>
          ))}
        </div>

        <!-- Audio Player Component Island for this level -->
        <div class="mt-6">
          <TextAudioPlayer
            client:load
            sentences={item.sentences}
            targetSelector={`#story-content-${item.level.toLowerCase()}-${topic.id}`}
            title={`Audio-Begleiter (${item.level})`}
            subtitle={`Höre dir den ${item.level}-Text Satz für Satz an oder klicke auf einen Satz`}
          />
        </div>
      </article>
    ))}
  </div>

  <!-- Footer Help Tip & Legend -->
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-white/8 px-1 pt-5 text-sm text-mist-400">
    <div class="flex items-center gap-2">
      <span class="h-0.5 w-6 rounded bg-amber-300"></span>
      <span>Markierte Wörter: Übersetzung, Erklärung und Beispielsatz (Hover / Tastatur)</span>
    </div>
    <div class="text-xs text-mist-500">
      Tipp: Du kannst jeden Satz anklicken, um direkt ab dort zu hören.
    </div>
  </div>

  <!-- Tooltip Modal for Word Explanations -->
  <div
    class="story-tooltip"
    role="tooltip"
    hidden
  ></div>
</div>

<script src="../lib/family-story.ts"></script>

<style>
  /* Word glossary styling */
  .story-word {
    color: #fcd34d;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(252 211 77 / 70%);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    cursor: help;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .story-word:hover,
  .story-word:focus-visible {
    color: #ffffff;
    background-color: rgb(252 211 77 / 25%);
    border-radius: 0.25rem;
    text-decoration-thickness: 2px;
    outline: none;
  }

  /* Sentence Read-Along styling: NO line, ONLY clean gray background */
  .story-sentence {
    position: relative;
    border-radius: 0.375rem;
    outline: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .story-sentence:focus,
  .story-sentence:focus-visible {
    outline: none;
  }
  :global(.story-sentence.is-active) {
    background-color: rgb(255 255 255 / 15%);
    color: #ffffff;
  }

  /* Tooltip box styling */
  .story-tooltip {
    position: fixed;
    z-index: 9999;
    width: min(22rem, calc(100vw - 2rem));
    padding: 0.9rem 1rem;
    border: 1.5px solid rgb(255 255 255 / 20%);
    border-radius: 0.85rem;
    background: #171923;
    color: #f4f4f5;
    box-shadow:
      0 16px 48px rgb(0 0 0 / 60%),
      0 0 0 1px rgb(252 211 77 / 15%);
    font-size: 0.875rem;
    line-height: 1.5;
    pointer-events: none;
    backdrop-filter: blur(12px);
  }
  .story-tooltip[hidden] {
    display: none;
  }
  :global(.story-tooltip strong) {
    display: block;
    color: #fcd34d;
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }
  :global(.story-tooltip .translation) {
    color: #e4e4e7;
    font-weight: 500;
    font-size: 0.9rem;
  }
  :global(.story-tooltip .arabic) {
    color: #fef08a;
    font-family: var(--font-arabic, sans-serif);
    font-size: 1.1rem;
    margin-top: 0.2rem;
  }
  :global(.story-tooltip .explanation) {
    margin-top: 0.55rem;
    color: #d4d4d8;
    border-top: 1px solid rgb(255 255 255 / 10%);
    padding-top: 0.4rem;
  }
  :global(.story-tooltip .example) {
    margin-top: 0.45rem;
    color: #a1a1aa;
    font-style: italic;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.5rem;
    border-radius: 0.375rem;
  }
</style>
