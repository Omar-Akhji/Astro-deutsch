---
import Skeleton from "@/shared/ui/Skeleton.astro";

interface Props {
  variant?: "overview" | "level" | "detail" | "family-tree";
}

const { variant = "overview" } = Astro.props;
---

{variant === "overview" && (
  <div class="animate-fade-in">
    <header class="mb-10 text-center tablet:mb-12 laptop:mb-14">
      <div class="mb-3 flex flex-col items-center justify-center gap-3 tablet:flex-row tablet:gap-4">
        <Skeleton class="size-12 shrink-0 rounded-full border-[3px] border-white/10 bg-white/5 tablet:size-14" />
        <Skeleton class="h-9 w-64 rounded-md bg-white/15 tablet:h-10 tablet:w-80" />
      </div>
      <div class="mx-auto mb-5 h-1 w-24 overflow-hidden rounded-full bg-white/10" />
      <div class="flex justify-center px-2">
        <Skeleton class="h-9 min-[480px]:h-8 tablet:h-10 w-full max-w-[320px] min-[480px]:max-w-2xl rounded-2xl min-[480px]:rounded-full border-2 border-white/10 bg-white/5" />
      </div>
    </header>

    <section class="py-4">
      <div class="grid grid-cols-1 gap-6 py-4 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
        {["v1", "v2", "v3", "v4", "v5", "v6"].map(() => (
          <div class="h-full">
            <div class="relative z-1 flex h-full w-full flex-col overflow-hidden rounded-3xl border-2 border-white/10 bg-card/75 p-4 text-left shadow-xl backdrop-blur-(--glass-blur) tablet:p-5">
              <div class="aspect-video w-full overflow-hidden rounded-2xl">
                <Skeleton class="h-full w-full rounded-2xl bg-white/5" />
              </div>
              <div class="flex flex-1 flex-col px-1 pt-4 pb-1">
                <div class="mbe-2.5 flex items-center gap-2">
                  <Skeleton class="h-6 w-16 rounded-full bg-white/10" />
                  <Skeleton class="h-4 w-20 rounded-full bg-white/5" />
                </div>
                <Skeleton class="mb-2 h-7 w-3/4 rounded-md bg-white/10" />
                <Skeleton class="mbe-1 h-4 w-full rounded-md bg-white/5" />
                <Skeleton class="mbe-4 h-4 w-2/3 rounded-md bg-white/5" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
)}

{variant === "level" && (
  <div class="relative min-h-dvh py-6 tablet:py-10">
    <main>
      <!-- Hero section (compact variant) -->
      <div class="relative overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card p-4 shadow-2xl backdrop-blur-(--glass-blur) mbe-6 mobile:p-6 tablet:p-8">
        <div class="flex flex-col items-center text-center">
          <div class="mbe-4 flex flex-wrap items-center justify-center gap-3">
            <Skeleton class="h-7 w-28 rounded-full bg-white/10" />
          </div>
          <Skeleton class="mx-auto mbe-4 h-9 mobile:h-10 tablet:h-12 laptop:h-14 w-3/4 max-w-2xl rounded-md bg-white/15" />
          <Skeleton class="mx-auto h-6 w-full max-w-xl rounded-md bg-white/5 tablet:w-2/3" />
          <div class="mbs-8 flex flex-wrap justify-center gap-4 mobile:gap-6 tablet:gap-8">
            <div class="flex items-center gap-2">
              <Skeleton class="size-5 shrink-0 rounded-full bg-white/10 tablet:size-6" />
              <Skeleton class="h-5 w-24 rounded-md bg-white/10 tablet:h-6 tablet:w-28" />
            </div>
            <div class="flex items-center gap-2">
              <Skeleton class="size-5 shrink-0 rounded-full bg-white/10 tablet:size-6" />
              <Skeleton class="h-5 w-20 rounded-md bg-white/10 tablet:h-6 tablet:w-24" />
            </div>
          </div>
        </div>
      </div>

      <!-- Sections with headers and cards -->
      <div class="grid gap-12">
        {["sec1", "sec2"].map(() => (
          <section>
            <div class="mb-6 flex flex-col items-start gap-4 rounded-2xl bg-white/10 p-5 md:flex-row md:items-center md:justify-between tablet:mb-7 tablet:p-6">
              <Skeleton class="h-7 w-48 rounded-md bg-white/15" />
              <Skeleton class="h-6 w-24 rounded-full bg-white/20" />
            </div>
            <div class="grid gap-4 tablet:gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {["c1", "c2", "c3"].map(() => (
                <div class="rounded-2xl border-2 border-(--glass-border) bg-card/75 p-4 shadow-sm backdrop-blur-(--glass-blur) tablet:p-5">
                  <Skeleton class="mb-2 h-6 w-3/4 rounded-md bg-white/10" />
                  <div class="flex items-center gap-2 text-sm">
                    <Skeleton class="size-3.5 rounded-full bg-white/10" />
                    <Skeleton class="h-4 w-28 rounded-md bg-white/5" />
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </main>
  </div>
)}

{variant === "detail" && (
  <div class="relative min-h-dvh py-8">
    <main>
      <!-- Hero section (compact variant) -->
      <div class="relative overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card p-4 shadow-2xl backdrop-blur-(--glass-blur) mbe-6 mobile:p-6 tablet:p-8">
        <div class="flex flex-col items-center text-center">
          <div class="mbe-4 flex flex-wrap items-center justify-center gap-3">
            <Skeleton class="h-7 w-24 rounded-full bg-white/10" />
          </div>
          <Skeleton class="mx-auto mbe-4 h-9 mobile:h-10 tablet:h-12 laptop:h-14 w-3/4 max-w-2xl rounded-md bg-white/15" />
          <Skeleton class="mx-auto h-6 w-full max-w-xl rounded-md bg-white/5 tablet:w-2/3" />
        </div>
      </div>

      <!-- Vocabulary Table Skeleton -->
      <section class="mt-8">
        <div class="overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card shadow-sm backdrop-blur-(--glass-blur)">
          <div class="scrollbar-thin overflow-x-auto px-4 pb-4">
            <div class="w-full">
              <div class="flex border-b border-(--glass-border) px-3 pbs-3 text-xs uppercase @md:px-4 @md:pbs-4 @md:text-sm">
                <Skeleton class="h-4 flex-1 rounded-md bg-white/10" />
                <Skeleton class="ml-4 h-4 flex-1 rounded-md bg-white/10" />
                <Skeleton class="ml-4 h-4 flex-1 rounded-md bg-white/10" />
              </div>
              {["r1", "r2", "r3", "r4", "r5", "r6"].map(() => (
                <div class="flex items-center border-b border-white/5 px-3 py-3 @md:px-4 @md:py-3.5">
                  <div class="flex flex-1 items-center gap-2.5">
                    <Skeleton class="size-7 shrink-0 rounded-lg bg-white/10" />
                    <Skeleton class="h-5 w-24 rounded-md bg-white/10" />
                  </div>
                  <Skeleton class="ml-4 h-5 flex-1 rounded-md bg-white/5" />
                  <Skeleton class="ml-4 h-5 flex-1 rounded-md bg-white/5" />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
)}

{variant === "family-tree" && (
  <div class="relative min-h-dvh py-8">
    <main>
      <!-- Hero section (compact variant) -->
      <div class="relative overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card p-4 shadow-2xl backdrop-blur-(--glass-blur) mbe-6 mobile:p-6 tablet:p-8">
        <div class="flex flex-col items-center text-center">
          <div class="mbe-4 flex flex-wrap items-center justify-center gap-3">
            <Skeleton class="h-7 w-24 rounded-full bg-white/10" />
          </div>
          <Skeleton class="mx-auto mbe-4 h-9 mobile:h-10 tablet:h-12 laptop:h-14 w-3/4 max-w-2xl rounded-md bg-white/15" />
          <Skeleton class="mx-auto h-6 w-full max-w-xl rounded-md bg-white/5 tablet:w-2/3" />
        </div>
      </div>

      <!-- Family Tree GlassCard -->
      <section class="mt-8">
        <div class="flex flex-col items-center gap-4 overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card p-8 shadow-sm backdrop-blur-(--glass-blur)">
          <!-- Generation 1 -->
          <div class="flex flex-col items-center gap-3">
            <Skeleton class="h-4 w-28 rounded-md bg-white/10" />
            <div class="flex items-center gap-2">
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/10 bg-white/5 @md:h-28 @md:w-36" />
              <Skeleton class="size-4 rounded-full bg-white/10" />
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/10 bg-white/5 @md:h-28 @md:w-36" />
            </div>
          </div>
          <div class="h-10 w-px bg-white/10" />

          <!-- Generation 2 -->
          <div class="flex flex-col items-center gap-3">
            <Skeleton class="h-4 w-24 rounded-md bg-white/10" />
            <div class="flex items-center gap-2">
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/10 bg-white/5 @md:h-28 @md:w-36" />
              <Skeleton class="size-4 rounded-full bg-white/10" />
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/10 bg-white/5 @md:h-28 @md:w-36" />
            </div>
          </div>
          <div class="h-10 w-px bg-white/10" />

          <!-- Generation 3 -->
          <div class="flex flex-col items-center gap-3">
            <Skeleton class="h-4 w-24 rounded-md bg-white/10" />
            <div class="flex items-center gap-2">
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/20 bg-white/10 @md:h-28 @md:w-36" />
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/20 bg-white/10 @md:h-28 @md:w-36" />
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/10 bg-white/5 @md:h-28 @md:w-36" />
            </div>
          </div>
          <div class="h-10 w-px bg-white/10" />

          <!-- Generation 4 -->
          <div class="flex flex-col items-center gap-3">
            <Skeleton class="h-4 w-24 rounded-md bg-white/10" />
            <div class="flex items-center gap-2">
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/10 bg-white/5 @md:h-28 @md:w-36" />
              <Skeleton class="h-24 w-28 rounded-xl border-2 border-white/10 bg-white/5 @md:h-28 @md:w-36" />
            </div>
          </div>
        </div>
      </section>

      <!-- Vocabulary Table Below Family Tree -->
      <section class="mt-8">
        <div class="overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card shadow-sm backdrop-blur-(--glass-blur)">
          <div class="scrollbar-thin overflow-x-auto px-4 pb-4">
            <div class="w-full">
              <div class="flex border-b border-(--glass-border) px-3 pbs-3 text-xs uppercase @md:px-4 @md:pbs-4 @md:text-sm">
                <Skeleton class="h-4 flex-1 rounded-md bg-white/10" />
                <Skeleton class="ml-4 h-4 flex-1 rounded-md bg-white/10" />
                <Skeleton class="ml-4 h-4 flex-1 rounded-md bg-white/10" />
              </div>
              {["r1", "r2", "r3", "r4", "r5"].map(() => (
                <div class="flex items-center border-b border-white/5 px-3 py-3 @md:px-4 @md:py-3.5">
                  <div class="flex flex-1 items-center gap-2.5">
                    <Skeleton class="size-7 shrink-0 rounded-lg bg-white/10" />
                    <Skeleton class="h-5 w-24 rounded-md bg-white/10" />
                  </div>
                  <Skeleton class="ml-4 h-5 flex-1 rounded-md bg-white/5" />
                  <Skeleton class="ml-4 h-5 flex-1 rounded-md bg-white/5" />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
)}
