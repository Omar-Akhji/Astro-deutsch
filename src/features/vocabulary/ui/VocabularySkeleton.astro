---
import CardSkeleton from "@/shared/ui/CardSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/PageHeaderSkeleton.astro";
import Skeleton from "@/shared/ui/Skeleton.astro";
import { HeroSkeleton } from "@/widgets/hero";
import TopicStorySkeleton from "./TopicStorySkeleton.astro";
import VocabularyTableSkeleton from "./VocabularyTableSkeleton.astro";

interface Props {
  variant?: "overview" | "level" | "detail" | "family-tree";
}

const { variant = "overview" } = Astro.props;
---

{variant === "overview" && (
  <div class="animate-fade-in py-4 mobile:py-8">
    <PageHeaderSkeleton />

    <section class="py-4">
      <div class="grid grid-cols-1 gap-6 py-4 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
        {["v1", "v2", "v3", "v4", "v5", "v6"].map(() => (
          <CardSkeleton />
        ))}
      </div>
    </section>
  </div>
)}

{variant === "level" && (
  <div class="relative min-h-dvh py-6 tablet:py-10">
    <div class="space-y-10 tablet:space-y-12">
      <!-- Compact Hero header -->
      <HeroSkeleton variant="compact" statsCount={2} />

      <!-- Sections with headers and cards -->
      <div class="grid gap-10 tablet:gap-12">
        {["sec1", "sec2"].map(() => (
          <section>
            <div class="mb-6 flex flex-col items-start gap-4 rounded-2xl bg-white/10 p-5 md:flex-row md:items-center md:justify-between tablet:mb-7 tablet:p-6">
              <Skeleton class="h-7 w-48 rounded-md bg-white/15" />
              <Skeleton class="h-6 w-24 rounded-full bg-white/20" />
            </div>
            <div class="grid gap-4 sm:grid-cols-2 tablet:gap-5 lg:grid-cols-3">
              {["c1", "c2", "c3"].map(() => (
                <div class="rounded-2xl border-2 border-(--glass-border) bg-card/75 p-5 shadow-sm backdrop-blur-(--glass-blur)">
                  <Skeleton class="mb-2 h-6 w-3/4 rounded-md bg-white/10" />
                  <div class="flex items-center gap-2 text-sm">
                    <Skeleton class="size-3.5 rounded-full bg-white/10" />
                    <Skeleton class="h-4 w-28 rounded-md bg-white/5" />
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
)}

{(variant === "detail" || variant === "family-tree") && (
  <div class="relative min-h-dvh py-8">
    <div class="space-y-8">
      <!-- Compact Hero Header -->
      <HeroSkeleton variant="compact" statsCount={3} hasExample={true} />

      <!-- Topic Story with CEFR Level Cards and Audio Companion Island -->
      <section class="mt-8">
        <TopicStorySkeleton />
      </section>

      <!-- Vocabulary Tables Classified by Word Classes -->
      <section class="mt-8">
        <VocabularyTableSkeleton />
      </section>
    </div>
  </div>
)}
