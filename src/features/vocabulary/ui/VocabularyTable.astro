---
import { Volume2 } from "lucide-astro";
import { parseNounGender, type GenderInfo } from "@/shared/lib";
import type { Word } from "../model/types";

interface Props {
  words: Word[];
  englishLabel?: string | undefined;
}

const { words, englishLabel = "English" } = Astro.props;

interface EnrichedWord extends Word {
  genderInfo: GenderInfo;
}

type PartOfSpeechCategory = "noun" | "verb" | "adjective";

const KNOWN_ADJECTIVES = new Set([
  "ledig",
  "verheiratet",
  "geschieden",
  "verlobt",
  "verwitwet",
  "verwandt",
  "jung",
  "alt",
  "groß",
  "klein",
  "schön",
  "hässlich",
  "gut",
  "schlecht",
  "glücklich",
  "traurig",
  "müde",
  "gesund",
  "krank",
  "freundlich",
  "unfreundlich",
  "reich",
  "arm",
  "teuer",
  "billig",
  "schnell",
  "langsam",
  "neu",
  "wichtig",
]);

function classifyWord(word: Word): PartOfSpeechCategory {
  if (word.partOfSpeech) {
    return word.partOfSpeech;
  }

  const text = word.german.trim();
  const lower = text.toLowerCase();

  if (KNOWN_ADJECTIVES.has(lower)) {
    return "adjective";
  }

  if (
    lower.startsWith("der ")
    || lower.startsWith("die ")
    || lower.startsWith("das ")
    || lower.startsWith("der/die ")
    || lower.startsWith("das/der ")
    || lower.startsWith("die/der ")
  ) {
    return "noun";
  }

  if (lower.startsWith("sich ")) {
    return "verb";
  }

  const firstChar = text.charAt(0);
  if (firstChar === firstChar.toUpperCase() && firstChar !== firstChar.toLowerCase()) {
    return "noun";
  }

  if (
    lower.endsWith("ig")
    || lower.endsWith("lich")
    || lower.endsWith("isch")
    || lower.endsWith("bar")
    || lower.endsWith("haft")
    || lower.endsWith("los")
    || lower.endsWith("voll")
    || lower.endsWith("sam")
  ) {
    return "adjective";
  }

  if (lower.endsWith("en") || lower.endsWith("eln") || lower.endsWith("ern")) {
    return "verb";
  }

  return "adjective";
}

const nouns: EnrichedWord[] = [];
const verbs: EnrichedWord[] = [];
const adjectives: EnrichedWord[] = [];

for (const word of words) {
  const genderInfo = parseNounGender(word.german);
  const enriched: EnrichedWord = { ...word, genderInfo };
  const category = classifyWord(word);
  if (category === "noun") {
    nouns.push(enriched);
  } else if (category === "verb") {
    verbs.push(enriched);
  } else {
    adjectives.push(enriched);
  }
}

interface CategoryConfig {
  key: PartOfSpeechCategory;
  title: string;
  germanType: string;
  englishType: string;
  arabicType: string;
  badgeClass: string;
  cardBorderClass: string;
  headerBorderClass: string;
  headerBgClass: string;
  countLabel: string;
  words: EnrichedWord[];
}

const sections: CategoryConfig[] = [
  {
    key: "noun" as const,
    title: "Nomen",
    germanType: "Substantive",
    englishType: "Nouns",
    arabicType: "الأسماء",
    badgeClass: "border-sky-500/30 bg-sky-500/10 text-sky-400",
    cardBorderClass: "border-2 border-sky-500/30 hover:border-sky-500/50 shadow-sky-500/5",
    headerBorderClass: "border-sky-500/20",
    headerBgClass: "bg-sky-500/[0.04]",
    countLabel: nouns.length === 1 ? "1 Nomen" : `${nouns.length} Nomen`,
    words: nouns,
  },
  {
    key: "verb" as const,
    title: "Verben",
    germanType: "Tätigkeitswörter",
    englishType: "Verbs",
    arabicType: "الأفعال",
    badgeClass: "border-emerald-500/30 bg-emerald-500/10 text-emerald-400",
    cardBorderClass:
      "border-2 border-emerald-500/30 hover:border-emerald-500/50 shadow-emerald-500/5",
    headerBorderClass: "border-emerald-500/20",
    headerBgClass: "bg-emerald-500/[0.04]",
    countLabel: verbs.length === 1 ? "1 Verb" : `${verbs.length} Verben`,
    words: verbs,
  },
  {
    key: "adjective" as const,
    title: "Adjektive",
    germanType: "Eigenschaftswörter",
    englishType: "Adjectives",
    arabicType: "الصفات",
    badgeClass: "border-amber-500/30 bg-amber-500/10 text-amber-400",
    cardBorderClass: "border-2 border-amber-500/30 hover:border-amber-500/50 shadow-amber-500/5",
    headerBorderClass: "border-amber-500/20",
    headerBgClass: "bg-amber-500/[0.04]",
    countLabel: adjectives.length === 1 ? "1 Adjektiv" : `${adjectives.length} Adjektive`,
    words: adjectives,
  },
].filter((section) => section.words.length > 0);
---

{words.length > 0 && (
  <div
    class="space-y-6"
    data-animate="fade-up"
  >
    <!-- Category Overview Bar with Border -->
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border-[1.5px] border-white/10 bg-white/2 p-4 shadow-sm backdrop-blur-md">
      <div>
        <h3 class="text-base font-bold tracking-tight text-white @md:text-lg">
          Wortschatz nach Wortarten
        </h3>
        <p class="text-xs text-mist-400">
          Strukturiert in Nomen, Verben und Adjektive für ein gezieltes Lernen
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        {sections.map((section) => (
          <span
            class:list={[
              "inline-flex items-center gap-1.5 rounded-full border-[1.5px] px-3 py-1 text-xs font-semibold tracking-wide",
              section.badgeClass,
            ]}
          >
            <span>{section.title}</span>
            <span class="opacity-75">({section.words.length})</span>
          </span>
        ))}
      </div>
    </div>

    <!-- 3 Distinct Category Sections, Each Wrapped With Its Own Defined Border -->
    <div class="space-y-6">
      {sections.map((section) => (
        <div
          class:list={[
            "overflow-hidden rounded-2xl border-2 bg-card/60 shadow-lg backdrop-blur-(--glass-blur) transition-all duration-200",
            section.cardBorderClass,
          ]}
        >
          <!-- Section Header Banner with bottom border -->
          <div
            class:list={[
              "flex flex-wrap items-center justify-between gap-3 border-b px-4 py-3.5 @md:px-6",
              section.headerBorderClass,
              section.headerBgClass,
            ]}
          >
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  "inline-flex items-center rounded-lg border-[1.5px] px-2.5 py-1 text-xs font-bold tracking-wide uppercase",
                  section.badgeClass,
                ]}
              >
                {section.title}
              </span>
              <span class="text-xs font-medium text-mist-400 @md:text-sm">
                {section.germanType} · {section.englishType}
              </span>
            </div>

            <div class="flex items-center gap-3">
              <span
                class="font-arabic text-sm font-semibold text-mist-300 @md:text-base"
                dir="rtl"
              >
                {section.arabicType}
              </span>
              <span class="rounded-full border-[1.5px] border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-medium text-mist-400">
                {section.countLabel}
              </span>
            </div>
          </div>

          <!-- Direct Word List Table (No nested box, no visible inner Deutsch/English/Arabic header) -->
          <div class="scrollbar-thin overflow-x-auto">
            <table class="inline-full border-collapse text-left">
              <caption class="sr-only">{section.title} Vokabelliste</caption>
              <thead class="sr-only">
                <tr>
                  <th scope="col">Deutsch</th>
                  <th scope="col">{englishLabel}</th>
                  <th scope="col">العربية</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                {section.words.map((word) => (
                  <tr class="group/row transition-colors hover:bg-white/4">
                    <!-- German Word Column with Pronunciation, Badge & Example -->
                    <td class="px-4 py-3.5 font-medium @md:px-6">
                      <div class="flex items-start gap-3">
                        <!-- Audio Pronunciation Button -->
                        <button
                          aria-label={`Aussprache anhören für ${word.german}`}
                          class="group/btn mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full border-[1.5px] border-white/15 bg-white/5 text-mist-400 transition-colors hover:border-yellow/50 hover:bg-yellow/15 hover:text-yellow focus:ring-2 focus:ring-yellow/40 focus:outline-hidden data-[playing=true]:border-yellow data-[playing=true]:bg-yellow/20 data-[playing=true]:text-yellow"
                          data-speak={word.german}
                          title="Aussprache anhören"
                          type="button"
                        >
                          <Volume2 class="size-3.5" />
                        </button>

                        <div class="min-w-0">
                          <!-- German Word with Article / Category Badge -->
                          <div class="flex flex-wrap items-baseline gap-2 text-sm @md:text-base">
                            {word.genderInfo.article && (
                              <span
                                class:list={[
                                  "inline-flex items-center rounded-md border-[1.5px] px-1.5 py-0.5 text-[11px] font-bold tracking-tight uppercase",
                                  word.genderInfo.badgeClass,
                                ]}
                              >
                                {word.genderInfo.article}
                              </span>
                            )}
                            {!word.genderInfo.article && section.key === "verb" && (
                              <span class="inline-flex items-center rounded-md border-[1.5px] border-emerald-500/30 bg-emerald-500/10 px-1.5 py-0.5 text-[11px] font-bold text-emerald-400 uppercase">
                                Verb
                              </span>
                            )}
                            {!word.genderInfo.article && section.key === "adjective" && (
                              <span class="inline-flex items-center rounded-md border-[1.5px] border-amber-500/30 bg-amber-500/10 px-1.5 py-0.5 text-[11px] font-bold text-amber-400 uppercase">
                                Adj.
                              </span>
                            )}
                            <span
                              class:list={[
                                "font-semibold",
                                word.genderInfo.article ? word.genderInfo.textClass : "text-white/95",
                                { "text-emerald-300": !word.genderInfo.article && section.key === "verb" },
                                { "text-amber-300": !word.genderInfo.article && section.key === "adjective" },
                              ]}
                            >
                              {word.genderInfo.baseWord}
                            </span>
                          </div>

                          <!-- Context Example Sentence -->
                          {word.example && (
                            <p class="mt-1 text-xs text-mist-400/85 italic">
                              „{word.example}“
                            </p>
                          )}
                        </div>
                      </div>
                    </td>

                    <!-- English Column -->
                    <td class="px-4 py-3.5 text-sm text-mist-200 @md:px-6 @md:text-base">
                      <span>{word.english ?? word.example}</span>
                    </td>

                    <!-- Arabic Column -->
                    <td
                      class="px-4 py-3.5 text-right font-arabic text-base font-medium text-mist-300 @md:px-6 @md:text-lg"
                      dir="rtl"
                    >
                      {word.arabic}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<script src="../lib/audio.ts"></script>
