---
import { ArrowLeft, Award, BookOpen, GraduationCap, Home, User } from "lucide-astro";

interface Props {
  pathname?: string | undefined;
}

const pathname = Astro.props.pathname ?? Astro.url.pathname;

const navLinks = [
  { to: "/vokabeln", label: "Vokabeln" },
  { to: "/grammatik", label: "Grammatik" },
  { to: "/pruefung", label: "Prüfung" },
  { to: "/login", label: "Anmelden" },
];

const mobileNavLinks = [
  { to: "/", label: "Start", icon: Home },
  { to: "/vokabeln", label: "Vokabeln", icon: BookOpen },
  { to: "/grammatik", label: "Grammatik", icon: GraduationCap },
  { to: "/pruefung", label: "Prüfung", icon: Award },
  { to: "/login", label: "Profil", icon: User },
];

const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname === path || pathname.startsWith(path + "/");
};

const computedNavLinks = navLinks.map((link) => ({ ...link, isActive: isActive(link.to) }));

const computedMobileNavLinks = mobileNavLinks.map((link) => ({
  ...link,
  isActive: isActive(link.to),
}));

const showBackButton =
  pathname !== "/vokabeln"
  && pathname !== "/grammatik"
  && pathname !== "/pruefung"
  && pathname !== "/";
---

<!-- Top Navigation Header -->
<header class="relative mbe-2 mobile:mbe-6">
  <div
    class:list={[
      "relative mx-auto flex max-w-7xl items-center px-3 py-3 mobile:px-8 mobile:py-6",
      {
        "justify-between": showBackButton,
        "justify-center laptop:justify-between": !showBackButton,
      },
    ]}
  >
    <!-- Brand Logo & Optional Back Button -->
    <div class="flex items-center justify-start gap-3.5">
      {showBackButton ?
        <button
          aria-label="Zurück"
          class="group inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-card/80 px-3.5 py-2 text-sm font-semibold text-text shadow-sm backdrop-blur-(--glass-blur) transition-all duration-200 hover:-translate-x-0.5 hover:border-yellow/30 hover:bg-white/10 active:scale-95 tablet:px-5 tablet:py-2.5"
          onclick="window.history.back()"
          type="button"
        >
          <ArrowLeft class="size-4.5 text-yellow transition-transform duration-200 group-hover:-translate-x-0.5" />
          <span class="text-xs font-semibold text-white/90 tablet:text-sm">Zurück</span>
        </button>
      : <a
          aria-label="Elite Regewelt Startseite"
          class="flex items-center gap-2.5 rounded-2xl border-2 border-white/10 bg-card/80 p-1.5 pe-3.5 shadow-[0_8px_30px_rgba(0,0,0,0.35)] backdrop-blur-(--glass-blur) transition-colors duration-200 hover:border-yellow/50 mobile:gap-3.5 mobile:rounded-3xl mobile:p-2 mobile:pe-5"
          href="/"
        >
          <span class="flex size-11 shrink-0 items-center justify-center mobile:size-13 tablet:size-14">
            <img
              alt="Elite Regewelt"
              class="size-full object-contain drop-shadow-md"
              height="56"
              loading="eager"
              src="/logo.png"
              width="56"
            />
          </span>
          <div class="flex flex-col">
            <span class="bg-linear-to-r from-white via-white/95 to-mist-400 bg-clip-text text-sm font-bold tracking-tight text-transparent mobile:text-base tablet:text-lg">
              Elite Regewelt
            </span>
            <span class="text-[10px] font-medium tracking-wide text-yellow/85 mobile:text-[11px] tablet:text-xs">
              Deutch Sprache Lernen
            </span>
          </div>
        </a>
      }
    </div>

    <!-- Right Side on Laptop & Desktop: Floating Pill Navigation -->
    <nav
      aria-label="Hauptnavigation"
      class="relative hidden flex-wrap justify-center gap-1 overflow-hidden rounded-full border-2 border-white/10 bg-card/75 px-2 py-1.5 shadow-[0_8px_32px_rgba(0,0,0,0.4)] backdrop-blur-(--glass-blur) laptop:inline-flex laptop:gap-1.5"
      id="desktop-nav"
    >
      <!-- Sliding Indicator -->
      <div
        class="pointer-events-none absolute inset-y-1.5 left-0 z-0 rounded-full bg-linear-to-br from-yellow to-orange opacity-0 shadow-lg shadow-yellow/25"
        id="desktop-nav-indicator"
      ></div>

      {computedNavLinks.map((link) => (
        <a
          aria-current={link.isActive ? "page" : undefined}
          class:list={[
            "relative z-10 rounded-full px-4 py-2 text-sm font-semibold transition-all duration-200 laptop:px-5",
            {
              "font-semibold text-black": link.isActive,
              "text-mist-400 hover:bg-white/5 hover:text-white": !link.isActive,
            },
          ]}
          href={link.to}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- Mobile & Tablet Floating Dock (Bottom Navigation Bar) -->
<nav
  aria-label="Mobile Navigation"
  class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-50 mx-auto flex max-w-sm items-center justify-around rounded-3xl border-2 border-white/12 bg-bg/85 px-1.5 py-1.5 shadow-[0_16px_40px_rgba(0,0,0,0.65)] backdrop-blur-2xl tablet:max-w-md tablet:px-2 tablet:py-2 laptop:hidden"
>
  {computedMobileNavLinks.map((link) => {
    const Icon = link.icon;
    return (
      <a
        aria-current={link.isActive ? "page" : undefined}
        aria-label={link.label}
        class:list={[
          "group relative flex flex-1 flex-col items-center justify-center rounded-2xl px-2 py-1.5 transition-all duration-200",
          {
            "bg-white/10 text-yellow shadow-inner shadow-white/5": link.isActive,
            "text-mist-500 hover:text-white active:scale-95": !link.isActive,
          },
        ]}
        href={link.to}
        title={link.label}
      >
        {link.isActive && (
          <span class="absolute -top-1.5 h-0.5 w-5 rounded-full bg-linear-to-r from-yellow to-orange shadow-[0_0_8px_var(--color-yellow)]" />
        )}

        <Icon
          class:list={[
            "size-5 transition-transform duration-200",
            {
              "scale-110 text-yellow": link.isActive,
              "group-hover:scale-105 group-hover:text-mist-200": !link.isActive,
            },
          ]}
        />

        <span
          class:list={[
            "mt-1 text-[10px] leading-none tracking-tight transition-colors duration-200",
            {
              "font-bold text-white": link.isActive,
              "font-medium text-mist-500 group-hover:text-mist-300": !link.isActive,
            },
          ]}
        >
          {link.label}
        </span>
      </a>
    );
  })}
</nav>

<script src="../lib/navigation.ts"></script>
