---
import Skeleton from "@/shared/ui/Skeleton.astro";

interface Props {
  class?: string;
}

const { class: customClass = "" } = Astro.props;
---

<footer
  aria-hidden="true"
  class:list={[
    "relative mt-10 mb-8 overflow-hidden rounded-3xl border-2 border-white/10 bg-card/75 p-5 shadow-[0_20px_50px_rgba(0,0,0,0.4)] backdrop-blur-(--glass-blur) mobile:mt-12 mobile:mb-10 mobile:p-6 tablet:mt-14 tablet:mb-12 tablet:p-7 laptop:mb-14 laptop:p-8",
    customClass,
  ]}
  role="presentation"
>
  <div class="w-full">
    <!-- TIER 1: Brand & Pedagogical German Gender System -->
    <div class="mb-6 flex flex-col gap-4 border-b border-white/10 pb-5 tablet:mb-7 tablet:gap-5 tablet:pb-6 laptop:flex-row laptop:items-center laptop:justify-between laptop:gap-6">
      <!-- Brand & Mission Skeleton -->
      <div class="flex items-center gap-3.5 mobile:gap-4 tablet:gap-5 laptop:max-w-2xl">
        <Skeleton class="size-16 shrink-0 rounded-2xl bg-white/10 mobile:size-20 tablet:size-22" />

        <div class="flex-1 space-y-1">
          <div class="space-y-0.5">
            <Skeleton class="h-6 w-36 rounded-md bg-white/15 tablet:h-7 tablet:w-44" />
            <Skeleton class="h-3.5 w-28 rounded-md bg-white/10" />
          </div>

          <div class="space-y-1 pt-0.5">
            <Skeleton class="h-3.5 w-full max-w-md rounded-md bg-white/5" />
            <Skeleton class="h-3.5 w-3/4 max-w-sm rounded-md bg-white/5" />
          </div>
        </div>
      </div>

      <!-- Pedagogical Gender Badges Skeleton -->
      <div class="space-y-1.5 laptop:shrink-0">
        <Skeleton class="h-3.5 w-28 rounded-md bg-white/10" />
        <div class="flex flex-wrap items-center gap-1.5">
          <Skeleton class="h-5.5 w-22 rounded-md border border-gender-der/20 bg-gender-der/15" />
          <Skeleton class="h-5.5 w-20 rounded-md border border-gender-die/20 bg-gender-die/15" />
          <Skeleton class="h-5.5 w-20 rounded-md border border-gender-das/20 bg-gender-das/15" />
          <Skeleton class="h-5.5 w-18 rounded-md border border-gender-pl/20 bg-gender-pl/15" />
        </div>
      </div>
    </div>

    <!-- TIER 2: Main Navigation Grid (4 Columns, exactly matching Footer.astro line heights & counts) -->
    <div class="grid grid-cols-2 gap-x-4 gap-y-6 mobile:gap-x-6 mobile:gap-y-6 tablet:grid-cols-4 tablet:gap-x-6 tablet:gap-y-0 laptop:gap-x-8">
      <!-- Column 1: Wortschatz (6 items) -->
      <div>
        <div class="mb-2.5 flex items-center gap-1.5">
          <Skeleton class="size-3.5 rounded-full bg-white/10" />
          <Skeleton class="h-4 w-20 rounded-md bg-white/15" />
        </div>
        <ul
          class="flex flex-col space-y-0.5"
          role="list"
        >
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-32 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-24 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-28 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-32 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-26 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-34 rounded-md bg-white/5" />
          </li>
        </ul>
      </div>

      <!-- Column 2: Grammatik (5 items) -->
      <div>
        <div class="mb-2.5 flex items-center gap-1.5">
          <Skeleton class="size-3.5 rounded-full bg-white/10" />
          <Skeleton class="h-4 w-20 rounded-md bg-white/15" />
        </div>
        <ul
          class="flex flex-col space-y-0.5"
          role="list"
        >
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-32 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-26 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-24 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-22 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-26 rounded-md bg-white/5" />
          </li>
        </ul>
      </div>

      <!-- Column 3: Prüfungstraining (5 items) -->
      <div>
        <div class="mb-2.5 flex items-center gap-1.5">
          <Skeleton class="size-3.5 rounded-full bg-white/10" />
          <Skeleton class="h-4 w-28 rounded-md bg-white/15" />
        </div>
        <ul
          class="flex flex-col space-y-0.5"
          role="list"
        >
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-28 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-28 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-28 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-24 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-34 rounded-md bg-white/5" />
          </li>
        </ul>
      </div>

      <!-- Column 4: Interaktiv (5 items) -->
      <div>
        <div class="mb-2.5 flex items-center gap-1.5">
          <Skeleton class="size-3.5 rounded-full bg-white/10" />
          <Skeleton class="h-4 w-18 rounded-md bg-white/15" />
        </div>
        <ul
          class="flex flex-col space-y-0.5"
          role="list"
        >
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-24 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-32 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-30 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-32 rounded-md bg-white/5" />
          </li>
          <li class="flex items-center py-0.5">
            <Skeleton class="h-5 w-34 rounded-md bg-white/5" />
          </li>
        </ul>
      </div>
    </div>

    <!-- TIER 3: Bottom Bar / Legal & Standards -->
    <div class="mt-6 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-4 sm:flex-row tablet:mt-7 tablet:pt-5">
      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:justify-start">
        <Skeleton class="h-3.5 w-52 rounded-md bg-white/10" />
        <Skeleton class="h-3.5 w-36 rounded-md bg-white/5" />
      </div>

      <div class="flex items-center gap-3">
        <Skeleton class="h-6 w-24 rounded-md bg-white/10" />
        <Skeleton class="h-2.5 w-4.5 rounded-xs bg-white/15" />
        <Skeleton class="h-3.5 w-20 rounded-md bg-white/5" />
      </div>
    </div>
  </div>
</footer>
