---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { HeroProps } from "../model/types.ts";

type RenderableComponent =
  AstroComponentFactory | ((properties: Record<string, unknown>) => unknown);

type Props = HeroProps<RenderableComponent>;

const {
  title,
  description,
  category,
  example,
  badge,
  gradient,
  variant = "default",
  stats,
  headingLevel = "h1",
} = Astro.props;

const HeadingTag = headingLevel;
const isGlassBorder = !gradient || variant === "glass" || variant === "compact";
const isPrimaryHero = headingLevel === "h1";
const animateFadeIn = isPrimaryHero ? undefined : "fade-in";
const animateFadeUp = isPrimaryHero ? undefined : "fade-up";
const displayCategory =
  category && /^Kapitel\b/i.test(category) ? "Wortschatz" : category;
---

<section
  class:list={[
    "relative overflow-hidden rounded-2xl shadow-xl transition-all",
    {
      "border-2 border-(--glass-border) bg-card backdrop-blur-(--glass-blur)": isGlassBorder,
      "mbe-6 p-4 mobile:p-6 tablet:p-8": variant === "compact",
      "mbe-8 mobile:mbe-12 p-6 mobile:p-8 tablet:p-10 laptop:p-12": variant !== "compact",
    },
  ]}
  data-animate={animateFadeIn}
  style={gradient && variant !== "glass" && variant !== "compact" ? { background: gradient } : {}}
>
  <div
    class:list={[
      {
        "max-inline-3xl": gradient && variant !== "compact",
        "text-center": !gradient || variant === "compact",
      },
    ]}
  >
    <div
      class:list={["mbe-4 flex flex-wrap items-center gap-3", { "justify-center": !gradient }]}
      data-animate={animateFadeUp}
    >
      {displayCategory && (
        <span
          class:list={[
            "inline-block rounded-full px-6 py-2 font-bold",
            {
              "bg-black/20 text-xs text-white tablet:text-sm": gradient,
              "bg-linear-to-br from-yellow to-orange text-lg text-black shadow-lg shadow-yellow/20 tablet:text-xl":
                !gradient,
            },
          ]}
        >
          {displayCategory}
        </span>
      )}
      {badge && (
        <span
          class:list={[
            "inline-block rounded-lg px-3 py-1.5 text-xs font-bold shadow-sm tablet:text-sm",
            {
              "bg-white/20 text-white": gradient,
              "border-[1.5px] border-white/15 bg-white/10 text-mist-200 backdrop-blur-md":
                !gradient,
            },
          ]}
        >
          {badge}
        </span>
      )}
    </div>

    <HeadingTag
      class:list={[
        "m-0 mbe-4 text-2xl font-bold tracking-tight text-shadow-sm mobile:text-3xl tablet:text-4xl laptop:text-5xl desktop:text-6xl",
        {
          "text-white drop-shadow-[0_2px_10px_black/20]": gradient,
          "bg-linear-to-br from-white to-slate-200 bg-clip-text text-transparent": !gradient,
        },
      ]}
      data-animate={animateFadeUp}
    >
      {title}
    </HeadingTag>

    <p
      class:list={[
        "m-0 mx-auto w-full max-w-4xl text-base leading-relaxed text-pretty tablet:max-w-5xl tablet:text-lg laptop:max-w-6xl laptop:text-xl",
        { "text-white/90": gradient, "text-mist-300": !gradient },
      ]}
      data-animate={animateFadeUp}
    >
      {description}
    </p>

    {example && (
      <p
        class="mbs-3 text-sm font-medium text-amber-300/90 tablet:text-base"
        data-animate={animateFadeIn}
      >
        <span>{example}</span>
      </p>
    )}

    {stats && stats.length > 0 && (
      <dl
        class:list={[
          "mbs-8 grid gap-3 border-t border-white/10 pt-6 mobile:gap-4 tablet:gap-6",
          {
            "mx-auto max-w-xs grid-cols-1": stats.length === 1,
            "mx-auto max-w-lg grid-cols-1 min-[480px]:grid-cols-2": stats.length === 2,
            "grid-cols-1 min-[480px]:grid-cols-3": stats.length === 3,
            "grid-cols-1 min-[480px]:grid-cols-2 md:grid-cols-4": stats.length >= 4,
          },
        ]}
        data-animate="zoom-in"
      >
        {stats.map((stat) => (
          <div class="flex flex-col items-center justify-center rounded-lg border border-white/5 bg-white/2 px-4 py-3 text-center">
            <dd class="m-0 text-xl font-bold font-mono tracking-tight text-white tablet:text-2xl">
              {stat.value}
            </dd>
            <dt class="mt-1 text-xs font-medium uppercase tracking-wider text-mist-400">
              {stat.label}
            </dt>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>
