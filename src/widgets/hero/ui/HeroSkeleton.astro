---
import Skeleton from "@/shared/ui/skeleton/Skeleton.astro";

interface Props {
  variant?: "default" | "glass" | "compact";
  hasCategory?: boolean;
  hasStats?: boolean;
  statsCount?: number;
  hasExample?: boolean;
}

const {
  variant = "default",
  hasCategory = true,
  hasStats = true,
  statsCount = 3,
  hasExample = false,
} = Astro.props;

const statIds = Array.from({ length: statsCount }, (_, index) => `stat-${index}`);
---

<div
  class:list={[
    "relative overflow-hidden rounded-2xl border-2 border-(--glass-border) bg-card shadow-xl backdrop-blur-(--glass-blur)",
    {
      "mbe-6 p-4 mobile:p-6 tablet:p-8": variant === "compact",
      "mbe-8 mobile:mbe-12 p-6 mobile:p-8 tablet:p-10 laptop:p-12": variant !== "compact",
    },
  ]}
>
  <div class="flex flex-col items-center text-center">
    {hasCategory && (
      <div class="mbe-4 flex flex-wrap items-center justify-center gap-3">
        <Skeleton class="h-9 w-28 rounded-full bg-white/10" />
      </div>
    )}
    <Skeleton class="mx-auto mbe-4 h-9 mobile:h-10 tablet:h-12 laptop:h-14 w-3/4 max-w-2xl rounded-md bg-white/15" />
    <Skeleton class="mx-auto h-6 w-full max-w-xl tablet:w-2/3 rounded-md bg-white/5" />

    {hasExample && <Skeleton class="mx-auto mbs-3 h-5 w-2/3 max-w-lg rounded-md bg-white/10" />}

    {hasStats && statsCount > 0 && (
      <div
        class:list={[
          "mbs-8 grid w-full border-t border-white/10 pt-6 mobile:gap-4 tablet:gap-6",
          {
            "mx-auto max-w-xs grid-cols-1": statsCount === 1,
            "mx-auto max-w-lg grid-cols-1 min-[480px]:grid-cols-2": statsCount === 2,
            "max-w-2xl grid-cols-1 min-[480px]:grid-cols-3": statsCount === 3,
            "max-w-4xl grid-cols-1 min-[480px]:grid-cols-2 md:grid-cols-4": statsCount >= 4,
          },
        ]}
      >
        {statIds.map(() => (
          <div class="flex flex-col items-center justify-center rounded-lg border border-white/5 bg-white/2 p-3 text-center">
            <Skeleton class="h-7 w-16 rounded-md bg-white/15" />
            <Skeleton class="mt-2 h-3.5 w-14 rounded-md bg-white/10" />
          </div>
        ))}
      </div>
    )}
  </div>
</div>
