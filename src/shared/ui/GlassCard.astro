---
import { cn } from "@/shared/lib";

const {
  class: className,
  as: Component = "div",
  noBlur = false,
  rounded = "3xl",
  ...rest
} = Astro.props;
---

<Component
  class:list={cn(
    "overflow-hidden border-2 border-(--glass-border) bg-card shadow-sm",
    rounded === "3xl" ? "rounded-3xl" : "rounded-2xl",
    !noBlur && "backdrop-blur-(--glass-blur)",
    className,
  )}
  {...rest}
>
  <slot />
</Component>
