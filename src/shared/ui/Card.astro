---
import { getFirstLetter } from "../lib/utilities.ts";

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  description?: string;
  category?: string;
  badge?: string;
  gradient: string;
  icon?: string;
  stats?: Array<{ label: string; value: string }>;
  variant?: "default" | "large";
}

const {
  href,
  title,
  subtitle,
  description,
  category,
  badge,
  gradient,
  icon,
  stats,
  variant = "default",
} = Astro.props;

const iconText = icon ?? getFirstLetter(title);
---

<a
  class="block h-full no-underline"
  href={href}
>
  <article class="h-full">
    <div
      aria-label={`${title} ${subtitle ?? ""}`}
      class="group card-link relative z-1 flex h-full w-full cursor-pointer flex-col overflow-hidden rounded-3xl p-4 text-left no-underline"
    >
      <figure class="m-0 aspect-video w-full overflow-hidden rounded-2xl">
        <div
          aria-hidden="true"
          class="flex h-full w-full items-center justify-center transition-transform duration-500 group-hover:scale-110"
          style={{ background: gradient }}
        >
          <span
            class:list={[
              {
                "text-4xl tablet:text-6xl": variant === "large",
                "text-3xl tablet:text-5xl": variant !== "large",
              },
              "font-bold text-white/40 drop-shadow-md drop-shadow-white/20 transition-transform duration-500 group-hover:scale-110",
            ]}
          >
            {iconText}
          </span>
        </div>
      </figure>
      <div class="flex flex-1 flex-col px-2 pt-5 pb-2">
        {(category || badge || subtitle) && (
          <div class="m-0 mbe-3 flex items-center gap-2 text-mist-500">
            {category && (
              <span class="rounded-full border border-yellow/30 bg-yellow/20 px-3 py-1 font-bold text-yellow">
                {category}
              </span>
            )}
            {badge && (
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-mist-500">
                {badge}
              </span>
            )}
            {subtitle && <span class="font-medium">• {subtitle}</span>}
          </div>
        )}

        <h3
          class:list={[
            {
              "text-xl tablet:text-2xl": variant === "large",
              "text-lg tablet:text-xl": variant !== "large",
            },
            "m-0 mbe-2 font-bold text-white transition-colors duration-300 text-shadow-sm group-hover:text-yellow",
          ]}
        >
          {title}
        </h3>
        {description && (
          <p class="m-0 mbe-4 text-xs leading-relaxed text-mist-500 tablet:text-sm">
            {description}
          </p>
        )}

        {stats && stats.length > 0 && (
          <dl class="mbs-auto flex gap-8 border-bs border-(--glass-border) pbs-4">
            {stats.map((stat) => (
              <div class="flex flex-col">
                <dd class="stat-value m-0 text-xl font-bold text-orange tablet:text-2xl">
                  {stat.value}
                </dd>
                <dt class="text-xs text-text-muted">{stat.label}</dt>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>
  </article>
</a>
