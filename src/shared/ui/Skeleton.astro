---
import { cn } from "../lib/utilities.ts";

interface Props {
  class?: string;
  className?: string;
  style?: string | Record<string, string | number>;
}

const { class: classProperty, className: classNameProperty, style } = Astro.props;
const customClass = cn(classProperty, classNameProperty);
---

<div
  class:list={cn(
    "relative overflow-hidden rounded-md bg-white/5",
    customClass,
  )}
  data-slot="skeleton"
  style={style}
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 left-0 w-1/2 -translate-x-full bg-linear-to-r from-transparent via-white/8 to-transparent"
    data-gsap-shimmer
  ></span>
</div>
