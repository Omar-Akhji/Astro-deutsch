---
import CardBody from "./CardBody.astro";
import CardWithModal from "./CardWithModal.astro";

interface Props {
  href: string;
  title: string;
  subtitle?: string | undefined;
  description?: string | undefined;
  category?: string | undefined;
  badge?: string | undefined;
  gradient: string;
  icon?: string | undefined;
  stats?: Array<{ label: string; value: string }> | undefined;
  variant?: "default" | "large" | undefined;
  headingLevel?: "h2" | "h3" | undefined;
  withModal?: boolean | undefined;
  previewTitles?: string[] | undefined;
  levelBadge?: string | undefined;
  itemType?: string | undefined;
  modalId?: string | undefined;
}

const { href, withModal, ...restProps } = Astro.props;
---

{withModal ?
  <CardWithModal
    href={href}
    {...restProps}
  />
: <a
    class="block h-full no-underline"
    href={href}
  >
    <CardBody {...restProps} />
  </a>
}
