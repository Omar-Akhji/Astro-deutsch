---
interface Props {
  id: string;
  title: string;
  subtitle?: string | undefined;
  description?: string | undefined;
  href?: string | undefined;
  previewTitles?: string[] | undefined;
  levelBadge?: string | undefined;
  itemType?: string | undefined;
}

const {
  id,
  title,
  subtitle,
  description,
  href,
  previewTitles = [],
  levelBadge,
  itemType = "Kapitel",
} = Astro.props;
---

<dialog
  aria-labelledby={`${id}-title`}
  class="card-modal-dialog fixed inset-0 z-100 m-0 hidden h-full w-full max-h-full max-w-full items-center justify-center border-none bg-transparent p-4 open:flex"
  id={id}
>
  {/* Backdrop button for outside click */}
  <button
    aria-label="Dialog schließen"
    class="card-modal-backdrop -z-1 fixed inset-0 cursor-default border-none bg-black/80 backdrop-blur-sm"
    data-card-modal-close
    type="button"
  />

  {/* Modal Content Window */}
  <div
    aria-labelledby={`${id}-title`}
    class="card-modal-content relative z-10 flex h-auto max-h-[90vh] w-full min-w-[min(100%,20rem)] max-w-lg flex-col overflow-hidden rounded-xl border-2 border-neutral-400/30 bg-[#0a0a0a] shadow-2xl sm:max-h-[85vh] sm:w-auto sm:min-w-[24rem] sm:max-w-xl"
    role="document"
  >
    {/* Header Content */}
    <div class="shrink-0 border-b-2 border-neutral-400/30 bg-[oklch(18%_0.015_245deg/50%)] p-4 sm:p-6">
      {(subtitle || levelBadge) && (
        <div class="mb-3 flex flex-wrap items-center gap-2">
          {subtitle && (
            <span class="rounded-full border border-yellow/30 bg-yellow/20 px-3 py-1 text-xs font-bold text-yellow">
              {subtitle}
            </span>
          )}
          {subtitle && levelBadge && <span class="text-xs font-medium text-mist-500">•</span>}
          {levelBadge && <span class="text-xs font-medium text-mist-500">{levelBadge}</span>}
        </div>
      )}
      <h2
        class="text-xl font-semibold text-yellow text-shadow-sm sm:text-2xl"
        id={`${id}-title`}
      >
        {title}
      </h2>
      {description && <p class="mt-2 text-sm leading-relaxed text-mist-500">{description}</p>}
    </div>

    {/* Scrollable Content */}
    <div class="modal-scroll flex-1 min-h-0 space-y-3 overflow-y-auto p-4 sm:space-y-4 sm:p-6">
      <slot>
        {previewTitles.length > 0 ?
          previewTitles.map((previewTitle, index) => (
            <div class="overflow-hidden rounded-xl border-2 border-neutral-400/30 bg-mist-900/50 transition-colors hover:border-yellow/30">
              <div class="flex items-center gap-3 p-3 sm:px-4 sm:py-3.5">
                <span class="shrink-0 rounded-full border border-yellow/30 bg-yellow/20 px-2.5 py-0.5 text-xs font-bold text-yellow">
                  {itemType} {index + 1}
                </span>
                <span class="text-sm font-medium text-white sm:text-base">{previewTitle}</span>
              </div>
            </div>
          ))
        : <div class="rounded-xl border-2 border-neutral-400/30 bg-mist-900/50 p-6 text-center text-mist-500">
            Keine Vorschau verfügbar
          </div>
        }
      </slot>
    </div>

    {/* Footer Actions */}
    <div class="shrink-0 border-t-2 border-neutral-400/30 bg-[oklch(18%_0.015_245deg/50%)] p-4 sm:p-6">
      <slot name="footer">
        <div class="flex items-center gap-3">
          <button
            class="card-modal-close flex-1 cursor-pointer rounded-full border-2 border-neutral-400/30 px-4 py-2.5 font-semibold text-mist-500 transition-colors hover:border-neutral-400/50 hover:text-white"
            data-card-modal-close
            type="button"
          >
            Schließen
          </button>
          {href && (
            <a
              class="flex-1 cursor-pointer rounded-full bg-linear-to-br from-yellow to-orange px-4 py-2.5 text-center font-semibold text-black no-underline shadow-lg shadow-yellow/10 transition-[filter] hover:brightness-110"
              href={href}
            >
              Öffnen
            </a>
          )}
        </div>
      </slot>
    </div>
  </div>
</dialog>

<style>
  .modal-scroll {
    scroll-behavior: smooth;
    overscroll-behavior-y: contain;
    scrollbar-width: thin;
    scrollbar-color: oklch(100% 0 0deg / 20%) #0a0a0a;
  }

  .modal-scroll::-webkit-scrollbar {
    width: 10px;
  }

  @media (width >= 768px) {
    .modal-scroll::-webkit-scrollbar {
      width: 14px;
    }
  }

  .modal-scroll::-webkit-scrollbar-track {
    background: #0a0a0a;
    border-radius: 20px;
  }

  .modal-scroll::-webkit-scrollbar-thumb {
    background: oklch(100% 0 0deg / 10%);
    border: 3px solid #0a0a0a;
    border-radius: 20px;
    transition: background 250ms ease;
  }

  @media (width >= 768px) {
    .modal-scroll::-webkit-scrollbar-thumb {
      border-width: 4px;
    }
  }

  .modal-scroll::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(to bottom, var(--color-orange), var(--color-yellow));
  }

  .modal-scroll::-webkit-scrollbar-button {
    display: none;
  }
</style>
