---
import { cn } from "@/shared/lib";

const {
  class: classProperty,
  className: classNameProperty,
  as: Component = "div",
  noBlur = false,
  rounded = "3xl",
  ...rest
} = Astro.props;

const customClass = cn(classProperty, classNameProperty);
---

<Component
  class:list={cn(
    "overflow-hidden border-2 border-(--glass-border) bg-card shadow-sm",
    rounded === "3xl" ? "rounded-3xl" : "rounded-2xl",
    !noBlur && "backdrop-blur-(--glass-blur)",
    customClass,
  )}
  {...rest}
>
  <slot />
</Component>
