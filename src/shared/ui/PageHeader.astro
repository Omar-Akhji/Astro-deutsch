---
type RenderableComponent = ((...parameters: any[]) => any) | (new (...parameters: any[]) => any);

interface Props {
  icon: RenderableComponent;
  title: string;
  subtitle?: string;
}

const { icon: Icon, title, subtitle } = Astro.props;
---

<header class="mb-12 text-center">
  <div data-animate="fade-up">
    <h1 class="mb-4 flex flex-col items-center justify-center gap-3 text-center text-3xl tablet:flex-row tablet:gap-4 tablet:text-4xl">
      <span class="flex size-12 shrink-0 items-center justify-center rounded-full border-[3px] border-solid border-yellow bg-mist-900/50 text-yellow shadow-sm tablet:size-14">
        <Icon class="size-6 tablet:size-7" />
      </span>
      <span class="title-gradient">{title}</span>
    </h1>
  </div>
  <div
    class="mx-auto mb-6 h-1 w-24 rounded-full bg-linear-to-r from-yellow to-orange shadow-lg shadow-yellow/20"
    data-animate="zoom-in"
  ></div>
  {subtitle && (
    <div
      class="flex justify-center px-2"
      data-animate="fade-up"
    >
      <p class="mx-auto w-fit max-w-2xl rounded-2xl border-2 border-solid border-white/10 bg-white/5 px-4 py-1.5 text-center text-xs font-medium leading-relaxed text-text-muted text-pretty shadow-sm min-[480px]:rounded-full min-[480px]:px-5 min-[480px]:py-1.5 tablet:px-6 tablet:py-1.5 tablet:text-sm">
        {subtitle}
      </p>
    </div>
  )}
</header>
