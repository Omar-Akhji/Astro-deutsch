---
/**
 * Modular Skeleton Bridge Component Provides backward-compatible layout mapping by delegating to
 * feature & widget skeletons.
 */
import { AuthSkeleton } from "@/features/auth";
import { GrammarSkeleton } from "@/features/grammar";
import { PruefungSkeleton } from "@/features/pruefung";
import { QuizSkeleton } from "@/features/quiz";
import { ThemenSkeleton } from "@/features/themen";
import { VocabularySkeleton } from "@/features/vocabulary";
import CardSkeleton from "./CardSkeleton.astro";
import Skeleton from "./Skeleton.astro";
import { FooterSkeleton } from "@/widgets/footer";
import { HeroSkeleton } from "@/widgets/hero";

interface Props {
  layout?:
    | "card"
    | "thema-card"
    | "grammar-overview"
    | "grammar-detail"
    | "vocabulary-overview"
    | "vocabulary-level"
    | "vocabulary-detail"
    | "family-tree"
    | "pruefung-overview"
    | "pruefung-level"
    | "pruefung-modelltests"
    | "pruefung-module-study"
    | "quiz"
    | "hero"
    | "section-header"
    | "table"
    | "section-card"
    | "themen"
    | "page-header"
    | "home"
    | "auth"
    | "404"
    | "footer"
    | "default-pending";
  variant?: "default" | "large" | "compact";
  columns?: number;
  rows?: number;
  noWrapper?: boolean;
}

const {
  layout = "card",
  variant = "default",
  columns = 4,
  rows = 5,
  noWrapper = false,
} = Astro.props;

const ROW_IDS = ["r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10"];
const COL_IDS = ["c1", "c2", "c3", "c4", "c5", "c6"];
---

<!-- 1. Card Skeleton -->
{layout === "card" && <CardSkeleton variant={variant} />}

<!-- 2. Thema Card Skeleton -->
{layout === "thema-card" && (
  <div class="relative overflow-hidden rounded-2xl border-2 border-white/10 bg-white/5 p-5 backdrop-blur-sm tablet:p-6">
    <div class="mbe-3.5 flex items-start justify-between">
      <div class="w-full space-y-2">
        <Skeleton class="h-5 w-20 rounded-full bg-white/10" />
        <Skeleton class="h-5 w-3/4 rounded-md bg-white/10" />
      </div>
    </div>
    <div class="relative mb-3.5 flex gap-1 rounded-full bg-black/20 p-1">
      <Skeleton class="h-7 flex-1 rounded-full bg-white/10" />
      <Skeleton class="h-7 flex-1 rounded-full bg-white/5" />
    </div>
    <div class="min-h-30 space-y-2.5">
      <div class="flex gap-2.5">
        <Skeleton class="mt-1 size-1.5 shrink-0 rounded-full bg-white/10" />
        <Skeleton class="h-4 w-full rounded-md bg-white/5" />
      </div>
      <div class="flex gap-2.5">
        <Skeleton class="mt-1 size-1.5 shrink-0 rounded-full bg-white/10" />
        <Skeleton class="h-4 w-5/6 rounded-md bg-white/5" />
      </div>
      <div class="flex gap-2.5">
        <Skeleton class="mt-1 size-1.5 shrink-0 rounded-full bg-white/10" />
        <Skeleton class="h-4 w-4/5 rounded-md bg-white/5" />
      </div>
    </div>
    <div class="mbs-4 flex justify-end border-bs border-white/5 pbs-3 tablet:mbs-5 tablet:pbs-3.5">
      <Skeleton class="h-3.5 w-32 rounded-md bg-white/5" />
    </div>
  </div>
)}

<!-- 3. Hero Skeleton -->
{layout === "hero" && <HeroSkeleton variant={variant === "compact" ? "compact" : "default"} />}

<!-- 4. Section Header Skeleton -->
{layout === "section-header" && (
  <div class="mbe-6 flex items-center gap-3 tablet:mbe-8 tablet:gap-4">
    <Skeleton class="size-10 shrink-0 rounded-full border-[3px] border-white/10 bg-white/5 tablet:size-12" />
    <Skeleton class="h-8 w-52 rounded-md bg-white/10 tablet:h-9 tablet:w-64" />
  </div>
)}

<!-- 5. Page Header Skeleton -->
{layout === "page-header" && (
  <header class="mb-10 text-center tablet:mb-12 laptop:mb-14">
    <div class="mb-3 flex flex-col items-center justify-center gap-3 tablet:flex-row tablet:gap-4">
      <Skeleton class="size-12 shrink-0 rounded-full border-[3px] border-white/10 bg-white/5 tablet:size-14" />
      <Skeleton class="h-9 w-64 rounded-md bg-white/15 tablet:h-10 tablet:w-80" />
    </div>
    <div class="mx-auto mb-5 h-1 w-24 overflow-hidden rounded-full bg-white/10" />
    <div class="flex justify-center px-2">
      <Skeleton class="h-9 min-[480px]:h-8 tablet:h-10 w-full max-w-[320px] min-[480px]:max-w-2xl rounded-2xl min-[480px]:rounded-full border-2 border-white/10 bg-white/5" />
    </div>
  </header>
)}

<!-- 6. Home Skeleton -->
{layout === "home" && (
  <div class="py-6 tablet:py-10 laptop:py-14">
    <header class="mbe-10 tablet:mbe-14 laptop:mbe-16">
      <HeroSkeleton />
    </header>
    <div class="grid grid-cols-1 gap-6 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
      <CardSkeleton />
      <CardSkeleton />
      <CardSkeleton />
    </div>
    <section class="mbs-16 tablet:mbs-20 laptop:mbs-24">
      <HeroSkeleton />
    </section>
    <section class="mbs-16 pb-8 text-center tablet:mbs-20 laptop:mbs-24">
      <Skeleton class="mx-auto mbe-4 h-9 w-2/3 max-w-md rounded-md bg-white/10 tablet:mbe-5 tablet:h-10" />
      <Skeleton class="mx-auto mbe-6 h-5 w-full max-w-2xl rounded-md bg-white/5 tablet:mbe-8 tablet:h-6" />
    </section>
  </div>
)}

<!-- 7. Themen Feature Skeleton -->
{layout === "themen" && <ThemenSkeleton />}

<!-- 8 & 9. Grammar Feature Skeletons -->
{layout === "grammar-overview" && <GrammarSkeleton variant="overview" />}
{layout === "grammar-detail" && <GrammarSkeleton variant="detail" />}

<!-- 10-13. Vocabulary Feature Skeletons -->
{layout === "vocabulary-overview" && <VocabularySkeleton variant="overview" />}
{layout === "vocabulary-level" && <VocabularySkeleton variant="level" />}
{layout === "vocabulary-detail" && <VocabularySkeleton variant="detail" />}
{layout === "family-tree" && <VocabularySkeleton variant="family-tree" />}

<!-- 14-17. Prüfung Feature Skeletons -->
{layout === "pruefung-overview" && <PruefungSkeleton variant="overview" />}
{layout === "pruefung-level" && <PruefungSkeleton variant="level" />}
{layout === "pruefung-modelltests" && <PruefungSkeleton variant="modelltests" />}
{layout === "pruefung-module-study" && <PruefungSkeleton variant="study" />}

<!-- 18. Quiz Feature Skeleton -->
{layout === "quiz" && <QuizSkeleton />}

<!-- 19. Table Skeleton -->
{layout === "table" && (
  <div>
    {noWrapper ?
      <div class="overflow-x-auto">
        <div class="w-full border-collapse">
          <div class="flex border-b border-white/10 bg-white/5 px-3 py-2.5 mobile:px-4 mobile:py-3 tablet:px-6 tablet:py-4">
            {COL_IDS.slice(0, columns).map((_, index) => (
              <Skeleton
                class="h-4 flex-1 rounded-md bg-white/10"
                style={{ marginLeft: index === 0 ? 0 : "1rem" }}
              />
            ))}
          </div>
          {ROW_IDS.slice(0, rows).map(() => (
            <div class="flex border-b border-white/5 px-3 py-2.5 mobile:px-4 mobile:py-3 tablet:px-6 tablet:py-4">
              {COL_IDS.slice(0, columns).map((_, index) => (
                <Skeleton
                  class="h-5 flex-1 rounded-md bg-white/5"
                  style={{ marginLeft: index === 0 ? 0 : "1rem" }}
                />
              ))}
            </div>
          ))}
        </div>
      </div>
    : <div class="overflow-hidden rounded-3xl border-2 border-(--glass-border) bg-card shadow-sm backdrop-blur-(--glass-blur)">
        <div class="overflow-x-auto">
          <div class="w-full border-collapse">
            <div class="flex border-b border-white/10 bg-white/5 px-3 py-2.5 mobile:px-4 mobile:py-3 tablet:px-6 tablet:py-4">
              {COL_IDS.slice(0, columns).map((_, index) => (
                <Skeleton
                  class="h-4 flex-1 rounded-md bg-white/10"
                  style={{ marginLeft: index === 0 ? 0 : "1rem" }}
                />
              ))}
            </div>
            {ROW_IDS.slice(0, rows).map(() => (
              <div class="flex border-b border-white/5 px-3 py-2.5 mobile:px-4 mobile:py-3 tablet:px-6 tablet:py-4">
                {COL_IDS.slice(0, columns).map((_, index) => (
                  <Skeleton
                    class="h-5 flex-1 rounded-md bg-white/5"
                    style={{ marginLeft: index === 0 ? 0 : "1rem" }}
                  />
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    }
  </div>
)}

<!-- 20. Section Card Skeleton -->
{layout === "section-card" && (
  <section class="mbe-16">
    <div class="mbe-8 flex items-center gap-3 tablet:gap-4">
      <Skeleton class="size-10 shrink-0 rounded-full border-[3px] border-white/10 bg-white/5 tablet:size-12" />
      <Skeleton class="h-8 w-52 rounded-md bg-white/10 tablet:h-9 tablet:w-64" />
    </div>
    <div class="grid grid-cols-1 gap-6 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
      {["sc1", "sc2", "sc3"].map(() => (
        <article class="h-full">
          <div class="relative z-1 flex h-full w-full flex-col overflow-hidden rounded-3xl border-2 border-white/10 bg-card/75 p-4 shadow-xl backdrop-blur-(--glass-blur)">
            <div class="aspect-video w-full overflow-hidden rounded-2xl">
              <Skeleton class="h-full w-full rounded-2xl bg-white/5" />
            </div>
            <div class="flex flex-1 flex-col px-2 pt-5 pb-2">
              <div class="mbe-3 flex items-center gap-2">
                <Skeleton class="h-6 w-16 rounded-full bg-white/10" />
                <Skeleton class="h-4 w-20 rounded-full bg-white/5" />
              </div>
              <Skeleton class="mb-2 h-7 w-3/4 rounded-md bg-white/10" />
              <Skeleton class="mbe-1 h-4 w-full rounded-md bg-white/5" />
              <Skeleton class="mbe-4 h-4 w-2/3 rounded-md bg-white/5" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<!-- 21. Auth Skeleton -->
{layout === "auth" && <AuthSkeleton />}

<!-- 22. 404 Skeleton -->
{layout === "404" && (
  <div class="flex min-h-[60vh] flex-col items-center justify-center gap-6 py-16 text-center">
    <Skeleton class="h-16 w-36 rounded-2xl bg-white/15 tablet:h-24 tablet:w-48" />
    <Skeleton class="h-6 w-72 max-w-md rounded-md bg-white/5" />
    <Skeleton class="h-12 w-52 rounded-full bg-white/15" />
  </div>
)}

<!-- 23. Default Pending Skeleton -->
{layout === "default-pending" && (
  <div class="min-h-screen py-8">
    <header class="mb-12 text-center">
      <div class="mb-4 flex flex-col items-center justify-center gap-3 tablet:flex-row tablet:gap-4">
        <Skeleton class="size-12 shrink-0 rounded-full border-[3px] border-white/10 bg-white/5 tablet:size-14" />
        <Skeleton class="h-9 w-64 rounded-md bg-white/15 tablet:h-10 tablet:w-80" />
      </div>
      <div class="mx-auto mb-6 h-1 w-24 overflow-hidden rounded-full bg-white/10" />
      <div class="flex justify-center px-2">
        <Skeleton class="h-9 min-[480px]:h-8 tablet:h-10 w-full max-w-[320px] min-[480px]:max-w-2xl rounded-2xl min-[480px]:rounded-full border-2 border-white/10 bg-white/5" />
      </div>
    </header>
    <section class="py-4">
      <div class="grid grid-cols-1 gap-6 py-4 mobile:grid-cols-2 mobile:gap-8 laptop:grid-cols-3">
        {["s1", "s2", "s3", "s4", "s5", "s6"].map(() => (
          <div class="h-full">
            <div class="relative z-1 flex h-full w-full flex-col overflow-hidden rounded-3xl border-2 border-white/10 bg-card/75 p-4 shadow-xl backdrop-blur-(--glass-blur)">
              <div class="aspect-video w-full overflow-hidden rounded-2xl">
                <Skeleton class="h-full w-full rounded-2xl bg-white/5" />
              </div>
              <div class="flex flex-1 flex-col px-2 pt-5 pb-2">
                <div class="mbe-3 flex items-center gap-2">
                  <Skeleton class="h-6 w-16 rounded-full bg-white/10" />
                  <Skeleton class="h-4 w-20 rounded-full bg-white/5" />
                </div>
                <Skeleton class="mb-2 h-7 w-3/4 rounded-md bg-white/10" />
                <Skeleton class="mbe-4 h-4 w-full rounded-md bg-white/5" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
)}

<!-- 24. Footer Skeleton -->
{layout === "footer" && <FooterSkeleton />}
