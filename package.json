{
  "name": "elite-regewelt",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "audit": "bun audit",
    "audit:fix": "bun audit fix --ignore GHSA-vfj7-8cjw-p6xm",
    "build": "bun run astro sync && bun run lint && bun run check && bun --bun astro build",
    "check": "astro check && tsc --noEmit",
    "dev": "bun --bun astro dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check:biome": "biome check --write .",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "preview": "bun --bun astro preview",
    "start": "bun run ./dist/server/entry.mjs",
    "test": "bun test"
  },
  "overrides": {
    "katex": "^0.18.2",
    "smol-toml": "^1.9.0"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-astro": "^0.556.0",
    "lucide-vue-next": "^1.0.0",
    "msedge-tts": "^2.0.9",
    "nanoid": "^6.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.5",
    "markdownlint-cli2": "^0.23.3",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
