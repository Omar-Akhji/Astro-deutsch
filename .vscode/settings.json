{
  // ─── Formatting & Editor Behavior ──────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "quickfix.biome": "explicit"
  },

  // ─── File Formatting Associations ──────────────────────────────────────────
  "[astro]": { "editor.defaultFormatter": "astro-build.astro-vscode" },
  "[vue]": { "editor.defaultFormatter": "Vue.volar" },
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
  "[html]": { "editor.defaultFormatter": "biomejs.biome" },
  "[css]": { "editor.defaultFormatter": "biomejs.biome" },
  "[markdown]": { "editor.defaultFormatter": "biomejs.biome" },

  // ─── TSLint Vue Type-Checker Integration ──────────────────────────────────
  "tslint.enable": true,
  "tslint.typeCheck": true,
  "tslint.run": "onType",

  // ─── TypeScript Configuration ─────────────────────────────────────────────
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.inlayHints.variableTypes.enabled": false,

  // ─── Vue & Volar Hybrid Mode ──────────────────────────────────────────────
  "vue.server.hybridMode": true,
  "vue.inlayHints.missingProps": true,

  // ─── Tailwind CSS v4 Integration ──────────────────────────────────────────
  "tailwindCSS.includeLanguages": { "astro": "html", "vue": "html" },
  "tailwindCSS.experimental.configFile": null,
  "tailwindCSS.emmetCompletions": true,
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",

  // ─── Workspace File Handling ──────────────────────────────────────────────
  "files.associations": { "*.astro": "astro", "*.css": "tailwindcss" },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // ─── ErrorLens Diagnostics ────────────────────────────────────────────────
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "typescript.tsdk": "node_modules/typescript/lib"
}
